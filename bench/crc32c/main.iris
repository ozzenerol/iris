import compress

i64 next(i64 *s) {
    *s = (*s * 1103515245 + 12345) % 2147483648
    return *s
}

str[10] WORDS = ["alpha ", "beta ", "gamma ", "delta ", "error ", "ok ", "GET /index.html ", "200 ", "404 ", "\n"]

// The CRC32C of a 64 KiB block, carried on through 16000 rounds (1 GiB).
void main() {
    i64 seed = 1
    String chunk
    defer chunk.free()
    for chunk.len < 65536 {
        chunk.append(WORDS[next(&seed) % 10])
    }
    chunk.truncate(65536)
    u32 c = 0
    for _ in 0..16000 {
        c = compress.crc32c(chunk, c)
    }
    print("{c}")
}
