import big

!void main() {
    // 5000! by multiplication, and its decimal text
    big.Int f = big.from(1)
    for i in 2..5001 {
        k := big.from(i)
        next := f.mul(k)
        f.free()
        k.free()
        f = next
    }
    scoped digits := f.text()
    f.free()
    // modular powers with a 2048-bit modulus, as RSA does
    scoped two := big.from(2)
    scoped p := two.pow(2048)
    scoped m := p.sub(big.from(159))
    scoped e := try big.parse("65537")
    i64 check = 0
    for i in 0..100 {
        scoped b := big.from(i + 3)
        scoped bb := b.pow(300)
        scoped r := bb.modPow(e, m)
        check += r.bitLen()
    }
    print("{digits.len} {digits[0:12]} {check}")
}
