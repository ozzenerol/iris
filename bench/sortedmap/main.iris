const i64 N = 1000000
const i64 SCANS = 1000

bool lower(i64 a, i64 b) => a < b

void main() {
    scoped SortedMap[i64, i64] m = SortedMap[i64, i64]{less: lower}
    i64[] keys = alloc(i64, N)
    defer free(keys)
    u64 x = 88172645463325252
    for i in 0..N {
        x ^= x << 13
        x ^= x >> 7
        x ^= x << 17
        k := i64(x >> 24)
        keys[i] = k
        m.set(k, i)
    }
    i64 found = 0
    i64 sum = 0
    for i in 0..N {
        i64 k = 0
        if i % 2 == 0 {
            k = keys[(i * 7) % N]
        } else {
            x ^= x << 13
            x ^= x >> 7
            x ^= x << 17
            k = i64(x >> 24)
        }
        v, ok := m.get(k)
        if ok {
            found += 1
            sum += v
        }
    }
    i64 seen = 0
    i64 total = 0
    for s in 0..SCANS {
        from := keys[(s * 997) % N]
        for k, v in m.range(from, from + 1073741824) {
            seen += 1
            total += v
        }
    }
    print("{m.len} {found} {sum} {seen} {total}")
}
