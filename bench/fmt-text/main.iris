const i64 N = 2000000

void main() {
    names := ["alpha", "beta", "gamma", "delta", "epsilon", "zeta", "eta", "theta"]
    scoped String out = "".copy()
    for i in 0..N {
        id := i * 2654435761 % 4294967296
        f64 value = f64(i) / 7.0
        out.append("{id:08x} {names[i % 8]:<12} {value:>14.3} {i:+}\n")
    }
    i64 sum = 0
    for b in out {
        sum += i64(b)
    }
    print("{out.len} {sum}")
}
