// Reading lines a person types, as GNU readline does:
//
//     term.historyFile(".app_history")      // kept between runs
//     for {
//         line := term.readLine("[bold]>[/] ") catch e {
//             break                         // Ctrl-D or the end of input
//         }
//         defer line.free()
//         ...
//     }
//
// On a terminal the line can be edited: Left and Right (Ctrl-B, Ctrl-F),
// Home and End (Ctrl-A, Ctrl-E), Alt-B, Alt-F and Ctrl-Left, Ctrl-Right a
// word at a time, Backspace and Delete, Ctrl-U and Ctrl-K cut to the start
// or the end, Ctrl-W the word before, Up and Down (Ctrl-P, Ctrl-N) go
// through the history, Ctrl-L clears the screen, Ctrl-C drops the line and
// asks again, and Ctrl-D on an empty line ends. A line longer than the
// terminal scrolls sideways. When stdin isn't a terminal, lines are read
// as they are and the prompt isn't shown.

import fs, io, str

@extern("iris_term_raw")
i32 rawMode(i32 on)

@extern("iris_term_read_byte")
i32 readByte()

List[String] history
i64 historyLimit = 1000
String historyPath
bool historyManual

void historyPush(str line) {
    history.push(line.copy())
    for history.len > historyLimit {
        old := history.remove(0)
        old.free()
    }
}

// Adds line to the history, and to the history file, unless it is empty
// or the same as the last one. readLine does this for every line it gives,
// unless historyAuto(false) was called.
pub void historyAdd(str line) {
    if line.len == 0 || history.len > 0 && history.last() == line {
        return
    }
    historyPush(line)
    if historyPath.len > 0 {
        scoped String entry = format("{line}\n")
        fs.append(historyPath, entry) catch e { }
    }
}

// Keeps the history in the file at path: what is in it now is read, and
// each new line is added to it.
pub void historyFile(str path) {
    historyPath.free()
    historyPath = path.copy()
    scoped String text = fs.readAll(path) catch e {
        return
    }
    str rest = text
    for rest.len > 0 {
        line, after, _ := str.cut(rest, "\n")
        if line.len > 0 {
            historyPush(line)
        }
        rest = after
    }
}

// Keeps at most n lines (1000 to start with).
pub void historyMax(i64 n) {
    historyLimit = if n > 0 { n } else { 1 }
    for history.len > historyLimit {
        old := history.remove(0)
        old.free()
    }
}

// Whether readLine adds each line to the history itself.
pub void historyAuto(bool on) {
    historyManual = !on
}

// How many lines the history has.
pub i64 historyLen() => history.len

// History line i, 0 the oldest.
pub str historyAt(i64 i) => if i >= 0 && i < history.len { history.at(i) } else { "" }

// Empties the history; the file stays as it is.
pub void historyClear() {
    history.freeEach()
}

// Clears the screen.
pub void clear() => put(1, "\x1b[H\x1b[2J")

// ------------------------------------------------------------ editing

struct Editor {
    String buf
    i64 pos       // the cursor, a byte offset in buf
    i64 off       // the first byte shown, when the line scrolls
    String prompt // the prompt's last line, with its escape codes
    i64 promptWidth
    List[String] lines // copies of the history and the new line, edited freely
    i64 at             // which of lines is being edited
}

bool isCont(u8 b) => b & 0xc0 == 0x80

i64 nextRune(str s, i64 i) {
    i += 1
    for i < s.len && isCont(s[i]) {
        i += 1
    }
    return if i > s.len { s.len } else { i }
}

i64 prevRune(str s, i64 i) {
    if i == 0 {
        return 0
    }
    i -= 1
    for i > 0 && isCont(s[i]) {
        i -= 1
    }
    return i
}

bool wordByte(u8 c) => c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '_' || c >= 0x80

i64 wordLeft(str s, i64 i) {
    for i > 0 && !wordByte(s[i - 1]) {
        i -= 1
    }
    for i > 0 && wordByte(s[i - 1]) {
        i -= 1
    }
    return i
}

i64 wordRight(str s, i64 i) {
    for i < s.len && !wordByte(s[i]) {
        i += 1
    }
    for i < s.len && wordByte(s[i]) {
        i += 1
    }
    return i
}

// buf with text put in place of buf[from:to].
void Editor.splice(i64 from, i64 to, str text) {
    scoped String next = format("{self.buf[0:from]}{text}{self.buf[to:]}")
    self.buf.free()
    self.buf = next.copy()
    self.pos = from + text.len
}

// Draws the prompt and the part of the line around the cursor.
void Editor.refresh() {
    cols, _ := size()
    room := cols - self.promptWidth - 1
    if room < 1 {
        room = 1
    }
    if self.pos < self.off {
        self.off = self.pos
    }
    for columns(self.buf[self.off:self.pos]) > room {
        self.off = nextRune(self.buf, self.off)
    }
    end := self.off
    for end < self.buf.len && columns(self.buf[self.off:nextRune(self.buf, end)]) <= room {
        end = nextRune(self.buf, end)
    }
    String out
    out.append("\r")
    out.append(self.prompt)
    out.append(self.buf[self.off:end])
    out.append("\x1b[K\r")
    col := self.promptWidth + columns(self.buf[self.off:self.pos])
    if col > 0 {
        scoped String move = format("\x1b[{col}C")
        out.append(move)
    }
    put(1, out)
    out.free()
}

// Up (-1) or down (+1) in the history copies, keeping the edits.
void Editor.move(i64 step) {
    to := self.at + step
    if to < 0 || to >= self.lines.len {
        return
    }
    old := self.lines.at(self.at)
    old.free()
    self.lines.set(self.at, self.buf)
    self.at = to
    self.buf = self.lines.at(to).copy()
    self.pos = self.buf.len
    self.off = 0
}

// An escape sequence after ESC: arrows, Home and End, Delete, word moves.
void Editor.escape() {
    c := readByte()
    if c == 'b' || c == 'f' {
        self.pos = if c == 'b' { wordLeft(self.buf, self.pos) } else { wordRight(self.buf, self.pos) }
        return
    }
    if c != '[' && c != 'O' {
        return
    }
    String params
    defer params.free()
    i32 k = 0
    for {
        k = readByte()
        if k < 0 || k >= 0x40 && k <= 0x7e {
            break
        }
        u8[1] one = [u8(k)]
        params.append(one[0:1])
    }
    word := str.endsWith(params, ";5") || str.endsWith(params, ";3")
    if k == 'A' {
        self.move(-1)
    } else if k == 'B' {
        self.move(1)
    } else if k == 'C' {
        self.pos = if word { wordRight(self.buf, self.pos) } else { nextRune(self.buf, self.pos) }
        if self.pos > self.buf.len {
            self.pos = self.buf.len
        }
    } else if k == 'D' {
        self.pos = if word { wordLeft(self.buf, self.pos) } else { prevRune(self.buf, self.pos) }
    } else if k == 'H' || k == '~' && (params == "1" || params == "7") {
        self.pos = 0
    } else if k == 'F' || k == '~' && (params == "4" || params == "8") {
        self.pos = self.buf.len
    } else if k == '~' && params == "3" && self.pos < self.buf.len {
        self.splice(self.pos, nextRune(self.buf, self.pos), "")
    }
}

// 1: Enter, 0: the end of input (Ctrl-D or EOF); keeps going otherwise.
i64 Editor.edit() {
    for {
        self.refresh()
        c := readByte()
        if c < 0 {
            return 0
        }
        if c == 13 || c == 10 {
            return 1
        }
        if c == 3 {
            // Ctrl-C: drop the line and ask again
            put(1, "^C\n")
            self.splice(0, self.buf.len, "")
            self.off = 0
        } else if c == 4 {
            if self.buf.len == 0 {
                return 0
            }
            if self.pos < self.buf.len {
                self.splice(self.pos, nextRune(self.buf, self.pos), "")
            }
        } else if c == 127 || c == 8 {
            if self.pos > 0 {
                p := self.pos
                self.splice(prevRune(self.buf, p), p, "")
            }
        } else if c == 1 {
            self.pos = 0
        } else if c == 5 {
            self.pos = self.buf.len
        } else if c == 2 {
            self.pos = prevRune(self.buf, self.pos)
        } else if c == 6 {
            if self.pos < self.buf.len {
                self.pos = nextRune(self.buf, self.pos)
            }
        } else if c == 11 {
            self.splice(self.pos, self.buf.len, "")
            self.pos = self.buf.len
        } else if c == 21 {
            p := self.pos
            self.splice(0, p, "")
            self.pos = 0
        } else if c == 23 {
            p := self.pos
            self.splice(wordLeft(self.buf, p), p, "")
        } else if c == 16 {
            self.move(-1)
        } else if c == 14 {
            self.move(1)
        } else if c == 12 {
            clear()
        } else if c == 27 {
            self.escape()
        } else if c >= 32 {
            // a character, with the rest of its UTF-8 bytes
            u8[4] bytes
            bytes[0] = u8(c)
            n := if c < 0x80 { 1 } else if c >> 5 == 6 { 2 } else if c >> 4 == 14 { 3 } else if c >> 3 == 30 { 4 } else { 1 }
            got := 1
            for got < n {
                more := readByte()
                if more < 0 {
                    break
                }
                bytes[got] = u8(more)
                got += 1
            }
            self.splice(self.pos, self.pos, bytes[0:got])
        }
    }
}

// Writes the prompt's lines before its last, and keeps the last one.
void Editor.setPrompt(str prompt) {
    scoped String shown = build(1, "", prompt, "")
    str rest = shown
    for {
        line, after, more := str.cut(rest, "\n")
        if !more {
            break
        }
        scoped String head = format("{line}\n")
        put(1, head)
        rest = after
    }
    self.prompt = rest.copy()
    self.promptWidth = columns(rest)
}

void Editor.free() {
    self.buf.free()
    self.prompt.free()
    self.lines.freeEach()
}

!String readPlain() {
    return io.readLine() catch e {
        return e
    }
}

// Shows prompt (markup allowed) and reads one line, without its line
// break. At the end of input, or Ctrl-D on an empty line, it fails with
// io.IoError.eof.
pub !String readLine(str prompt) {
    if !interactive() {
        line := try readPlain()
        if !historyManual {
            historyAdd(line)
        }
        return line
    }
    Editor e
    defer e.free()
    e.setPrompt(prompt)
    for h in history {
        e.lines.push(h.copy())
    }
    e.lines.push("".copy())
    e.at = e.lines.len - 1
    if rawMode(1) == 0 {
        put(1, e.prompt)
        return try readPlain()
    }
    got := e.edit()
    // draw the whole line once more, then go to the next one
    e.off = 0
    e.pos = e.buf.len
    e.refresh()
    rawMode(0)
    put(1, "\n")
    if got == 0 {
        return error(io.IoError.eof, "end of input")
    }
    line := e.buf.copy()
    if !historyManual {
        historyAdd(line)
    }
    return line
}

// readLine for a secret: nothing is shown as it is typed, and the line
// isn't added to the history. Ctrl-C or Ctrl-D fail with io.IoError.eof.
pub !String readPassword(str prompt) {
    if !interactive() {
        return try readPlain()
    }
    scoped String shown = build(1, "", prompt, "")
    put(1, shown)
    if rawMode(1) == 0 {
        return try readPlain()
    }
    String buf
    for {
        c := readByte()
        if c < 0 || c == 3 || c == 4 {
            rawMode(0)
            put(1, "\n")
            buf.free()
            return error(io.IoError.eof, "end of input")
        }
        if c == 13 || c == 10 {
            break
        }
        if c == 127 || c == 8 {
            if buf.len > 0 {
                scoped String shorter = buf[0:prevRune(buf, buf.len)].copy()
                buf.free()
                buf = shorter.copy()
            }
            continue
        }
        if c >= 32 {
            u8[1] one = [u8(c)]
            buf.append(one[0:1])
        }
    }
    rawMode(0)
    put(1, "\n")
    return buf
}
