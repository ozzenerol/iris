// The program's arguments and environment, its working folder, the
// machine it runs on, and leaving the program.

// What env fails with: notSet for a variable that isn't set; setenv fails
// with invalid for a name that can't be one. chdir fails with notFound for
// a folder that isn't there, permission for one the program may not enter,
// and other for the rest.
pub enum OsError { notSet, invalid, notFound, permission, other }

@extern("iris_os_argc")
i64 argCount()

@extern("iris_os_arg")
void rawArg(i64 i, u8 **p, i64 *n)

@extern("iris_os_getenv")
i32 rawGetenv(u8 *name, i64 nameLen, u8 **p, i64 *n)

@extern("iris_os_setenv")
i32 rawSetenv(u8 *name, i64 n, u8 *value, i64 vn, i32 set)

@extern("iris_os_exit")
@noreturn
void rawExit(i32 code)

// How many arguments the program got, counting its own name.
pub i64 argc() => argCount()

// Argument i; 0 is the program's name. "" past the end.
pub str arg(i64 i) {
    if i < 0 || i >= argCount() {
        return ""
    }
    u8 *p
    i64 n
    rawArg(i, &p, &n)
    return p[0:n]
}

// The value of an environment variable.
pub !str env(str name) {
    u8 *p
    i64 n
    if rawGetenv(name.ptr, name.len, &p, &n) == 0 {
        return error(OsError.notSet, "{name} is not set")
    }
    return p[0:n]
}

// Sets an environment variable, for this program and the programs it runs.
// Set variables before starting threads: the environment isn't safe to
// change while another thread reads it.
pub !void setenv(str name, str value) {
    if rawSetenv(name.ptr, name.len, value.ptr, value.len, 1) != 0 {
        return error(OsError.invalid, "'{name}' can't be the name of an environment variable")
    }
}

// Removes an environment variable; one that isn't set is no error.
pub !void unsetenv(str name) {
    if rawSetenv(name.ptr, name.len, null, 0, 0) != 0 {
        return error(OsError.invalid, "'{name}' can't be the name of an environment variable")
    }
}

// Ends the program with an exit status. Deferred statements don't run. A call
// to it never comes back, so it can end a catch block or a branch that would
// otherwise need a value.
@noreturn
pub void exit(i32 code) => rawExit(code)

@extern("iris_os_cwd")
i32 rawCwd(String *out)

@extern("iris_os_chdir")
i32 rawChdir(u8 *path, i64 n)

@extern("iris_os_hostname")
i32 rawHostname(String *out)

@extern("iris_os_home")
i32 rawHome(String *out)

@extern("getpid")
i32 rawPid()

Error osError(i32 code, str path) => match code {
    1 => error(OsError.notFound, "{path}: no such folder")
    2 => error(OsError.permission, "{path}: permission denied")
    _ => error(OsError.other, "{path}: can't be used")
}

// The working folder: where paths that don't start with / are taken from.
pub !String cwd() {
    String out
    code := rawCwd(&out)
    if code != 0 {
        return osError(code, ".")
    }
    return out
}

// Changes the working folder, for the whole program and its threads.
pub !void chdir(str path) {
    code := rawChdir(path.ptr, path.len)
    if code != 0 {
        return osError(code, path)
    }
}

// The name of the machine.
pub !String hostname() {
    String out
    if rawHostname(&out) != 0 {
        return error(OsError.other, "the host name can't be read")
    }
    return out
}

// The process id of the program.
pub i64 pid() => i64(rawPid())

@extern("iris_os_run_as")
i32 rawRunAs(u8 *user, i64 ulen, u8 *group, i64 glen)

@extern("iris_os_uid")
i64 rawUid()

@extern("iris_os_gid")
i64 rawGid()

@extern("iris_os_user")
i32 rawUser(String *out)

// Runs the program as user from now on, every thread of it, and as group,
// or the user's own group when group is "". A server started as root does
// this once it has bound its ports: it takes the user's groups, then the
// group, then the user, and can't become root again; on Linux it loses
// every capability too. Only root may change to another user, so the rest
// fail with OsError.permission; asking for the user and group the program
// already runs as does nothing. notFound for a user or group that doesn't
// exist.
pub !void runAs(str user, str group = "") {
    code := rawRunAs(user.ptr, user.len, group.ptr, group.len)
    match code {
        0 => {}
        1 => return error(OsError.notFound, "{user}: no such user")
        2 => return error(OsError.notFound, "{group}: no such group")
        3 => return error(OsError.permission, "running as {user}: only root may change user")
        4 => return error(OsError.other, "running as {user}: root could still be taken back")
        _ => return error(OsError.other, "running as {user}: the system refused")
    }
}

// The user id the program runs as: 0 for root.
pub i64 uid() => rawUid()

// The group id the program runs as.
pub i64 gid() => rawGid()

// The name of the user the program runs as.
pub !String user() {
    String out
    if rawUser(&out) != 0 {
        out.free()
        return error(OsError.notFound, "user {uid()} has no name")
    }
    return out
}

// The user's home folder: $HOME, or the one the system has for the user
// when HOME isn't set.
pub !String home() {
    String out
    if rawHome(&out) != 0 {
        return error(OsError.notSet, "the user has no home folder")
    }
    return out
}

@extern("iris_cpu_count")
i64 rawCpuCount()

@extern("iris_pin_thread")
i32 rawPin(i64 n)

@extern("iris_user_lookup")
i32 rawUserLookup(u8 *name, i64 nameLen, i64 uid, String *outName, i64 *outUid, i64 *outGid, String *home,
    String *shell, String *gecos)

@extern("iris_user_groups")
i64 rawUserGroups(u8 *name, i64 nameLen, i64 gid, i64 *gids, i64 cap)

@extern("iris_group_lookup")
i32 rawGroupLookup(u8 *name, i64 nameLen, i64 gid, String *outName, i64 *outGid, String *members)

// How many cores the program may run on: all of the machine's, or fewer
// when taskset or a container limits it.
pub i64 cpuCount() => rawCpuCount()

// Keeps the thread that calls it on one core from now on: core is from 0
// to cpuCount() - 1, counting the cores the program may run on, so a
// thread per core each keeps its caches warm. Linux only.
pub !void pinThread(i64 core) {
    e := rawPin(core)
    if e == -1 {
        return error(OsError.other, "pinning a thread: only on Linux")
    }
    if e == -2 {
        return error(OsError.invalid, "pinning a thread: core {core} isn't one of the {cpuCount()} it may use")
    }
    if e != 0 {
        return error(OsError.other, "pinning a thread to core {core}: the system refused")
    }
}

// A user of the system, as the user database has it.
pub struct User {
    pub String name
    pub i64 uid
    pub i64 gid
    pub String home
    pub String shell
    // the full name and other notes
    pub String gecos
}

// Gives the user's text back.
pub void User.free() {
    self.name.free()
    self.home.free()
    self.shell.free()
    self.gecos.free()
}

// The ids of the groups the user is in, its own group first.
pub List[i64] User.groups() {
    i64[512] gids
    n := rawUserGroups(self.name.ptr, self.name.len, self.gid, &gids[0], 512)
    List[i64] out
    out.push(self.gid)
    for i in 0..(if n < 512 { n } else { 512 }) {
        if gids[i] != self.gid {
            out.push(gids[i])
        }
    }
    return out
}

// The user named name: notFound when there is none.
pub !User lookupUser(str name) {
    User u
    if rawUserLookup(name.ptr, name.len, 0, &u.name, &u.uid, &u.gid, &u.home, &u.shell, &u.gecos) != 0 {
        u.free()
        return error(OsError.notFound, "{name}: no such user")
    }
    return u
}

// The user with the id uid: notFound when there is none.
pub !User lookupUserId(i64 uid) {
    User u
    if rawUserLookup("".ptr, -1, uid, &u.name, &u.uid, &u.gid, &u.home, &u.shell, &u.gecos) != 0 {
        u.free()
        return error(OsError.notFound, "user {uid}: no such user")
    }
    return u
}

// A group of the system, and the users the group database names as its
// members (not those whose own group it is).
pub struct Group {
    pub String name
    pub i64 gid
    pub List[String] members
}

// Gives the group's text back.
pub void Group.free() {
    self.name.free()
    self.members.freeEach()
}

Group groupFrom(String name, i64 gid, String members) {
    Group g = Group{name: name, gid: gid}
    i64 start = 0
    for i in 0..members.len {
        if members[i] == 0 {
            g.members.push(members[start:i].copy())
            start = i + 1
        }
    }
    return g
}

// The group named name: notFound when there is none.
pub !Group lookupGroup(str name) {
    String n
    i64 gid
    scoped String members
    if rawGroupLookup(name.ptr, name.len, 0, &n, &gid, &members) != 0 {
        n.free()
        return error(OsError.notFound, "{name}: no such group")
    }
    return groupFrom(n, gid, members)
}

// The group with the id gid: notFound when there is none.
pub !Group lookupGroupId(i64 gid) {
    String n
    i64 id
    scoped String members
    if rawGroupLookup("".ptr, -1, gid, &n, &id, &members) != 0 {
        n.free()
        return error(OsError.notFound, "group {gid}: no such group")
    }
    return groupFrom(n, id, members)
}
