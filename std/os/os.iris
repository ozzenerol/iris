// The program's arguments and environment, its working folder, the
// machine it runs on, and leaving the program.

// What env fails with: notSet for a variable that isn't set; setenv fails
// with invalid for a name that can't be one. chdir fails with notFound for
// a folder that isn't there, permission for one the program may not enter,
// and other for the rest.
pub enum OsError { notSet, invalid, notFound, permission, other }

@extern("iris_os_argc")
i64 argCount()

@extern("iris_os_arg")
void rawArg(i64 i, u8 **p, i64 *n)

@extern("iris_os_getenv")
i32 rawGetenv(u8 *name, i64 nameLen, u8 **p, i64 *n)

@extern("iris_os_setenv")
i32 rawSetenv(u8 *name, i64 n, u8 *value, i64 vn, i32 set)

@extern("iris_os_exit")
@noreturn
void rawExit(i32 code)

// How many arguments the program got, counting its own name.
pub i64 argc() => argCount()

// Argument i; 0 is the program's name. "" past the end.
pub str arg(i64 i) {
    if i < 0 || i >= argCount() {
        return ""
    }
    u8 *p
    i64 n
    rawArg(i, &p, &n)
    return p[0:n]
}

// The value of an environment variable.
pub !str env(str name) {
    u8 *p
    i64 n
    if rawGetenv(name.ptr, name.len, &p, &n) == 0 {
        return error(OsError.notSet, "{name} is not set")
    }
    return p[0:n]
}

// Sets an environment variable, for this program and the programs it runs.
// Set variables before starting threads: the environment isn't safe to
// change while another thread reads it.
pub !void setenv(str name, str value) {
    if rawSetenv(name.ptr, name.len, value.ptr, value.len, 1) != 0 {
        return error(OsError.invalid, "'{name}' can't be the name of an environment variable")
    }
}

// Removes an environment variable; one that isn't set is no error.
pub !void unsetenv(str name) {
    if rawSetenv(name.ptr, name.len, null, 0, 0) != 0 {
        return error(OsError.invalid, "'{name}' can't be the name of an environment variable")
    }
}

// Ends the program with an exit status. Deferred statements don't run. A call
// to it never comes back, so it can end a catch block or a branch that would
// otherwise need a value.
@noreturn
pub void exit(i32 code) => rawExit(code)

@extern("iris_os_cwd")
i32 rawCwd(String *out)

@extern("iris_os_chdir")
i32 rawChdir(u8 *path, i64 n)

@extern("iris_os_hostname")
i32 rawHostname(String *out)

@extern("iris_os_home")
i32 rawHome(String *out)

@extern("getpid")
i32 rawPid()

Error osError(i32 code, str path) => match code {
    1 => error(OsError.notFound, "{path}: no such folder")
    2 => error(OsError.permission, "{path}: permission denied")
    _ => error(OsError.other, "{path}: can't be used")
}

// The working folder: where paths that don't start with / are taken from.
pub !String cwd() {
    String out
    code := rawCwd(&out)
    if code != 0 {
        return osError(code, ".")
    }
    return out
}

// Changes the working folder, for the whole program and its threads.
pub !void chdir(str path) {
    code := rawChdir(path.ptr, path.len)
    if code != 0 {
        return osError(code, path)
    }
}

// The name of the machine.
pub !String hostname() {
    String out
    if rawHostname(&out) != 0 {
        return error(OsError.other, "the host name can't be read")
    }
    return out
}

// The process id of the program.
pub i64 pid() => i64(rawPid())

// The user's home folder: $HOME, or the one the system has for the user
// when HOME isn't set.
pub !String home() {
    String out
    if rawHome(&out) != 0 {
        return error(OsError.notSet, "the user has no home folder")
    }
    return out
}
