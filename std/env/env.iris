// Settings from environment variables, into an @env struct.

import fs, os, str

// What load fails with: missing for a required variable that isn't set,
// invalid for a value that doesn't fit its field.
pub enum EnvError { missing, invalid }

// Fills an @env struct from the environment: env.load(Settings). Each
// field reads the variable named after it in capitals with _ between the
// words (dbUrl reads DB_URL), or the one @env("NAME") gives; @env("APP")
// on the struct puts APP_ in front of every name. A variable that isn't
// set leaves the field's default, unless the field is @env(required).
// Numbers, bool (true, false, 1, 0, yes, no, on, off), str, String, enums
// by name, and Duration (30s, 1500ms, 1m30s) can be read.
@builtin
pub void load()

@extern("iris_env_load")
i32 rawLoad(u8 *table, u8 *out)

@extern("iris_env_message_ptr")
u8 *messagePtr()

@extern("iris_env_message_len")
i64 messageLen()

// Puts the variables of a file into the environment, one KEY=value a line,
// so env.load can read them. Blank lines and lines that start with # are
// skipped, and a line may start with export. A # after a space starts a
// comment. A value may be wrapped in double or single quotes, which are
// taken off, and then # is part of it. A variable that is already set
// keeps its value, so the environment wins over the file. A line with no
// =, a name that isn't letters, digits and _, or a quote that isn't closed
// is an EnvError.invalid; a file that can't be read gives the fs error.
pub !void loadFile(str path) {
    scoped String text = try fs.readAll(path)
    scoped lines := str.split(text, "\n")
    for i in 0..lines.len {
        l := str.trim(lines.at(i))
        if l.len == 0 || str.startsWith(l, "#") {
            continue
        }
        if str.startsWith(l, "export ") {
            l = str.trim(l[7:])
        }
        key, value, found := str.cut(l, "=")
        if !found {
            return error(EnvError.invalid, "{path} line {i + 1}: there is no = in it")
        }
        name := str.trim(key)
        if !isName(name) {
            return error(EnvError.invalid, "{path} line {i + 1}: '{name}' can't be the name of a variable")
        }
        v := str.trim(value)
        if str.startsWith(v, "\"") || str.startsWith(v, "'") {
            end := str.find(v[1:], v[0:1])
            if end < 0 {
                return error(EnvError.invalid, "{path} line {i + 1}: the quote isn't closed")
            }
            rest := str.trim(v[end + 2:])
            if rest.len > 0 && !str.startsWith(rest, "#") {
                return error(EnvError.invalid, "{path} line {i + 1}: there is text after the closing quote")
            }
            v = v[1:end + 1]
        } else {
            for j in 1..v.len {
                if v[j] == '#' && (v[j - 1] == ' ' || v[j - 1] == '\t') {
                    v = str.trimRight(v[0:j])
                    break
                }
            }
        }
        _ = os.env(name) catch e {
            try os.setenv(name, v)
            ""
        }
    }
}

// Whether s can name a variable: letters, digits and _, not starting with
// a digit.
bool isName(str s) {
    if s.len == 0 || (s[0] >= '0' && s[0] <= '9') {
        return false
    }
    for c in s {
        if !((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_') {
            return false
        }
    }
    return true
}

// What env.load calls.
pub !void loadInto(u8 *table, u8 *out) {
    code := rawLoad(table, out)
    if code == 0 {
        return
    }
    msg := messagePtr()[0:messageLen()]
    if code == 1 {
        return error(EnvError.missing, "{msg}")
    }
    return error(EnvError.invalid, "{msg}")
}
