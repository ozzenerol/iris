// HTTP/1.1 and HTTP/2: a server, where each connection gets a task and
// its requests are answered while the client keeps it open; a Router that
// sends each request to the handler for its method and path; a client,
// with a Client that keeps connections open; and WebSockets. https works on
// both sides, with TLS from OpenSSL; over TLS, HTTP/2 is used when the
// other side offers it.

import compress, json, net, str, time

// What HTTP calls fail with: badUrl for an address that isn't http:// or
// https://, badReply for a reply that isn't HTTP, tooBig for a body over the
// limit, badRequest for a request line that isn't HTTP/1.x.
pub enum HttpError { badUrl, badReply, tooBig, badRequest }

// What answers a request. It can fail: an error that leaves it is
// answered with 500 and the error's message, as res.error does. A function
// that returns void can be given as well.
pub type Handler = !void(Request *, Response *)

// A request, as the handler sees it. It and its text are gone when the
// handler returns: copy what is kept longer, as req.path.copy().
pub struct Request {
    pub String method
    pub String path
    pub String body
    // "HTTP/1.1" or "HTTP/2"
    pub str protocol
    // who sent the request: the client's address and port, or the
    // proxy's when there is one in front
    pub net.Addr remote
    // the header lines, "Name: value", each ending in \n or \r\n: a
    // view of the connection's buffer, or of own
    str head
    String own
    List[str] paramNames
    List[str] paramValues
    List[String] kept // form values decoded by form, freed with the request
    bool views        // method, path, head and body point into the connection's buffer
    // when the request came in, by time.clock(): time.clock() - req.received
    // is how long it has taken
    pub Duration received
}

// The answer the handler fills in. It is sent when the handler returns.
pub struct Response {
    pub i32 status
    String contentType = "text/plain; charset=utf-8"
    String body
    String headers
}

// Adds a header to the answer: res.header("Cache-Control", "no-store").
// Content-Type replaces the type the answer has, as send does.
pub void Response.header(str name, str value) {
    if sameName(name, "Content-Type") {
        self.contentType.free()
        self.contentType = value.copy()
        return
    }
    self.headers.append(name)
    self.headers.append(": ")
    self.headers.append(value)
    self.headers.append("\r\n")
}

// The value of :name or *name in the Router's pattern that matched, with
// %XX decoded, "" when there is none.
pub str Request.param(str name) {
    for i in 0..self.paramNames.len {
        if self.paramNames.at(i) == name {
            return self.decoded(self.paramValues.at(i), false)
        }
    }
    return ""
}

// The path without the query: /users/7 for /users/7?full=1.
pub str Request.route() {
    p, _, _ := str.cut(self.path, "?")
    return p
}

// A value from the query, with %XX and + decoded: query("q") is "tea &
// cake" for /search?q=tea+%26+cake, and "" when it isn't there.
pub str Request.query(str name) {
    _, q, found := str.cut(self.path, "?")
    if !found {
        return ""
    }
    rest := q
    for rest.len > 0 {
        pair, after, _ := str.cut(rest, "&")
        key, value, _ := str.cut(pair, "=")
        if self.decoded(key, true) == name {
            return self.decoded(value, true)
        }
        rest = after
    }
    return ""
}

bool sameName(str a, str b) {
    if a.len != b.len {
        return false
    }
    for i in 0..a.len {
        x := a[i]
        y := b[i]
        if x >= 'A' && x <= 'Z' { x = x + 32 }
        if y >= 'A' && y <= 'Z' { y = y + 32 }
        if x != y {
            return false
        }
    }
    return true
}

// The value of a header, "" when the request has none. Names match in any case.
pub str Request.header(str name) {
    rest := self.head
    for rest.len > 0 {
        n, v, after := nextHeader(rest)
        if sameName(n, name) {
            return v
        }
        rest = after
    }
    return ""
}

// Whether the request has a header of this name, even an empty one.
bool Request.hasHeader(str name) {
    rest := self.head
    for rest.len > 0 {
        n, _, after := nextHeader(rest)
        if sameName(n, name) {
            return true
        }
        rest = after
    }
    return false
}

// The first header line in rest, its name and value trimmed, and the lines
// after it. A line without a colon has the name "".
(str, str, str) nextHeader(str rest) {
    line, after, _ := str.cut(rest, "\n")
    name, value, found := str.cut(line, ":")
    if !found {
        return ("", "", after)
    }
    return (str.trim(name), str.trim(value), after)
}

// Adds a header line to the request's own head, for a request read into
// Strings of its own.
void Request.addHeader(str name, str value) {
    self.own.append(name)
    self.own.append(": ")
    self.own.append(value)
    self.own.append("\n")
    self.head = self.own
}

void Request.free() {
    self.method.free()
    self.path.free()
    self.body.free()
    self.own.free()
    self.head = ""
    self.paramNames.free()
    self.paramValues.free()
    self.kept.freeEach()
}

// Answers with text.
pub void Response.text(str body) {
    self.body.truncate(0)
    self.body.append(body)
    self.contentType.free()
    self.contentType = borrow("text/plain; charset=utf-8")
}

// Answers with HTML.
pub void Response.html(str body) {
    self.body.truncate(0)
    self.body.append(body)
    self.contentType.free()
    self.contentType = borrow("text/html; charset=utf-8")
}

// Answers with body as contentType, for any type text, json and html
// don't cover: res.send(csv, "text/csv").
pub void Response.send(str body, str contentType) {
    self.body.truncate(0)
    self.body.append(body)
    self.contentType.free()
    self.contentType = contentType.copy()
}

// Answers with an error, as JSON: {"error": "message"}.
pub void Response.error(i32 status, str message) {
    self.status = status
    scoped String q = json.quote(message)
    scoped String body = format("{{\"error\": {q}}}")
    self.json(body)
}

// Answers with JSON text.
pub void Response.json(str body) {
    self.body.truncate(0)
    self.body.append(body)
    self.contentType.free()
    self.contentType = borrow("application/json")
}

str statusText(i32 code) => match code {
    200 => "OK"
    201 => "Created"
    204 => "No Content"
    301 => "Moved Permanently"
    302 => "Found"
    400 => "Bad Request"
    401 => "Unauthorized"
    403 => "Forbidden"
    404 => "Not Found"
    405 => "Method Not Allowed"
    408 => "Request Timeout"
    409 => "Conflict"
    410 => "Gone"
    413 => "Content Too Large"
    415 => "Unsupported Media Type"
    422 => "Unprocessable Content"
    429 => "Too Many Requests"
    431 => "Request Header Fields Too Large"
    500 => "Internal Server Error"
    501 => "Not Implemented"
    502 => "Bad Gateway"
    503 => "Service Unavailable"
    504 => "Gateway Timeout"
    _ => "Status"
}

@extern("iris_string_borrow")
void rawBorrow(String *s, u8 *p, i64 n)

// A String that points at s, which outlives it: no copy, and freeing it
// frees nothing.
String borrow(str s) {
    String out
    rawBorrow(&out, s.ptr, s.len)
    return out
}

// Gives the request copies of what points into the connection's buffer,
// for when the connection is read while the request is still in use.
void Request.keep() {
    if !self.views {
        return
    }
    self.views = false
    self.method = self.method.copy()
    self.path = self.path.copy()
    self.body = self.body.copy()
    self.own.free()
    self.own = self.head.copy()
    self.head = self.own
}

// Where the head of a request in b ends, after its blank line; 0 when it
// hasn't all come yet. The search starts at from.
i64 headEnd(str b, i64 from) {
    for i in from..b.len {
        if b[i] == '\n' {
            if i + 1 < b.len && b[i + 1] == '\n' {
                return i + 2
            }
            if i + 2 < b.len && b[i + 1] == '\r' && b[i + 2] == '\n' {
                return i + 3
            }
        }
    }
    return 0
}

// How the body of a request with these headers comes: its length from
// Content-Length, or -1 when it comes in chunks. A request with both, with
// a Transfer-Encoding other than chunked or with a length that isn't one
// is refused, so a server behind a proxy can't be made to read part of a
// body as a request of its own (RFC 9112 6.3).
!i64 bodyLength(str length, str coding, bool hasLength) {
    if coding.len > 0 {
        if !sameName(str.trim(coding), "chunked") {
            return error(HttpError.badRequest, "a Transfer-Encoding other than chunked: '{coding}'")
        }
        if hasLength {
            return error(HttpError.badRequest, "both Content-Length and Transfer-Encoding")
        }
        return -1
    }
    if !hasLength {
        return 0
    }
    n := str.parseInt(str.trim(length)) catch e {
        return error(HttpError.badRequest, "a Content-Length that isn't a number: '{length}'")
    }
    if n < 0 {
        return error(HttpError.badRequest, "a Content-Length that isn't a number: '{length}'")
    }
    return n
}

// Fills req from the head of a request, its fields pointing into head.
// The body's length as bodyLength gives it.
!i64 parseHead(str head, Request *req, Limits *limits) {
    line, rest, _ := str.cut(head, "\n")
    line = str.trimSuffix(line, "\r")
    method, after, ok := str.cut(line, " ")
    path, version, ok2 := str.cut(after, " ")
    if !ok || !ok2 || !str.startsWith(version, "HTTP/1.") && !(method == "PRI" && version == "HTTP/2.0") {
        return error(HttpError.badRequest, "a request line HTTP doesn't allow: '{line}'")
    }
    req.method = borrow(method)
    req.path = borrow(path)
    req.head = rest
    req.views = true
    str length = ""
    str coding = ""
    bool hasLength = false
    for rest.len > 0 {
        h, next, _ := str.cut(rest, "\n")
        if h.len > limits.maxHeader + 1 {
            return error(net.NetError.tooLong, "reading a line: longer than {limits.maxHeader} bytes")
        }
        name, value, _ := nextHeader(rest)
        rest = next
        if name.len == 14 && sameName(name, "Content-Length") {
            if hasLength && str.trim(value) != str.trim(length) {
                return error(HttpError.badRequest, "two different Content-Lengths")
            }
            length = value
            hasLength = true
        } else if name.len == 17 && sameName(name, "Transfer-Encoding") {
            coding = value
        }
    }
    return try bodyLength(length, coding, hasLength)
}

// Answers Expect: 100-continue, so the client sends the body.
!void allowBody(net.Conn *c, Request *req) {
    if sameName(req.header("Expect"), "100-continue") {
        try c.write("HTTP/1.1 100 Continue\r\n\r\n")
    }
}

// Reads a body sent in chunks into a String of the request's own, with
// the trailer lines after it, which are dropped.
!void readChunked(net.Conn *c, Request *req, Limits *limits) {
    String body
    errdefer body.free()
    for {
        scoped String sizeLine = try c.readLine(limits.maxHeader)
        sizeText, _, _ := str.cut(sizeLine, ";")
        size := hexNumber(str.trim(sizeText)) catch e {
            return error(HttpError.badRequest, e.message)
        }
        if size == 0 {
            break
        }
        if size > limits.maxBody - body.len {
            return error(HttpError.tooBig, "a body of more than {limits.maxBody} bytes")
        }
        scoped String chunk = try c.readExactly(size)
        body.append(chunk)
        scoped String end = try c.readLine(limits.maxHeader)
        if end.len != 0 {
            return error(HttpError.badRequest, "a chunk longer than its size")
        }
    }
    for {
        scoped String trailer = try c.readLine(limits.maxHeader)
        if trailer.len == 0 {
            break
        }
    }
    req.body.free()
    req.body = body
}

// Reads one request, which points into the connection's buffer when it
// fits there; readHead reads one that doesn't. False when the client has
// closed the connection.
!bool readRequest(net.Conn *c, Request *req, Limits *limits) {
    i64 scanned = 0
    i64 end = 0
    for {
        b := c.buffered()
        end = headEnd(b, scanned)
        if end > 0 {
            break
        }
        scanned = if b.len > 2 { b.len - 2 } else { 0 }
        more := c.readMore() catch e {
            if e.code == net.NetError.closed {
                return false
            }
            return e
        }
        if !more {
            if c.buffered().len < c.bufferSize() {
                return false // closed
            }
            return try readHead(c, req, limits)
        }
    }
    req.received = time.clock()
    req.protocol = "HTTP/1.1"
    length := try parseHead(c.buffered()[0:end], req, limits)
    if length > limits.maxBody {
        return error(HttpError.tooBig, "a body of {length} bytes, more than {limits.maxBody}")
    }
    if length < 0 {
        // the body comes in chunks: the request gets copies of its head,
        // as reading the chunks moves the buffer
        req.keep()
        c.skip(end)
        try allowBody(c, req)
        try readChunked(c, req, limits)
        return true
    }
    if length == 0 {
        c.skip(end)
        return true
    }
    if c.buffered().len < end + length {
        try allowBody(c, req)
    }
    if end + length > c.bufferSize() {
        req.head = ""
        req.views = false
        req.method = borrow("")
        req.path = borrow("")
        return try readHead(c, req, limits)
    }
    if c.buffered().len < end + length {
        for c.buffered().len < end + length {
            if !try c.readMore() {
                return error(net.NetError.closed, "reading: connection closed")
            }
        }
        // reading may have moved the buffer's bytes
        _ = try parseHead(c.buffered()[0:end], req, limits)
    }
    req.body = borrow(c.buffered()[end:end + length])
    c.skip(end + length)
    return true
}

// Reads one request a line at a time into Strings of its own, for a head
// or body too big for the connection's buffer.
!bool readHead(net.Conn *c, Request *req, Limits *limits) {
    line := c.readLine(limits.maxHeader) catch e {
        if e.code == net.NetError.closed {
            return false
        }
        return e
    }
    defer line.free()
    method, rest, ok := str.cut(line, " ")
    path, version, ok2 := str.cut(rest, " ")
    if !ok || !ok2 || !str.startsWith(version, "HTTP/1.") && !(method == "PRI" && version == "HTTP/2.0") {
        return error(HttpError.badRequest, "a request line HTTP doesn't allow: '{line}'")
    }
    req.received = time.clock()
    req.protocol = "HTTP/1.1"
    req.method = method.copy()
    req.path = path.copy()
    for {
        scoped String h = try c.readLine(limits.maxHeader)
        if h.len == 0 {
            break
        }
        name, value, found := str.cut(h, ":")
        if found {
            req.addHeader(str.trim(name), str.trim(value))
        }
    }
    length := try bodyLength(req.header("Content-Length"), req.header("Transfer-Encoding"),
        req.hasHeader("Content-Length"))
    if length > limits.maxBody {
        return error(HttpError.tooBig, "a body of {length} bytes, more than {limits.maxBody}")
    }
    if length < 0 {
        try allowBody(c, req)
        try readChunked(c, req, limits)
    } else if length > 0 {
        try allowBody(c, req)
        req.body = try c.readExactly(length)
    }
    return true
}

// Whether text of this type gets smaller with gzip.
bool compressible(str contentType) {
    return str.startsWith(contentType, "text/") || str.contains(contentType, "json") ||
        str.contains(contentType, "javascript") || str.contains(contentType, "xml") ||
        str.contains(contentType, "svg")
}

// Compresses the answer when the router does gzip and the client takes it.
void maybeGzip(Router *router, Request *req, Response *res) {
    if router == null || !router.gzip || res.body.len < 1024 || !compressible(res.contentType) {
        return
    }
    if !str.contains(req.header("Accept-Encoding"), "gzip") {
        return
    }
    scoped String lower = str.lower(res.headers)
    if str.contains(lower, "content-encoding:") {
        return // the handler encoded it itself
    }
    packed := compress.gzip(res.body, 5) catch e {
        return
    }
    res.body.free()
    res.body = packed
    res.headers.append("Content-Encoding: gzip\r\nVary: Accept-Encoding\r\n")
}

// Adds n in decimal.
void appendInt(String *out, i64 n) {
    if n < 0 {
        out.append("-")
        n = -n
    }
    u8[20] digits
    i64 i = 20
    for {
        i -= 1
        digits[i] = u8('0' + n % 10)
        n /= 10
        if n == 0 {
            break
        }
    }
    out.append(digits[i:20])
}

// Writes the answer, built in out, which a connection keeps for all its
// answers.
!void writeResponse(net.Conn *c, Response *res, bool keepAlive, String *out) {
    out.truncate(0)
    out.append("HTTP/1.1 ")
    appendInt(out, i64(res.status))
    out.append(" ")
    out.append(statusText(res.status))
    out.append("\r\nContent-Type: ")
    out.append(res.contentType)
    out.append("\r\nContent-Length: ")
    appendInt(out, res.body.len)
    out.append("\r\n")
    out.append(res.headers)
    out.append(if keepAlive { "Connection: keep-alive\r\n\r\n" } else { "Connection: close\r\n\r\n" })
    out.append(res.body)
    try c.write(*out)
}

// Opens a WebSocket on the connection and hands it to the route's handler.
void upgrade(net.Conn *conn, Request *req, Route *route, Watch *w, Limits *limits) {
    scoped String accept = acceptKey(req.header("Sec-WebSocket-Key"))
    scoped String reply = format("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: {accept}\r\n\r\n")
    conn.write(reply) catch e {
        return
    }
    req.keep() // the socket reads into the buffer the request points into
    unwatch(w) // a WebSocket may stay quiet for long
    WebSocket ws = WebSocket{conn: conn, maxMessage: limits.maxBody}
    route.socket(&ws, req) catch e { }
    ws.close()
}

// Answers a request that can't be read with status, then closes.
void refuse(net.Conn *c, i32 status, str message) {
    Response res
    res.status = status
    res.body = format("{message}\n")
    scoped String out
    writeResponse(c, &res, false, &out) catch e { }
    res.body.free()
    res.contentType.free()
}

// A connection the sweeper looks after: it is shut down when it has done
// nothing for longer than the timeout. One sweeper task per thread, so no
// read or write needs a timer of its own.
struct Watch {
    net.Conn *conn
    Duration last
}

threadlocal List[Watch *] watches
threadlocal bool sweeping

void sweep(Duration timeout, Router *router) {
    for {
        sleep(if timeout < 1s { timeout } else { 1s })
        now := time.clock()
        for i in 0..watches.len {
            w := watches.at(i)
            if now - w.last > timeout {
                w.conn.interrupt()
            }
        }
        if router != null && router.stopping.load() != 0 && watches.len == 0 {
            return
        }
    }
}

void watch(Watch *w, Limits *limits, Router *router) {
    if limits.timeout <= 0 {
        return
    }
    if !sweeping {
        sweeping = true
        spawn sweep(limits.timeout, router)
    }
    watches.push(w)
}

void unwatch(Watch *w) {
    for i in 0..watches.len {
        if watches.at(i) == w {
            watches.set(i, watches.last())
            _ = watches.pop()
            return
        }
    }
}

void serveConn(net.Conn conn, Target target) {
    defer conn.close()
    limits := target.limits
    remote := conn.remoteAddr()
    Watch w = Watch{conn: &conn, last: time.clock()}
    watch(&w, &limits, target.router)
    defer unwatch(&w)
    if target.tls != null {
        conn.acceptTls(target.tls) catch e {
            return
        }
        if conn.protocol() == "h2" {
            scoped String preface = conn.readExactly(PREFACE.len) catch e {
                return
            }
            if preface == PREFACE {
                serveH2(&conn, target, limits, &w, remote)
            } else {
                scoped String bye = goawayFrame(0, E_PROTOCOL)
                conn.write(bye) catch e { }
            }
            return
        }
    }
    // kept for all the connection's requests
    String out
    Response res
    defer {
        out.free()
        res.body.free()
        res.headers.free()
        res.contentType.free()
    }
    for {
        if target.router != null && target.router.stopping.load() != 0 {
            return
        }
        Request req
        req.remote = remote
        more := readRequest(&conn, &req, &limits) catch e {
            req.free()
            if e.code == net.NetError.tooLong {
                refuse(&conn, 431, "a header line is too long")
            } else if e.code == HttpError.tooBig {
                refuse(&conn, 413, "the body is too large")
            } else if e.code == HttpError.badRequest {
                refuse(&conn, 400, e.message)
            }
            return
        }
        w.last = time.clock()
        if !more {
            return
        }
        if req.method == "PRI" && req.path == "*" {
            // HTTP/2 with prior knowledge: the rest of the preface, then
            // frames
            req.free()
            scoped String rest = conn.readExactly(6) catch e {
                return
            }
            if rest == "SM\r\n\r\n" {
                serveH2(&conn, target, limits, &w, remote)
            }
            return
        }
        if target.router != null {
            route := target.router.socketRoute(&req)
            if route != null {
                upgrade(&conn, &req, route, &w, &limits)
                req.free()
                return
            }
            target.router.busy.add(1)
        }
        res.status = 200
        if target.router != null {
            target.router.dispatch(&req, &res)
        } else {
            run(target.handler, &req, &res)
        }
        maybeGzip(target.router, &req, &res)
        keepAlive := !sameName(req.header("Connection"), "close")
        bool failed = false
        writeResponse(&conn, &res, keepAlive, &out) catch e {
            failed = true
        }
        // the next answer reuses the room, unless it is large
        reset(&res.body)
        reset(&res.headers)
        reset(&out)
        res.contentType.free()
        res.contentType = borrow("text/plain; charset=utf-8")
        req.free()
        if target.router != null {
            target.router.busy.sub(1)
        }
        w.last = time.clock()
        if !keepAlive || failed {
            return
        }
    }
}

// Empties s for reuse, or frees it when it holds more than 64 KiB.
void reset(String *s) {
    if s.len > 64KiB {
        s.free()
    } else {
        s.truncate(0)
    }
}

@extern("iris_cpu_count")
i64 cpuCount()

@extern("iris_listen_per_thread")
i32 listenPerThread()

// Calls a handler; an error from it becomes a 500.
void run(Handler handler, Request *req, Response *res) {
    handler(req, res) catch e {
        res.headers.free()
        res.error(500, e.message)
    }
}

// What answers the requests: a handler, or a Router.
struct Target {
    Handler handler
    Router *router
    net.TlsConfig *tls
    Limits limits
}

// The limits of a server.
struct Limits {
    Duration timeout
    i64 maxBody
    i64 maxHeader
}

Limits limitsOf(Router *r) {
    Limits l = Limits{timeout: 30s, maxBody: 16MiB, maxHeader: 8KiB}
    if r != null {
        if r.timeout != 0 {
            l.timeout = if r.timeout < 0 { 0s } else { r.timeout }
        }
        if r.maxBody > 0 {
            l.maxBody = r.maxBody
        }
        if r.maxHeader > 0 {
            l.maxHeader = r.maxHeader
        }
    }
    return l
}

void serveThread(net.Listener shared, bool own, u16 port, str host, Target target) {
    ln := shared
    if own {
        ln = net.listen(port, host, true) catch e {
            return
        }
    }
    acceptLoop(ln, target) catch e { }
}

void startThreads(i64 n, net.Listener ln, bool own, u16 port, str host, Target target) {
    for i in 1..n {
        thread serveThread(ln, own, port, host, target)
    }
}

!void acceptLoop(net.Listener ln, Target target) {
    if target.router == null {
        for {
            conn := try ln.accept()
            spawn serveConn(conn, target)
        }
    }
    // a Router can be shut down. On Linux shutdown wakes the accept; macOS
    // doesn't, so there the loop looks every 200ms.
    r := target.router
    r.lock.lock()
    r.listeners.push(ln)
    r.lock.unlock()
    Duration wait
    when os == .macos {
        wait = 200ms
    }
    for r.stopping.load() == 0 {
        conn := ln.accept(wait) catch e {
            if r.stopping.load() != 0 {
                break
            }
            if e.code == net.NetError.timeout {
                continue
            }
            return e
        }
        spawn serveConn(conn, target)
    }
    ln.close()
    // serve returns when the requests being answered are done
    for r.busy.load() > 0 && time.clock() < r.drainEnd.load() {
        sleep(5ms)
    }
}

!void serveTarget(u16 port, Target target, str host, i64 threads) {
    target.limits = limitsOf(target.router)
    n := if threads > 0 { threads } else { cpuCount() }
    own := listenPerThread() == 1 && port != 0
    ln := try net.listen(port, host, own)
    startThreads(n, ln, own, port, host, target)
    try acceptLoop(ln, target)
}

!void serveTargetOn(net.Listener ln, Target target, i64 threads) {
    target.limits = limitsOf(target.router)
    n := if threads > 0 { threads } else { cpuCount() }
    startThreads(n, ln, false, 0, "", target)
    try acceptLoop(ln, target)
}

// Answers HTTP requests on port with handler, each connection in its own
// task. threads event loops share the work, one per thread; 0 means one
// per CPU core. With more than one, handler runs on several threads at once.
pub !void serve(u16 port, Handler handler, str host = "", i64 threads = 0) {
    try serveTarget(port, Target{handler: handler}, host, threads)
}

// Like serve, on a listener that is already open (for port 0). Its
// threads all accept on ln; the default is one.
pub !void serveOn(net.Listener ln, Handler handler, i64 threads = 1) {
    try serveTargetOn(ln, Target{handler: handler}, threads)
}

// ------------------------------------------------------------ the router

struct Route {
    String method   // "" for any method
    List[str] parts // the pattern's path, split at /
    String pattern
    Handler handler
    SocketHandler socket // a WebSocket route
}

// Sends each request to the handler for its method and path. Patterns are
// paths with :name for one part and *name for the rest: "/users/:id",
// "/files/*path". When several match, the one with the most fixed parts
// wins. A path no pattern has gets 404; a path that is
// there for other methods gets 405 with an Allow header.
pub struct Router {
    List[Route] routes
    List[Hook] befores
    List[Hook] afters
    // how long a read or a write of a connection may wait (0: 30s, below 0:
    // no limit), the largest body (0: 16 MiB, larger gets 413) and the
    // longest header line (0: 8 KiB, longer gets 431)
    pub Duration timeout
    pub i64 maxBody
    pub i64 maxHeader
    // gzip text answers of 1 KiB or more for clients that accept it
    pub bool gzip
    Atomic[i64] stopping
    Atomic[i64] busy
    Mutex lock
    List[net.Listener] listeners
    Atomic[i64] drainEnd
}

// Stops the server: no new connections, and serve returns once the
// requests that are being answered are done, or wait has passed.
pub void Router.shutdown(Duration wait = 10s) {
    self.drainEnd.store(i64(time.clock() + wait))
    self.stopping.store(1)
    self.lock.lock()
    for ln in self.listeners {
        ln.interrupt()
    }
    self.lock.unlock()
    start := time.clock()
    for self.busy.load() > 0 && time.clock() - start < wait {
        sleep(5ms)
    }
}

struct Hook {
    String prefix
    bool(Request *, Response *) check
    void(Request *, Response *) done
}

// Runs check before the handler of every request whose path starts with
// prefix ("" for all), in the order they were added. When check gives
// false, the request is answered with what check put in the response, and
// no handler runs: an auth check, a rate limit.
pub void Router.use(bool(Request *, Response *) check, str prefix = "") {
    self.befores.push(Hook{prefix: prefix.copy(), check: check})
}

// Runs done after every request, answered or not: an access log.
pub void Router.after(void(Request *, Response *) done) {
    self.afters.push(Hook{done: done})
}

List[str] splitPath(str p) {
    List[str] parts
    rest := if p.len > 0 && p[0] == '/' { p[1:] } else { p }
    if rest.len == 0 {
        return parts
    }
    for {
        part, after, more := str.cut(rest, "/")
        parts.push(part)
        if !more {
            return parts
        }
        rest = after
    }
}

// Adds a handler for a pattern, with or without a method in front:
// "GET /users/:id" or "/health" for every method.
pub void Router.handle(str pattern, Handler handler) {
    method, path, spaced := str.cut(pattern, " ")
    Route r
    r.pattern = pattern.copy()
    r.handler = handler
    if spaced {
        r.method = method.copy()
    } else {
        path = pattern
    }
    r.parts = splitPath(r.pattern[r.pattern.len - path.len:])
    self.routes.push(r)
}

// Adds a handler for GET requests to path.
pub void Router.get(str path, Handler handler) => self.add("GET", path, handler)

// Adds a handler for POST requests to path.
pub void Router.post(str path, Handler handler) => self.add("POST", path, handler)

// Adds a handler for PUT requests to path.
pub void Router.put(str path, Handler handler) => self.add("PUT", path, handler)

// Adds a handler for DELETE requests to path.
pub void Router.delete(str path, Handler handler) => self.add("DELETE", path, handler)

// Adds a handler for PATCH requests to path.
pub void Router.patch(str path, Handler handler) => self.add("PATCH", path, handler)

// Answers WebSockets at path with handler, which gets the open WebSocket.
// The connection is closed when handler returns.
pub void Router.websocket(str path, SocketHandler handler) {
    Route r
    r.pattern = path.copy()
    r.method = "GET".copy()
    r.socket = handler
    r.parts = splitPath(r.pattern)
    self.routes.push(r)
}

// The WebSocket route for a request that asks for one, or null.
Route *Router.socketRoute(Request *req) {
    if !sameName(req.header("Upgrade"), "websocket") {
        return null
    }
    scoped List[str] parts = splitPath(req.route())
    for i in 0..self.routes.len {
        r := &self.routes.items()[i]
        if r.socket != null && score(r, &parts) >= 0 {
            return r
        }
    }
    return null
}

void Router.add(str method, str path, Handler handler) {
    scoped String pattern = format("{method} {path}")
    self.handle(pattern, handler)
}

// How well a route's parts match a path: -1 when they don't, else the
// number of fixed parts.
i64 score(Route *r, List[str] *parts) {
    i64 fixed
    for i in 0..r.parts.len {
        p := r.parts.at(i)
        if p.len > 1 && p[0] == '*' {
            return if i <= parts.len { fixed } else { -1 }
        }
        if i >= parts.len {
            return -1
        }
        if p.len > 1 && p[0] == ':' {
            if parts.at(i).len == 0 {
                return -1
            }
            continue
        }
        if p != parts.at(i) {
            return -1
        }
        fixed += 1
    }
    return if r.parts.len == parts.len { fixed } else { -1 }
}

void Router.dispatch(Request *req, Response *res) {
    defer {
        for h in self.afters {
            h.done(req, res)
        }
    }
    for h in self.befores {
        if str.startsWith(req.route(), h.prefix) && !h.check(req, res) {
            return
        }
    }
    scoped List[str] parts = splitPath(req.route())
    Route *best = null
    i64 bestScore = -1
    bool pathFound = false
    String allow
    defer allow.free()
    for i in 0..self.routes.len {
        r := &self.routes.items()[i]
        if r.socket != null {
            continue // WebSocket routes only answer upgrades
        }
        sc := score(r, &parts)
        if sc < 0 {
            continue
        }
        if r.method.len > 0 && r.method != req.method {
            pathFound = true
            if !str.contains(allow, r.method) {
                if allow.len > 0 {
                    allow.append(", ")
                }
                allow.append(r.method)
            }
            continue
        }
        if sc > bestScore {
            best = r
            bestScore = sc
        }
    }
    if best == null {
        if pathFound {
            res.status = 405
            res.header("Allow", allow)
            res.text("method not allowed\n")
        } else {
            res.status = 404
            res.text("not found\n")
        }
        return
    }
    for i in 0..best.parts.len {
        p := best.parts.at(i)
        if p.len > 1 && (p[0] == ':' || p[0] == '*') {
            if p[0] == '*' {
                route := req.route()
                rest := ""
                skip := i
                at := if route.len > 0 && route[0] == '/' { 1 } else { 0 }
                for skip > 0 && at < route.len {
                    if route[at] == '/' {
                        skip -= 1
                    }
                    at += 1
                }
                if at <= route.len {
                    rest = route[at:]
                }
                req.paramNames.push(p[1:])
                req.paramValues.push(rest)
                break
            }
            req.paramNames.push(p[1:])
            req.paramValues.push(parts.at(i))
        }
    }
    run(best.handler, req, res)
}

// Answers HTTPS requests on port with handler, as serve does, with the
// certificate chain and key in PEM files.
pub !void serveTls(u16 port, Handler handler, str certFile, str keyFile, str host = "",
    i64 threads = 0) {
        config := try net.tlsConfig(certFile, keyFile)
        defer config.free()
        config.offerHttp2()
        try serveTarget(port, Target{handler: handler, tls: &config}, host, threads)
    }

// Answers HTTPS requests on a listener that is already open.
pub !void serveTlsOn(net.Listener ln, Handler handler, net.TlsConfig *config,
    i64 threads = 1) {
        try serveTargetOn(ln, Target{handler: handler, tls: config}, threads)
    }

// Answers HTTP requests on port with the router, as serve does.
pub !void Router.serve(u16 port, str host = "", i64 threads = 0) {
    try serveTarget(port, Target{router: self}, host, threads)
}

// Like serve, on a listener that is already open.
pub !void Router.serveOn(net.Listener ln, i64 threads = 1) {
    try serveTargetOn(ln, Target{router: self}, threads)
}

// Answers HTTPS requests on port with the router, as serveTls does.
pub !void Router.serveTls(u16 port, str certFile, str keyFile, str host = "", i64 threads = 0) {
    config := try net.tlsConfig(certFile, keyFile)
    defer config.free()
    config.offerHttp2()
    try serveTarget(port, Target{router: self, tls: &config}, host, threads)
}

// Answers HTTPS requests on a listener that is already open.
pub !void Router.serveTlsOn(net.Listener ln, net.TlsConfig *config, i64 threads = 1) {
    try serveTargetOn(ln, Target{router: self, tls: config}, threads)
}

// Frees the routes and hooks.
pub void Router.free() {
    for r in self.routes {
        r.method.free()
        r.pattern.free()
        r.parts.free()
    }
    self.routes.free()
    for h in self.befores {
        h.prefix.free()
    }
    self.befores.free()
    self.afters.free()
    self.listeners.free()
}

// ------------------------------------------------------------ the client

// The answer to a request the client made. free gives it back.
pub struct Reply {
    pub i32 status
    pub String body
    // "HTTP/1.1" or "HTTP/2"
    pub str protocol
    List[String] names
    List[String] values
}

// A gzip body is decompressed, and its Content-Encoding header taken out,
// so the caller gets what the server meant to send.
!void Reply.decode() {
    for i in 0..self.names.len {
        if sameName(self.names.at(i), "Content-Encoding") {
            if !sameName(self.values.at(i), "gzip") {
                return
            }
            plain := compress.gunzip(self.body) catch e {
                return error(HttpError.badReply, "the gzip body is broken: {e.message}")
            }
            self.body.free()
            self.body = plain
            n := self.names.remove(i)
            v := self.values.remove(i)
            n.free()
            v.free()
            return
        }
    }
}

// The value of a header of the reply, "" when it has none.
pub str Reply.header(str name) {
    for i in 0..self.names.len {
        if sameName(self.names.at(i), name) {
            return self.values.at(i)
        }
    }
    return ""
}

// Frees the body and the headers.
pub void Reply.free() {
    self.body.free()
    for n in self.names {
        n.free()
    }
    for v in self.values {
        v.free()
    }
    self.names.free()
    self.values.free()
}

// Asks for url with GET.
pub !Reply get(str url) => try send("GET", url)

// Sends body to url with POST.
pub !Reply post(str url, str contentType, str body) => try send("POST", url, body, contentType)

// Where a request goes, from its URL.
struct Dest {
    bool secure
    str host
    str hostPort
    str path
    u16 port
}

!Dest destOf(str url) {
    secure := str.startsWith(url, "https://")
    if !secure && !str.startsWith(url, "http://") {
        return error(HttpError.badUrl, "{url}: the address should start with http:// or https://")
    }
    rest := url[if secure { 8 } else { 7 }:]
    hostPort, _, _ := str.cut(rest, "/")
    path := rest[hostPort.len:]
    if path.len == 0 {
        path = "/"
    }
    host, portText, hasPort := str.cut(hostPort, ":")
    i64 port = if secure { 443 } else { 80 }
    if hasPort {
        port = str.parseInt(portText) catch e {
            return error(HttpError.badUrl, "{url}: the port isn't a number")
        }
    }
    if host.len == 0 || port < 1 || port > 65535 {
        return error(HttpError.badUrl, "{url}: no host")
    }
    return Dest{secure: secure, host: host, hostPort: hostPort, path: path, port: u16(port)}
}

String requestText(str method, Dest *d, str body, str contentType, bool keepAlive) {
    String req = format("{method} {d.path} HTTP/1.1\r\nHost: {d.hostPort}\r\nUser-Agent: iris\r\nAccept-Encoding: gzip\r\n")
    if !keepAlive {
        req.append("Connection: close\r\n")
    }
    if body.len > 0 || method == "POST" || method == "PUT" || method == "PATCH" {
        scoped String length = format("Content-Length: {body.len}\r\n")
        req.append(length)
        if contentType.len > 0 {
            scoped String ct = format("Content-Type: {contentType}\r\n")
            req.append(ct)
        }
    }
    req.append("\r\n")
    req.append(body)
    return req
}

!net.Conn dialDest(Dest *d, Duration timeout, str protocols = "", str ca = "") {
    c := try net.dial(d.host, d.port, timeout)
    c.setTimeout(timeout)
    if d.secure {
        c.startTls(d.host, ca, protocols) catch e {
            c.close()
            return e
        }
    }
    return c
}

// Sends a request and reads the reply, on a connection of its own, waiting
// at most 30 seconds for each step. https:// addresses check the server's
// certificate against the ones the system trusts. A Client keeps
// connections open between requests.
pub !Reply send(str method, str url, str body = "", str contentType = "") {
    d := try destOf(url)
    c := try dialDest(&d, 30s)
    defer c.close()
    scoped String req = requestText(method, &d, body, contentType, false)
    try c.write(req)
    bool reusable
    return try readReply(&c, &reusable)
}

// A client that keeps connections to each host open between requests, and
// can be shared by tasks and threads.
pub struct Client {
    // how long dialing and each read and write may wait (0: 30s, below 0:
    // no limit), and how many idle connections it keeps for each host (0: 4)
    pub Duration timeout
    pub i64 maxIdle
    // https uses HTTP/2 when the server offers it, unless noHttp2; http://
    // uses it only with priorKnowledge, for servers known to speak it
    pub bool noHttp2
    pub bool priorKnowledge
    // a file of the certificates to trust instead of the system's ("")
    pub str ca
    Mutex lock
    Map[str, List[net.Conn]] idle
    Map[str, H2Conn *] h2
}

Duration Client.wait() => if self.timeout == 0 { 30s } else if self.timeout < 0 { 0s } else { self.timeout }

String destKey(Dest *d) => format("{if d.secure { "s" } else { "p" }}{d.hostPort}")

// An idle connection to d's host, if the client has one.
bool Client.take(Dest *d, net.Conn *out) {
    scoped String key = destKey(d)
    self.lock.lock()
    defer self.lock.unlock()
    conns, found := self.idle.get(key)
    if !found || conns.len == 0 {
        return false
    }
    *out = conns.pop()
    self.idle.set(key, conns)
    return true
}

void Client.keep(Dest *d, net.Conn c) {
    scoped String key = destKey(d)
    self.lock.lock()
    defer self.lock.unlock()
    conns, _ := self.idle.get(key)
    if conns.len >= (if self.maxIdle > 0 { self.maxIdle } else { 4 }) {
        c.close()
        return
    }
    conns.push(c)
    self.idle.set(key, conns)
}

// The HTTP/2 connection to d's host, if the client has one that is open.
H2Conn *Client.h2For(Dest *d) {
    scoped String key = destKey(d)
    self.lock.lock()
    defer self.lock.unlock()
    h, found := self.h2.get(key)
    if !found {
        return null
    }
    h.lock.lock()
    dead := h.dead
    h.lock.unlock()
    if dead {
        _ = self.h2.remove(key)
        h.close()
        return null
    }
    return h
}

// A new connection for d: HTTP/2 when both sides want it (h is set), or an
// HTTP/1.1 one.
!net.Conn Client.dialFor(Dest *d, H2Conn **h) {
    *h = null
    want := d.secure && !self.noHttp2 || !d.secure && self.priorKnowledge
    c := try dialDest(d, self.wait(), if want && d.secure { "\x02h2\x08http/1.1" } else { "" }, self.ca)
    if !want || d.secure && c.protocol() != "h2" {
        return c
    }
    conn := startH2(c, d)
    scoped String key = destKey(d)
    self.lock.lock()
    old, found := self.h2.get(key)
    self.h2.set(key, conn)
    self.lock.unlock()
    if found {
        old.close()
    }
    *h = conn
    return net.Conn{}
}

// Sends a request on a connection the client keeps, or a new one.
pub !Reply Client.send(str method, str url, str body = "", str contentType = "") {
    d := try destOf(url)
    for attempt in 0..2 {
        H2Conn *h = self.h2For(&d)
        net.Conn fresh
        bool dialed = false
        if h == null && !self.hasIdle(&d) {
            fresh = try self.dialFor(&d, &h)
            dialed = h == null
        }
        if h != null {
            bool retry
            r := h.request(method, &d, body, contentType, self.wait(), &retry) catch e {
                if retry && attempt == 0 {
                    continue
                }
                return e
            }
            return r
        }
        return try self.sendH1(method, &d, body, contentType, fresh, dialed)
    }
    return error(net.NetError.closed, "{url}: the connection closed")
}

bool Client.hasIdle(Dest *d) {
    scoped String key = destKey(d)
    self.lock.lock()
    defer self.lock.unlock()
    conns, found := self.idle.get(key)
    return found && conns.len > 0
}

// A request over HTTP/1.1, on fresh when it was just dialed, or on an idle
// connection, and on a new one when the idle one turns out to be closed.
!Reply Client.sendH1(str method, Dest *d, str body, str contentType, net.Conn fresh, bool dialed) {
    scoped String req = requestText(method, d, body, contentType, true)
    for attempt in 0..2 {
        net.Conn c = fresh
        reused := !dialed
        if reused && !self.take(d, &c) {
            c = try dialDest(d, self.wait(), ca: self.ca)
            reused = false
        }
        dialed = false
        c.write(req) catch e {
            c.close()
            if reused {
                continue // the server closed it while it was idle
            }
            return e
        }
        bool reusable
        r := readReply(&c, &reusable) catch e {
            c.close()
            if reused && e.code == net.NetError.closed {
                continue
            }
            return e
        }
        if reusable {
            self.keep(d, c)
        } else {
            c.close()
        }
        return r
    }
    return error(net.NetError.closed, "{d.host}: the connection closed")
}

// Sends a GET request to url.
pub !Reply Client.get(str url) => try self.send("GET", url)

// Sends body to url with POST, as contentType.
pub !Reply Client.post(str url, str contentType, str body) => try self.send("POST", url, body, contentType)

// Closes the connections the client keeps.
pub void Client.close() {
    self.lock.lock()
    for _, conns in self.idle {
        for c in conns {
            c.close()
        }
        conns.free()
    }
    self.idle.free()
    scoped List[str] hosts = self.h2.keys()
    List[H2Conn *] open
    for k in hosts {
        h, _ := self.h2.get(k)
        open.push(h)
    }
    self.h2.free()
    self.lock.unlock()
    for h in open {
        h.close()
    }
    open.free()
}

// Reads a reply. reusable says whether the connection can take another
// request: the reply's end was known and the server didn't close it.
!Reply readReply(net.Conn *c, bool *reusable) {
    r := try readRawReply(c, reusable)
    r.decode() catch e {
        r.free()
        return e
    }
    return r
}

!Reply readRawReply(net.Conn *c, bool *reusable) {
    *reusable = false
    Reply r
    r.protocol = "HTTP/1.1"
    errdefer r.free()
    scoped String status = try c.readLine()
    _, after, ok := str.cut(status, " ")
    code, _, _ := str.cut(after, " ")
    if !ok || !str.startsWith(status, "HTTP/") {
        return error(HttpError.badReply, "the server didn't answer in HTTP: '{status}'")
    }
    r.status = i32(str.parseInt(code) catch e {
        return error(HttpError.badReply, "the server's status isn't a number: '{status}'")
    })
    for {
        scoped String h = try c.readLine()
        if h.len == 0 {
            break
        }
        name, value, found := str.cut(h, ":")
        if found {
            r.names.push(str.trim(name).copy())
            r.values.push(str.trim(value).copy())
        }
    }
    if sameName(r.header("Transfer-Encoding"), "chunked") {
        for {
            scoped String sizeLine = try c.readLine()
            sizeText, _, _ := str.cut(sizeLine, ";")
            size := try hexNumber(str.trim(sizeText))
            if size == 0 {
                break
            }
            scoped String chunk = try c.readExactly(size)
            r.body.append(chunk)
            scoped String end = try c.readLine()
        }
        *reusable = !sameName(r.header("Connection"), "close")
        return r
    }
    lengthText := r.header("Content-Length")
    if lengthText.len > 0 {
        length := str.parseInt(lengthText) catch e {
            return error(HttpError.badReply, "the server's Content-Length isn't a number")
        }
        if length > 0 {
            r.body = try c.readExactly(length)
        }
        *reusable = !sameName(r.header("Connection"), "close")
        return r
    }
    u8[4096] buf
    for {
        n := c.read(buf) catch e {
            break
        }
        if n == 0 {
            break
        }
        r.body.append(buf[0:n])
    }
    return r
}

!i64 hexNumber(str s) {
    if s.len == 0 {
        return error(HttpError.badReply, "a chunk without a size")
    }
    i64 v
    for i in 0..s.len {
        ch := s[i]
        d := if ch >= '0' && ch <= '9' { i64(ch - '0') } else if ch >= 'a' && ch <= 'f' { i64(ch - 'a') + 10 } else if ch >= 'A' && ch <= 'F' { i64(ch - 'A') + 10 } else { -1 }
        if d < 0 {
            return error(HttpError.badReply, "a chunk size that isn't hex: '{s}'")
        }
        if v > (1 << 55) {
            return error(HttpError.badReply, "a chunk size too large: '{s}'")
        }
        v = v * 16 + d
    }
    return v
}
