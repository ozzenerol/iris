// Requests whose bodies go a part at a time: an upload written as it is
// made, and a reply read as it comes, such as a large download or
// server-sent events. They go over HTTP/2 when the Client has or makes an
// HTTP/2 connection to the host, and over HTTP/1.1 otherwise.

import net, str, time

// A request whose body is being written: write sends each part, and
// finish ends the body and gives the reply.
pub struct Upload {
    net.Conn conn
    Client *client
    String url
    bool chunked
    i64 left
    bool reused
    String trailers // "Name: value\r\n" lines sent after the body
    // over HTTP/2: the stream, what the writer still has to send of it,
    // and where its reply comes
    H2Conn *h2
    i64 stream
    StreamOut *sink
    chan[H2Result] done
    BodyIn *piped
    bool ended   // end was called
    bool replied // reply has the stream now
}

// A reply whose body is read as it comes: status and the headers are
// there at once, read gives the body a part at a time. close gives the
// connection back to the Client when all of it was read.
pub struct ReplyStream {
    pub i32 status
    List[String] names
    List[String] values
    net.Conn conn
    Client *client
    String url
    i64 mode // 0 a length, 1 chunked, 2 up to the end of the connection
    i64 left // length: bytes to come; chunked: of this chunk
    bool done
    bool reusable
    bool given         // the connection went back to the Client
    String trailerText // the trailer lines after the body, "Name: value\n"
    H2Conn *h2         // over HTTP/2: the body comes in piped
    i64 stream
    BodyIn *piped
}

// The value of a header of the reply, "" when it has none.
pub str ReplyStream.header(str name) {
    for i in 0..self.names.len {
        if sameName(self.names.at(i), name) {
            return self.values.at(i)
        }
    }
    return ""
}

// The value of a trailer, a header sent after the body, "" when the reply
// has none. Trailers are there once read has given 0.
pub str ReplyStream.trailer(str name) => lineValue(self.trailerText, name)

// Every trailer of the reply, in the order they came. Free only the list.
pub List[Header] ReplyStream.trailers() => lineHeaders(self.trailerText)

// Starts a request to url and gives an Upload to write its body to.
// length is the body's size when it is known, and -1 sends it in chunks
// (Transfer-Encoding: chunked). headers are the request's own, as send
// takes them.
pub !Upload Client.begin(str method, str url, str contentType = "", str[] headers = [], i64 length = -1) {
    try checkHeaders(headers)
    d := try destOf(url)
    Upload u
    u.client = self
    u.url = url.copy()
    errdefer u.url.free()
    for attempt in 0..3 {
        H2Conn *h = self.h2For(&d)
        net.Conn fresh
        if h == null && !self.hasIdle(&d) {
            fresh = try self.dialFor(&d, &h)
            if h == null {
                u.conn = fresh
                break
            }
        }
        if h == null {
            u.reused = self.take(&d, &u.conn)
            if !u.reused {
                u.conn = try dialDest(&d, self.wait(), ca: self.ca, connect: self.connectTimeout)
            }
            break
        }
        bool retry
        h.beginUpload(&u, method, &d, contentType, headers, length, &retry) catch e {
            if retry && attempt < 2 {
                continue
            }
            return e
        }
        return u
    }
    String all
    defer all.free()
    for h in headers {
        all.append(h)
        all.append("\r\n")
    }
    if contentType.len > 0 {
        all.append("Content-Type: ")
        all.append(contentType)
        all.append("\r\n")
    }
    if length >= 0 {
        all.append("Content-Length: ")
        appendInt(&all, length)
        all.append("\r\n")
        u.left = length
    } else if method != "GET" && method != "HEAD" {
        all.append("Transfer-Encoding: chunked\r\n")
        u.chunked = true
    }
    scoped String head = format("{method} {d.path} HTTP/1.1\r\nHost: {d.hostPort}\r\n")
    if !hasHeader(headers, "User-Agent") {
        head.append("User-Agent: iris\r\n")
    }
    head.append(all)
    head.append("\r\n")
    u.conn.write(head) catch e {
        u.conn.close()
        if !u.reused {
            return e
        }
        // the server closed the idle connection: once more on a new one
        u.reused = false
        u.conn = try dialDest(&d, self.wait(), ca: self.ca, connect: self.connectTimeout)
        u.conn.write(head) catch e2 {
            u.conn.close()
            return e2
        }
    }
    return u
}

// Sends data as the next part of the body.
pub !void Upload.write(str data) {
    if data.len == 0 {
        return
    }
    if self.h2 != null {
        if self.left >= 0 && data.len > self.left {
            return error(HttpError.badRequest, "the body is longer than its Content-Length")
        }
        // at most 1 MiB waits for a slow server
        for self.sink.queued.load() > 1MiB && self.sink.gone.load() == 0 {
            sleep(1ms)
        }
        if self.sink.gone.load() != 0 {
            return error(net.NetError.closed, "the server reset the stream")
        }
        if self.left >= 0 {
            self.left -= data.len
        }
        self.sink.queued.add(data.len)
        self.h2.jobs.put(Out{job: .chunk, stream: self.stream, data: data.copy(), sink: self.sink})
        return
    }
    if self.chunked {
        scoped String size = format("{data.len:x}\r\n")
        try self.conn.write(size)
        try self.conn.write(data)
        try self.conn.write("\r\n")
        return
    }
    if data.len > self.left {
        return error(HttpError.badRequest, "the body is longer than its Content-Length")
    }
    self.left -= data.len
    try self.conn.write(data)
}

// Adds a trailer, a header sent after the body. Over HTTP/1.1 it takes a
// body sent in chunks (begin with length -1).
pub void Upload.trailer(str name, str value) {
    self.trailers.append(name)
    self.trailers.append(": ")
    self.trailers.append(value)
    self.trailers.append("\r\n")
}

// Ends the body: what was written goes, then the trailers. Over HTTP/2
// the reply can be read before the body ends, with reply, as gRPC's
// streams in both directions do; over HTTP/1.1 reply comes after end.
pub !void Upload.end() {
    if self.ended {
        return
    }
    if self.h2 == null {
        self.ended = true
        return
    }
    if self.left > 0 {
        n := self.left
        self.abandon()
        return error(HttpError.badRequest, "{n} bytes of the body are missing")
    }
    self.ended = true
    // the writer has the trailers and the sink now
    self.h2.jobs.put(Out{job: .end, stream: self.stream, sink: self.sink, trailers: self.trailers})
    String none
    self.trailers = none
}

// Waits for the reply's status and headers and gives the reply, whose
// body is read as it comes. Over HTTP/2 the Upload still takes write
// until end; over HTTP/1.1 it must have ended.
pub !ReplyStream Upload.reply() {
    if self.h2 == null {
        if !self.ended {
            return error(HttpError.badRequest, "over HTTP/1.1 the reply comes once the body has ended: call end first")
        }
        return try self.finish()
    }
    h := self.h2
    self.replied = true
    String url = self.url
    String none
    self.url = none
    r := h.wait(self.stream, self.done, self.client.wait()) catch e {
        url.free()
        self.piped.release()
        return e
    }
    if !r.ok {
        defer r.why.free()
        url.free()
        // the reader dropped the stream with its body
        self.piped.release()
        self.piped.release()
        return error(net.NetError.closed, "{r.why}")
    }
    ReplyStream out
    out.status = r.reply.status
    out.names = r.reply.names
    out.values = r.reply.values
    r.reply.body.free()
    r.reply.trailerText.free()
    out.h2 = h
    out.stream = self.stream
    out.piped = self.piped
    out.url = url
    return out
}

// Ends the body and waits for the reply's status and headers; the body
// is read from the ReplyStream.
pub !ReplyStream Upload.finish() {
    if self.h2 != null {
        return try self.finishH2()
    }
    defer self.trailers.free()
    errdefer {
        self.conn.close()
        self.url.free()
    }
    if self.trailers.len > 0 && !self.chunked {
        return error(HttpError.badRequest, "trailers go after a body sent in chunks: begin with length -1")
    }
    if self.chunked {
        scoped String last
        lastChunk(&last, self.trailers)
        try self.conn.write(last)
    } else if self.left > 0 {
        return error(HttpError.badRequest, "{self.left} bytes of the body are missing")
    }
    ReplyStream r
    errdefer {
        r.names.freeEach()
        r.values.freeEach()
    }
    try readReplyHead(&self.conn, &r)
    r.conn = self.conn
    r.client = self.client
    r.url = self.url
    return r
}

!void readReplyHead(net.Conn *c, ReplyStream *r) {
    for {
        scoped String status = try c.readLine()
        _, after, ok := str.cut(status, " ")
        code, _, _ := str.cut(after, " ")
        if !ok || !str.startsWith(status, "HTTP/") {
            return error(HttpError.badReply, "the server didn't answer in HTTP: '{status}'")
        }
        r.status = i32(str.parseInt(code) catch e {
            return error(HttpError.badReply, "the server's status isn't a number: '{status}'")
        })
        r.names.freeEach()
        r.values.freeEach()
        for {
            scoped String h = try c.readLine()
            if h.len == 0 {
                break
            }
            name, value, found := str.cut(h, ":")
            if found {
                r.names.push(str.trim(name).copy())
                r.values.push(str.trim(value).copy())
            }
        }
        // 100 Continue and other 1xx answers come before the real one
        if r.status >= 200 || r.status < 100 {
            break
        }
    }
    keep := !sameName(r.header("Connection"), "close")
    if sameName(r.header("Transfer-Encoding"), "chunked") {
        r.mode = 1
        r.left = 0
        r.reusable = keep
    } else if r.header("Content-Length").len > 0 {
        r.mode = 0
        r.left = str.parseInt(r.header("Content-Length")) catch e {
            return error(HttpError.badReply, "the server's Content-Length isn't a number")
        }
        r.reusable = keep
        r.done = r.left == 0
    } else if r.status == 204 || r.status == 304 {
        r.mode = 0
        r.done = true
        r.reusable = keep
    } else {
        r.mode = 2
    }
}

// Sends a request and gives its reply to read as it comes: the status and
// headers at once, the body with read. body, contentType and headers are
// as send takes them; no gzip is asked for.
pub !ReplyStream Client.stream(str method, str url, str body = "", str contentType = "", str[] headers = []) {
    u := try self.begin(method, url, contentType, headers,
        if body.len > 0 || method == "POST" || method == "PUT" || method == "PATCH" { body.len } else { -1 })
    u.write(body) catch e {
        u.abandon()
        return e
    }
    return try u.finish()
}

// Reads the next part of the body into buf: how many bytes, 0 at its end.
pub !i64 ReplyStream.read(u8[] buf) {
    if self.done || buf.len == 0 {
        return 0
    }
    if self.h2 != null {
        n := try self.piped.read(buf, &self.trailerText)
        if n == 0 {
            self.done = true
        }
        return n
    }
    if self.mode == 1 && self.left == 0 {
        scoped String sizeLine = try self.conn.readLine()
        sizeText, _, _ := str.cut(sizeLine, ";")
        size := try hexNumber(str.trim(sizeText))
        if size == 0 {
            // trailers, up to the empty line
            try readTrailers(&self.conn, &self.trailerText, 8KiB)
            self.finished()
            return 0
        }
        self.left = size
    }
    want := buf.len
    if self.mode != 2 && self.left < want {
        want = self.left
    }
    n := try self.conn.read(buf[0:want])
    if n == 0 {
        if self.mode == 2 {
            self.done = true
            return 0
        }
        return error(net.NetError.closed, "the server closed the connection in the middle of the body")
    }
    if self.mode != 2 {
        self.left -= n
    }
    if self.mode == 1 && self.left == 0 {
        scoped String end = try self.conn.readLine()
    }
    if self.mode == 0 && self.left == 0 {
        self.finished()
    }
    return n
}

// All of the body that is left, up to limit bytes when it isn't 0.
pub !String ReplyStream.readAll(i64 limit = 0) {
    String out
    errdefer out.free()
    u8[16384] buf
    for {
        n := try self.read(buf[:])
        if n == 0 {
            return out
        }
        if limit > 0 && out.len + n > limit {
            return error(HttpError.tooBig, "the body is larger than {limit} bytes")
        }
        out.append(buf[0:n])
    }
    return out
}

void ReplyStream.finished() {
    self.done = true
    if self.reusable && self.client != null {
        d := destOf(self.url) catch e {
            return
        }
        self.client.keep(&d, self.conn)
        self.client = null
        self.reusable = false
        self.given = true
    }
}

// Ends the reply: the connection goes back to the Client when the whole
// body was read, and closes otherwise.
pub void ReplyStream.close() {
    if self.h2 != null {
        if !self.done {
            self.h2.cancel(self.stream)
        }
        self.piped.release()
    } else if !self.given {
        self.conn.close()
    }
    self.names.freeEach()
    self.values.freeEach()
    self.url.free()
    self.trailerText.free()
}

// Opens the stream of an Upload over HTTP/2.
!void H2Conn.beginUpload(Upload *u, str method, Dest *d, str contentType, str[] headers, i64 length,
    bool *retry) {
        *retry = false
        String block
        defer block.free()
        self.requestBlock(&block, method, d, headers, contentType, length, true)
        StreamOut[] mem = alloc(StreamOut, 1)
        sink := &mem[0]
        sink.jobs = self.jobs
        done := chan[H2Result](1)
        piped := newBodyIn(self.jobs, 0)
        id := self.open(block, H2Pending{done: done, piped: piped}, "", sink, u.client.wait(), retry) catch e {
            free(mem)
            piped.release()
            piped.release()
            return e
        }
        piped.stream = id
        u.h2 = self
        u.stream = id
        u.sink = sink
        u.done = done
        u.piped = piped
        u.left = length
    }

// Gives up on an Upload that won't be finished.
void Upload.abandon() {
    self.trailers.free()
    self.url.free()
    if self.h2 == null {
        self.conn.close()
        return
    }
    self.h2.cancel(self.stream)
    if !self.ended {
        // the writer frees the sink
        self.ended = true
        self.h2.jobs.put(Out{job: .end, stream: self.stream, sink: self.sink})
    }
    if !self.replied {
        self.replied = true
        self.piped.release()
    }
}

!ReplyStream Upload.finishH2() {
    try self.end()
    return try self.reply()
}
