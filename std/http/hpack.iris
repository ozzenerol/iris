// The static table (appendix A): entry i + 1.
str[61] STATIC_NAMES = [
    ":authority", ":method", ":method", ":path",
    ":path", ":scheme", ":scheme", ":status",
    ":status", ":status", ":status", ":status",
    ":status", ":status", "accept-charset", "accept-encoding",
    "accept-language", "accept-ranges", "accept", "access-control-allow-origin",
    "age", "allow", "authorization", "cache-control",
    "content-disposition", "content-encoding", "content-language", "content-length",
    "content-location", "content-range", "content-type", "cookie",
    "date", "etag", "expect", "expires",
    "from", "host", "if-match", "if-modified-since",
    "if-none-match", "if-range", "if-unmodified-since", "last-modified",
    "link", "location", "max-forwards", "proxy-authenticate",
    "proxy-authorization", "range", "referer", "refresh",
    "retry-after", "server", "set-cookie", "strict-transport-security",
    "transfer-encoding", "user-agent", "vary", "via",
    "www-authenticate",
]

str[61] STATIC_VALUES = [
    "", "GET", "POST", "/", "/index.html", "http",
    "https", "200", "204", "206", "304", "400",
    "404", "500", "", "gzip, deflate", "", "",
    "", "", "", "", "", "",
    "", "", "", "", "", "",
    "", "", "", "", "", "",
    "", "", "", "", "", "",
    "", "", "", "", "", "",
    "", "", "", "", "", "",
    "", "", "", "", "", "",
    "",
]

// ------------------------------------------------------------ Huffman

// The decoding tree: node i's children are at 2i and 2i + 1, a value
// below 0 is a leaf for byte -(value + 1), 0 is no child yet.
i32[1024] huffTree
bool huffReady
Mutex huffLock

void buildHuff() {
    huffLock.lock()
    defer huffLock.unlock()
    if huffReady {
        return
    }
    i32 next = 1
    for sym in 0..256 {
        code := i64(HUFF_CODES[sym])
        n := i64(HUFF_LENS[sym])
        i32 node = 0
        for b in 0..n {
            bit := code >> (n - 1 - b) & 1
            slot := i64(node) * 2 + bit
            if b == n - 1 {
                huffTree[slot] = i32(-(sym + 1))
            } else {
                if huffTree[slot] == 0 {
                    huffTree[slot] = next
                    next += 1
                }
                node = huffTree[slot]
            }
        }
    }
    huffReady = true
}

// Appends the bytes Huffman-coded in data to out. False when it isn't a
// valid code: a byte that has none, or padding that isn't all ones or is
// longer than 7 bits.
bool huffDecode(str data, String *out) {
    if !huffReady {
        buildHuff()
    }
    i32 node = 0
    i64 depth = 0
    bool ones = true
    for i in 0..data.len {
        byte := i64(data[i])
        for b in 0..8 {
            bit := byte >> (7 - b) & 1
            v := huffTree[i64(node) * 2 + bit]
            depth += 1
            ones = ones && bit == 1
            if v < 0 {
                u8[1] one = [u8(-v - 1)]
                out.append(one[0:1])
                node = 0
                depth = 0
                ones = true
            } else if v == 0 {
                return false
            } else {
                node = v
            }
        }
    }
    return depth < 8 && ones
}

// ------------------------------------------------------------ numbers and strings

// An integer with an n-bit prefix at m[*at] (RFC 7541, 5.1); -1 when it
// is cut short or too large.
i64 readInt(str m, i64 *at, i64 n) {
    if *at >= m.len {
        return -1
    }
    max := (1 << n) - 1
    v := i64(m[*at]) & max
    *at += 1
    if v < max {
        return v
    }
    i64 shift = 0
    for {
        if *at >= m.len || shift > 28 {
            return -1
        }
        b := i64(m[*at])
        *at += 1
        v += (b & 0x7f) << shift
        shift += 7
        if b & 0x80 == 0 {
            return v
        }
    }
}

// Appends an integer with an n-bit prefix; first holds the bits above the
// prefix.
void writeInt(String *out, i64 v, i64 n, i64 first) {
    max := (1 << n) - 1
    if v < max {
        u8[1] b = [u8(first | v)]
        out.append(b[0:1])
        return
    }
    u8[1] b = [u8(first | max)]
    out.append(b[0:1])
    v -= max
    for v >= 128 {
        u8[1] c = [u8(v & 0x7f | 0x80)]
        out.append(c[0:1])
        v >>= 7
    }
    u8[1] last = [u8(v)]
    out.append(last[0:1])
}

// A string literal at m[*at] into out: false when it is broken.
bool readString(str m, i64 *at, String *out) {
    if *at >= m.len {
        return false
    }
    huff := m[*at] & 0x80 != 0
    n := readInt(m, at, 7)
    if n < 0 || *at + n > m.len {
        return false
    }
    data := m[*at:*at + n]
    *at += n
    if huff {
        return huffDecode(data, out)
    }
    out.append(data)
    return true
}

void writeString(String *out, str s) {
    writeInt(out, s.len, 7, 0)
    out.append(s)
}

// ------------------------------------------------------------ decoding

// The headers of one side of a connection: the table its blocks refer to.
struct Decoder {
    List[String] names  // the dynamic table, newest first
    List[String] values
    i64 size
    i64 maxSize         // what the other side may use, from our settings
    i64 tableSize       // what it said it uses
}

Decoder decoder(i64 maxSize) => Decoder{maxSize: maxSize, tableSize: maxSize}

void Decoder.free() {
    self.names.freeEach()
    self.values.freeEach()
}

void Decoder.evict(i64 limit) {
    for self.size > limit && self.names.len > 0 {
        n := self.names.pop()
        v := self.values.pop()
        self.size -= n.len + v.len + 32
        n.free()
        v.free()
    }
}

void Decoder.add(str name, str value) {
    entry := name.len + value.len + 32
    if entry > self.tableSize {
        self.evict(0)
        return
    }
    self.evict(self.tableSize - entry)
    self.names.insert(0, name.copy())
    self.values.insert(0, value.copy())
    self.size += entry
}

// Entry i of the static and the dynamic table, from 1; false past them.
(str, str, bool) Decoder.entry(i64 i) {
    if i >= 1 && i <= 61 {
        return (STATIC_NAMES[i - 1], STATIC_VALUES[i - 1], true)
    }
    d := i - 62
    if d >= 0 && d < self.names.len {
        return (self.names.at(d), self.values.at(d), true)
    }
    return ("", "", false)
}

// Decodes a header block into names and values. False when it is broken,
// which ends the connection (a COMPRESSION_ERROR). limit caps the size of
// the headers, as SETTINGS_MAX_HEADER_LIST_SIZE does.
bool Decoder.decode(str block, List[String] *names, List[String] *values, i64 limit) {
    i64 at = 0
    i64 total = 0
    bool first = true
    for at < block.len {
        b := i64(block[at])
        if b & 0x80 != 0 {
            i := readInt(block, &at, 7)
            name, value, ok := self.entry(i)
            if !ok || i == 0 {
                return false
            }
            names.push(name.copy())
            values.push(value.copy())
            total += name.len + value.len + 32
        } else if b & 0xe0 == 0x20 {
            // a new size for the table: only at the start of a block
            n := readInt(block, &at, 5)
            if n < 0 || n > self.maxSize || !first {
                return false
            }
            self.tableSize = n
            self.evict(n)
            continue
        } else {
            indexing := b & 0xc0 == 0x40
            i := readInt(block, &at, if indexing { 6 } else { 4 })
            if i < 0 {
                return false
            }
            String name
            if i == 0 {
                if !readString(block, &at, &name) {
                    name.free()
                    return false
                }
            } else {
                known, _, ok := self.entry(i)
                if !ok {
                    return false
                }
                name.append(known)
            }
            String value
            if !readString(block, &at, &value) {
                name.free()
                value.free()
                return false
            }
            if indexing {
                self.add(name, value)
            }
            total += name.len + value.len + 32
            names.push(name)
            values.push(value)
        }
        first = false
        if limit > 0 && total > limit {
            return false
        }
    }
    return true
}

// ------------------------------------------------------------ encoding

// Appends one header: an entry of the static table when there is one, or
// a literal that isn't added to the other side's table.
void encodeHeader(String *out, str name, str value) {
    i64 byName = 0
    for i in 0..61 {
        if STATIC_NAMES[i] == name {
            if STATIC_VALUES[i] == value {
                writeInt(out, i + 1, 7, 0x80)
                return
            }
            if byName == 0 {
                byName = i + 1
            }
        }
    }
    writeInt(out, byName, 4, 0)
    if byName == 0 {
        writeString(out, name)
    }
    writeString(out, value)
}

// ------------------------------------------------------------ RFC 7541, appendix C

String unhex(str h) {
    String out
    i := 0
    for i + 1 < h.len {
        if h[i] == ' ' {
            i += 1
            continue
        }
        hi := if h[i] <= '9' { i64(h[i] - '0') } else { i64(h[i] - 'a') + 10 }
        lo := if h[i + 1] <= '9' { i64(h[i + 1] - '0') } else { i64(h[i + 1] - 'a') + 10 }
        u8[1] b = [u8(hi << 4 | lo)]
        out.append(b[0:1])
        i += 2
    }
    return out
}

// Decodes block and checks the headers and the table's size: what is
// wrong, or "".
String check(Decoder *d, str hex, str[] want, i64 size) {
    scoped String block = unhex(hex)
    List[String] names
    List[String] values
    defer names.freeEach()
    defer values.freeEach()
    if !d.decode(block, &names, &values, 0) {
        return format("{hex}: doesn't decode")
    }
    if names.len * 2 != want.len {
        return format("{hex}: {names.len} headers, want {want.len / 2}")
    }
    for i in 0..names.len {
        if names.at(i) != want[i * 2] || values.at(i) != want[i * 2 + 1] {
            return format("header {i} is {names.at(i)}: {values.at(i)}")
        }
    }
    if d.size != size {
        return format("the table holds {d.size} bytes, want {size}")
    }
    return format("")
}

test "integers (C.1)" {
    String out
    defer out.free()
    writeInt(&out, 10, 5, 0)
    writeInt(&out, 1337, 5, 0)
    writeInt(&out, 42, 8, 0)
    i64 at = 0
    expect(readInt(out, &at, 5) == 10 && readInt(out, &at, 5) == 1337 && readInt(out, &at, 8) == 42)
    expect(out.len == 5 && out[1] == 31 && out[2] == 154 && out[3] == 10)
}

test "requests without Huffman (C.3)" {
    scoped d := decoder(4096)
    scoped String p1 = check(&d, "828684410f7777772e6578616d706c652e636f6d",
          [":method", "GET", ":scheme", "http", ":path", "/", ":authority", "www.example.com"], 57)
    expect(p1.len == 0, p1)
    scoped String p2 = check(&d, "828684be58086e6f2d6361636865",
          [":method", "GET", ":scheme", "http", ":path", "/", ":authority", "www.example.com",
           "cache-control", "no-cache"], 110)
    expect(p2.len == 0, p2)
    scoped String p3 = check(&d, "828785bf400a637573746f6d2d6b65790c637573746f6d2d76616c7565",
          [":method", "GET", ":scheme", "https", ":path", "/index.html", ":authority", "www.example.com",
           "custom-key", "custom-value"], 164)
    expect(p3.len == 0, p3)
}

test "requests with Huffman (C.4)" {
    scoped d := decoder(4096)
    scoped String p4 = check(&d, "828684418cf1e3c2e5f23a6ba0ab90f4ff",
          [":method", "GET", ":scheme", "http", ":path", "/", ":authority", "www.example.com"], 57)
    expect(p4.len == 0, p4)
    scoped String p5 = check(&d, "828684be5886a8eb10649cbf",
          [":method", "GET", ":scheme", "http", ":path", "/", ":authority", "www.example.com",
           "cache-control", "no-cache"], 110)
    expect(p5.len == 0, p5)
    scoped String p6 = check(&d, "828785bf408825a849e95ba97d7f8925a849e95bb8e8b4bf",
          [":method", "GET", ":scheme", "https", ":path", "/index.html", ":authority", "www.example.com",
           "custom-key", "custom-value"], 164)
    expect(p6.len == 0, p6)
}

test "responses with eviction (C.6)" {
    scoped d := decoder(256)
    scoped String p7 = check(&d, "488264025885aec3771a4b6196d07abe941054d444a8200595040b8166e082a62d1bff6e919d29ad171863c78f0b97c8e9ae82ae43d3",
          [":status", "302", "cache-control", "private", "date", "Mon, 21 Oct 2013 20:13:21 GMT",
           "location", "https://www.example.com"], 222)
    expect(p7.len == 0, p7)
    scoped String p8 = check(&d, "4883640effc1c0bf",
          [":status", "307", "cache-control", "private", "date", "Mon, 21 Oct 2013 20:13:21 GMT",
           "location", "https://www.example.com"], 222)
    expect(p8.len == 0, p8)
    scoped String p9 = check(&d, "88c16196d07abe941054d444a8200595040b8166e084a62d1bffc05a839bd9ab77ad94e7821dd7f2e6c7b335dfdfcd5b3960d5af27087f3672c1ab270fb5291f9587316065c003ed4ee5b1063d5007",
          [":status", "200", "cache-control", "private", "date", "Mon, 21 Oct 2013 20:13:22 GMT",
           "location", "https://www.example.com", "content-encoding", "gzip",
           "set-cookie", "foo=ASDJKHQKBZXOQWEOPIUAXQWEOIU; max-age=3600; version=1"], 215)
    expect(p9.len == 0, p9)
}

test "the encoder's blocks decode" {
    String block
    defer block.free()
    encodeHeader(&block, ":status", "200")
    encodeHeader(&block, "content-type", "text/plain")
    encodeHeader(&block, "x-trace", "abc")
    scoped d := decoder(4096)
    scoped String p10 = check(&d, "", [], 0)
    expect(p10.len == 0, p10)
    List[String] names
    List[String] values
    defer names.freeEach()
    defer values.freeEach()
    expect(d.decode(block, &names, &values, 0))
    expect(names.len == 3 && values.at(0) == "200" && names.at(1) == "content-type" && values.at(2) == "abc")
    expect(block[0] == 0x88, "200 is entry 8 of the static table")
}

test "broken blocks" {
    scoped d := decoder(4096)
    List[String] names
    List[String] values
    defer names.freeEach()
    defer values.freeEach()
    scoped String badIndex = unhex("ff00")
    expect(!d.decode(badIndex, &names, &values, 0), "an index past the tables")
    scoped String cut = unhex("418cf1e3")
    expect(!d.decode(cut, &names, &values, 0), "a string longer than the block")
    scoped String eos = unhex("4183ffffff")
    expect(!d.decode(eos, &names, &values, 0), "padding longer than 7 bits")
}
