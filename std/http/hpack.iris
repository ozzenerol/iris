// HPACK (RFC 7541): how HTTP/2 writes headers. The decoder keeps the
// table the other side builds up; the encoder writes each header on its
// own or as an entry of the static table, so it needs no table.

// The Huffman code of each byte, and its length in bits (RFC 7541,
// appendix B).
u32[256] HUFF_CODES = [
