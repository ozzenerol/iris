// HTTP/2 for the Client: many requests at once on one connection to a
// host. The connection's reader task gets the replies and hands each to the
// request that waits for it; its writer task, the server's, is the only
// one that writes, so a TLS connection is used from its own thread only.

import net, str, time

// What a request gets back.
struct H2Result {
    Reply reply
    bool ok
    bool retry // the server didn't take the request: it can go again
    String why
}

// A reply on its way.
struct H2Pending {
    chan[H2Result] done
    Reply reply
    bool started
    // a reply read as it comes: done gets its head, and the body goes here
    BodyIn *piped
}

struct H2Conn {
    net.Conn conn
    String authority
    bool secure
    Mutex lock // the streams, the next id and dead
    Map[i64, H2Pending] streams
    i64 nextId
    i64 maxStreams
    bool dead
    i64 lastGood // GOAWAY: the last stream the server will answer
    Queue queue
    Queue *jobs
    Writer writer
    i64 inFlight
    chan[bool] writerDone
    chan[bool] readerDone
}

void H2Conn.deliver(i64 stream, H2Result r) {
    self.lock.lock()
    p, found := self.streams.get(stream)
    if found {
        _ = self.streams.remove(stream)
    }
    self.lock.unlock()
    if !found {
        r.reply.free()
        r.why.free()
        return
    }
    p.done <- r
}

// A streamed reply's DATA, or its trailers when data is false, goes to
// the one reading it; end ends it. Under the lock, so close can't free the
// body meanwhile.
void H2Conn.pipe(i64 stream, str bytes, bool data, bool end) {
    self.lock.lock()
    defer self.lock.unlock()
    pend, found := self.streams.get(stream)
    if !found || pend.piped == null {
        return
    }
    if data {
        pend.piped.add(bytes)
    }
    if end {
        pend.piped.end("" if data else bytes)
        _ = self.streams.remove(stream)
        pend.piped.release()
        return
    }
    self.streams.set(stream, pend)
}

// Fails a streamed reply whose head went already. True when it was one.
bool H2Conn.failPiped(i64 stream) {
    self.lock.lock()
    defer self.lock.unlock()
    pend, found := self.streams.get(stream)
    if !found || pend.piped == null || !pend.started {
        return false
    }
    _ = self.streams.remove(stream)
    pend.reply.free()
    pend.piped.fail()
    pend.piped.release()
    return true
}

// Fails every request still waiting.
void H2Conn.failAll(str why) {
    self.lock.lock()
    self.dead = true
    scoped List[i64] streamed
    for id, pend in self.streams {
        if pend.piped != null && pend.started {
            streamed.push(id)
        }
    }
    self.lock.unlock()
    for id in streamed {
        _ = self.failPiped(id)
    }
    self.lock.lock()
    scoped List[i64] ids = self.streams.keys()
    self.lock.unlock()
    for id in ids {
        self.lock.lock()
        p, _ := self.streams.get(id)
        self.lock.unlock()
        self.deliver(id, H2Result{retry: !p.started, why: why.copy()})
    }
}

void h2Reader(H2Conn *h) {
    Decoder dec = decoder(4096)
    defer dec.free()
    for {
        f := readFrame(&h.conn, 16384) catch e {
            break
        }
        defer f.free()
        str p = f.payload
        scoped String trailers
        if f.kind == F_HEADERS || f.kind == F_DATA {
            h.lock.lock()
            pend, found := h.streams.get(f.stream)
            h.lock.unlock()
            if f.kind == F_DATA && p.len > 0 {
                h.jobs.put(Out{job: .frame, data: windowFrame(0, p.len)})
                // a body read as it comes gets its window back as it is read
                if found && f.flags & END_STREAM == 0 && pend.piped == null {
                    h.jobs.put(Out{job: .frame, data: windowFrame(f.stream, p.len)})
                }
            }
            i64 pad = 0
            i64 at = 0
            if f.flags & PADDED != 0 && p.len > 0 {
                pad = i64(p[0])
                at = 1
            }
            if f.kind == F_HEADERS && f.flags & PRIORITY_FLAG != 0 {
                at += 5
            }
            if at + pad > p.len {
                break
            }
            if f.kind == F_HEADERS {
                String block
                block.append(p[at:p.len - pad])
                flags := f.flags
                bool broken = false
                for flags & END_HEADERS == 0 {
                    more := readFrame(&h.conn, 16384) catch e {
                        broken = true
                        break
                    }
                    if more.kind != F_CONTINUATION || more.stream != f.stream {
                        more.free()
                        broken = true
                        break
                    }
                    block.append(more.payload)
                    flags = more.flags
                    more.free()
                }
                List[String] names
                List[String] values
                ok := !broken && dec.decode(block, &names, &values, 0)
                block.free()
                if !ok {
                    names.freeEach()
                    values.freeEach()
                    break
                }
                if !found {
                    names.freeEach()
                    values.freeEach()
                    continue
                }
                if !pend.started {
                    for i in 0..names.len {
                        if names.at(i) == ":status" {
                            pend.reply.status = i32(str.parseInt(values.at(i)) catch 0)
                        }
                    }
                    if pend.reply.status >= 100 && pend.reply.status < 200 {
                        // 100 Continue and the like: the real reply comes after
                        pend.reply.status = 0
                        names.freeEach()
                        values.freeEach()
                        continue
                    }
                    pend.started = true
                    pend.reply.protocol = "HTTP/2"
                    for i in 0..names.len {
                        if names.at(i)[0] == ':' {
                            continue
                        }
                        pend.reply.names.push(names.at(i).copy())
                        pend.reply.values.push(values.at(i).copy())
                    }
                    if pend.piped != null {
                        // the head goes now, the body as it comes
                        Reply head = pend.reply
                        pend.reply = Reply{}
                        h.lock.lock()
                        h.streams.set(f.stream, pend)
                        h.lock.unlock()
                        pend.done <- H2Result{reply: head, ok: true}
                    }
                } else {
                    // a block after the body's: the trailers
                    String *into = &pend.reply.trailerText
                    if pend.piped != null {
                        into = &trailers
                    }
                    for i in 0..names.len {
                        if names.at(i).len > 0 && names.at(i)[0] != ':' {
                            into.append(names.at(i))
                            into.append(": ")
                            into.append(values.at(i))
                            into.append("\n")
                        }
                    }
                }
                names.freeEach()
                values.freeEach()
            } else if found && pend.piped == null {
                pend.reply.body.append(p[at:p.len - pad])
            }
            if !found {
                continue
            }
            if pend.piped != null && pend.started {
                str data = p[at:p.len - pad] if f.kind == F_DATA else trailers
                h.pipe(f.stream, data, f.kind == F_DATA, f.flags & END_STREAM != 0)
                continue
            }
            if f.flags & END_STREAM != 0 {
                h.deliver(f.stream, H2Result{reply: pend.reply, ok: true})
            } else {
                h.lock.lock()
                h.streams.set(f.stream, pend)
                h.lock.unlock()
            }
        } else if f.kind == F_RST && p.len == 4 {
            code := get32(p, 0)
            // an upload still being written stops; nothing is sent back
            h.jobs.put(Out{job: .reset, stream: f.stream, n: 1})
            if h.failPiped(f.stream) {
                continue
            }
            h.deliver(f.stream, H2Result{retry: code == E_REFUSED, why: format("the server reset the request (error {code})")})
        } else if f.kind == F_SETTINGS && f.flags & ACK == 0 && p.len % 6 == 0 {
            for i in 0..p.len / 6 {
                id := i64(p[i * 6]) << 8 | i64(p[i * 6 + 1])
                v := get32(p, i * 6 + 2)
                if id == 3 {
                    h.lock.lock()
                    h.maxStreams = v
                    h.lock.unlock()
                } else if id == 4 || id == 5 {
                    h.jobs.put(Out{job: .settings, n: id, n2: v})
                }
            }
            h.jobs.put(Out{job: .frame, data: frameOf(F_SETTINGS, ACK, 0, "")})
        } else if f.kind == F_PING && f.flags & ACK == 0 && p.len == 8 {
            h.jobs.put(Out{job: .frame, data: frameOf(F_PING, ACK, 0, p)})
        } else if f.kind == F_WINDOW && p.len == 4 {
            h.jobs.put(Out{job: .window, stream: f.stream, n: get32(p, 0) & 0x7fffffff})
        } else if f.kind == F_GOAWAY && p.len >= 8 {
            // requests after the last one it names never reached it
            last := get32(p, 0) & 0x7fffffff
            h.lock.lock()
            h.dead = true
            h.lastGood = last
            scoped List[i64] ids = h.streams.keys()
            h.lock.unlock()
            for id in ids {
                if id > last {
                    h.deliver(id, H2Result{retry: true, why: format("the server is going away")})
                }
            }
        }
    }
    h.failAll("the connection closed")
    // request bodies still being sent have nowhere to go
    h.jobs.put(Out{job: .close, n: 1})
    _ = <-h.writerDone
    h.readerDone <- true
}

// Starts HTTP/2 on a connection: the preface and our settings.
H2Conn *startH2(net.Conn c, Dest *d) {
    H2Conn[] mem = alloc(H2Conn, 1)
    H2Conn *h = &mem[0]
    h.conn = c
    h.authority = d.hostPort.copy()
    h.secure = d.secure
    h.nextId = 1
    h.maxStreams = 100
    h.queue.ch = chan[Out](64)
    h.jobs = &h.queue
    h.writerDone = chan[bool](1)
    h.readerDone = chan[bool](1)
    h.writer = Writer{conn: &h.conn, jobs: h.jobs, inFlight: &h.inFlight, window: 65535, initial: 65535,
        maxFrame: 16384}
    // no time limit on reads: the reader waits for replies as long as the
    // connection is open; each request has its own limit
    h.conn.setTimeout(0s)
    String start = PREFACE.copy()
    String settings
    put8(&settings, 0)
    put8(&settings, 2)
    put32(&settings, 0) // no server push
    put8(&settings, 0)
    put8(&settings, 4)
    put32(&settings, RECV_WINDOW)
    putFrame(&start, F_SETTINGS, 0, 0, settings)
    settings.free()
    scoped String grow = windowFrame(0, RECV_WINDOW - 65535)
    start.append(grow)
    spawn runWriter(&h.writer, h.writerDone)
    h.jobs.put(Out{job: .frame, data: start})
    spawn h2Reader(h)
    return h
}

// Sends a request on the connection and waits for its reply.
// A request's header block. length is the body's size, -1 when it has
// no content-length.
void H2Conn.requestBlock(String *block, str method, Dest *d, str[] headers, str contentType, i64 length, bool raw) {
    encodeHeader(block, ":method", method)
    encodeHeader(block, ":scheme", if self.secure { "https" } else { "http" })
    authority := self.authority[:]
    for line in headers {
        name, value, _ := str.cut(line, ":")
        if sameName(str.trim(name), "host") {
            authority = str.trim(value)
        }
    }
    encodeHeader(block, ":authority", authority)
    encodeHeader(block, ":path", d.path)
    if !hasHeader(headers, "user-agent") {
        encodeHeader(block, "user-agent", "iris")
    }
    if !raw && !hasHeader(headers, "accept-encoding") {
        encodeHeader(block, "accept-encoding", "gzip")
    }
    for line in headers {
        name, value, _ := str.cut(line, ":")
        scoped String lower = str.lower(str.trim(name))
        // HTTP/2 has no connection headers, and :authority stands for Host
        if lower == "connection" || lower == "keep-alive" || lower == "transfer-encoding" || lower == "upgrade" ||
            lower == "host" {
                continue
            }
        encodeHeader(block, lower, str.trim(value))
    }
    if contentType.len > 0 {
        encodeHeader(block, "content-type", contentType)
    }
    if length >= 0 {
        scoped String text = format("{length}")
        encodeHeader(block, "content-length", text)
    }
}

// Opens a stream: its headers go, then body, or with sink a body written
// as it goes. The reply comes on pend.done. Gives the stream's id.
!i64 H2Conn.open(str block, H2Pending pend, str body, StreamOut *sink, Duration timeout, bool *retry) {
    start := time.clock()
    for {
        self.lock.lock()
        if self.dead {
            self.lock.unlock()
            *retry = true
            return error(net.NetError.closed, "the connection is closing")
        }
        if self.streams.len < self.maxStreams {
            id := self.nextId
            self.nextId += 2
            self.streams.set(id, pend)
            String frames
            i64 at = 0
            for {
                n := if block.len - at > 16384 { 16384 } else { block.len - at }
                last := at + n == block.len
                i64 flags = if last { END_HEADERS } else { 0 }
                if at == 0 && body.len == 0 && sink == null {
                    flags |= END_STREAM
                }
                putFrame(&frames, if at == 0 { F_HEADERS } else { F_CONTINUATION }, flags, id, block[at:at + n])
                at += n
                if last {
                    break
                }
            }
            // in the writer's order, which is the order of the ids
            self.jobs.put(Out{job: .frame, data: frames})
            if body.len > 0 {
                self.jobs.put(Out{job: .body, stream: id, data: body.copy()})
            }
            if sink != null {
                sink.stream = id
                self.jobs.put(Out{job: .upload, stream: id, sink: sink})
            }
            self.lock.unlock()
            return id
        }
        self.lock.unlock()
        // as many requests as the server allows are open: wait for one
        if timeout > 0s && time.clock() - start > timeout {
            return error(net.NetError.timeout, "no stream became free")
        }
        sleep(1ms)
    }
    return 0
}

// Stops a stream the reply of which is no longer wanted: it is reset, and
// a body read as it comes no longer gets anything.
void H2Conn.cancel(i64 stream) {
    self.lock.lock()
    pend, found := self.streams.get(stream)
    if found {
        _ = self.streams.remove(stream)
        pend.reply.free()
        if pend.piped != null {
            pend.piped.release()
        }
    }
    self.lock.unlock()
    self.jobs.put(Out{job: .reset, stream: stream, n: 1})
    if found {
        self.jobs.put(Out{job: .frame, data: rstFrame(stream, E_CANCEL)})
    }
}

// Waits for a reply on done, up to timeout when it isn't 0s.
!H2Result H2Conn.wait(i64 id, chan[H2Result] done, Duration timeout) {
    if timeout <= 0s {
        return <-done
    }
    H2Result r
    bool timedOut = false
    select {
        got := <-done => r = got,
        after(timeout) => timedOut = true,
    }
    if !timedOut {
        return r
    }
    self.lock.lock()
    pend, found := self.streams.get(id)
    self.lock.unlock()
    if found && pend.started && pend.piped != null {
        // the head came meanwhile
        return <-done
    }
    if !found {
        // the reply came meanwhile
        return <-done
    }
    self.cancel(id)
    return error(net.NetError.timeout, "no reply in {timeout}")
}

!Reply H2Conn.request(str method, Dest *d, str body, str contentType, Duration timeout, bool *retry,
    str[] headers = [], bool raw = false) {
        *retry = false
        start := time.clock()
        String block
        defer block.free()
        i64 length = if body.len > 0 || method == "POST" || method == "PUT" || method == "PATCH" { body.len } else { -1 }
        self.requestBlock(&block, method, d, headers, contentType, length, raw)
        done := chan[H2Result](1)
        id := try self.open(block, H2Pending{done: done}, body, null, timeout, retry)
        Duration left = if timeout > 0s { timeout - (time.clock() - start) } else { 0s }
        if timeout > 0s && left <= 0s {
            left = 1ns
        }
        r := try self.wait(id, done, left)
        if !r.ok {
            *retry = r.retry
            defer r.why.free()
            return error(net.NetError.closed, "{r.why}")
        }
        if raw {
            return r.reply
        }
        r.reply.decode() catch e {
            r.reply.free()
            return e
        }
        return r.reply
    }

// Ends the connection, after the requests that wait for replies fail.
void H2Conn.close() {
    self.lock.lock()
    self.dead = true
    self.lock.unlock()
    self.conn.interrupt()
    _ = <-self.readerDone
    self.conn.close()
    self.streams.free()
    self.authority.free()
    free(self[0:1])
}
