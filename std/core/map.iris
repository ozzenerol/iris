// A map from keys to values. Keys can be integers, bool, enums, pointers,
// str or String; a str or String key is copied, so the map keeps its own.
// A new Map is empty; free gives its memory back.
pub struct Map[K, V] {
    Entry[K, V][] slots
    u8[] state // 0 empty, 1 removed, 0x80 | 7 bits of the key's hash: used
    pub i64 len
    i64 removed
}

// A key and its value side by side, so a lookup that finds the key has the
// value at hand. The states are an array of their own: small, so it stays in
// the cache, and most slots that don't match are passed over there.
struct Entry[K, V] {
    K key
    V val
}

@builtin
u64 hashOf()

@builtin
void keyOwn()

@builtin
void keyFree()

// The state of a used slot for a key with hash h: the top 7 bits of h tell
// most keys apart without reading the key itself.
u8 tagOf(u64 h) => u8(h >> 57) | 0x80

// The slot of k, or of the place it would go: (slot, found, state).
(i64, bool, u8) Map[K, V].slot(K k) {
    mask := self.state.len - 1
    h := hashOf(k)
    tag := tagOf(h)
    i := i64(h & u64(mask))
    i64 firstRemoved = -1
    for {
        s := self.state[i]
        if s == 0 {
            return (if firstRemoved >= 0 { firstRemoved } else { i }, false, tag)
        }
        if s == tag {
            if self.slots[i].key == k {
                return (i, true, tag)
            }
        } else if s == 1 && firstRemoved < 0 {
            firstRemoved = i
        }
        i = (i + 1) & mask
    }
}

void Map[K, V].grow() {
    old := self.slots
    oldState := self.state
    size := if old.len == 0 { 8 } else if self.len * 2 >= old.len { old.len * 2 } else { old.len }
    self.slots = alloc(Entry[K, V], size)
    self.state = alloc(u8, size)
    self.removed = 0
    for i in 0..old.len {
        if oldState[i] >= 0x80 {
            at, _, tag := self.slot(old[i].key)
            self.slots[at] = old[i]
            self.state[at] = tag
        }
    }
    free(old)
    free(oldState)
}

// Sets the value of k, adding k if it isn't there.
pub void Map[K, V].set(K k, V v) {
    if (self.len + self.removed + 1) * 4 > self.state.len * 3 {
        self.grow()
    }
    at, found, tag := self.slot(k)
    if !found {
        if self.state[at] == 1 {
            self.removed -= 1
        }
        self.slots[at].key = keyOwn(k)
        self.state[at] = tag
        self.len += 1
    }
    self.slots[at].val = v
}

// The value of k, and whether k is there.
pub (V, bool) Map[K, V].get(K k) {
    if self.len == 0 {
        V none
        return (none, false)
    }
    at, found, _ := self.slot(k)
    if !found {
        V none
        return (none, false)
    }
    return (self.slots[at].val, true)
}

// The value of k, or fallback when k isn't there.
pub V Map[K, V].getOr(K k, V fallback) {
    v, found := self.get(k)
    return if found { v } else { fallback }
}

// Whether k is there.
pub bool Map[K, V].has(K k) {
    _, found := self.get(k)
    return found
}

// Takes k out; false when it wasn't there.
pub bool Map[K, V].remove(K k) {
    if self.len == 0 {
        return false
    }
    at, found, _ := self.slot(k)
    if !found {
        return false
    }
    keyFree(self.slots[at].key)
    self.state[at] = 1
    self.len -= 1
    self.removed += 1
    return true
}

// Takes every key out and keeps the memory.
pub void Map[K, V].clear() {
    for i in 0..self.state.len {
        if self.state[i] >= 0x80 {
            keyFree(self.slots[i].key)
        }
        self.state[i] = 0
    }
    self.len = 0
    self.removed = 0
}

// Gives the map's memory back; the map is empty after.
pub void Map[K, V].free() {
    self.clear()
    free(self.slots)
    free(self.state)
    self.slots = alloc(Entry[K, V], 0)
    self.state = alloc(u8, 0)
}

// The keys, in no particular order. A str or String key is the map's own
// copy, valid until the key is removed; free only the list.
pub List[K] Map[K, V].keys() {
    List[K] out
    out.reserve(self.len)
    for i in 0..self.state.len {
        if self.state[i] >= 0x80 {
            out.push(self.slots[i].key)
        }
    }
    return out
}

// for k, v in map, in no particular order
pub (K, V, bool) Map[K, V].next(i64 *at) {
    for *at < self.state.len {
        i := *at
        *at += 1
        if self.state[i] >= 0x80 {
            return (self.slots[i].key, self.slots[i].val, true)
        }
    }
    K noKey
    V noValue
    return (noKey, noValue, false)
}
