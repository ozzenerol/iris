// A map from keys to values. Keys can be integers, bool, enums, pointers
// or str; a str key is copied, so the map keeps its own. A new Map is
// empty; free gives its memory back.
pub struct Map[K, V] {
    K[] keys
    V[] vals
    u8[] state // 0 empty, 1 used, 2 removed
    pub i64 len
    i64 removed
}

@builtin
u64 hashOf()

@builtin
void keyOwn()

@builtin
void keyFree()

// The slot of k, or of the place it would go: (slot, found).
(i64, bool) Map[K, V].slot(K k) {
    mask := self.state.len - 1
    i := i64(hashOf(k) & u64(mask))
    i64 firstRemoved = -1
    for {
        s := self.state[i]
        if s == 0 {
            return (if firstRemoved >= 0 { firstRemoved } else { i }, false)
        }
        if s == 2 {
            if firstRemoved < 0 {
                firstRemoved = i
            }
        } else if self.keys[i] == k {
            return (i, true)
        }
        i = (i + 1) & mask
    }
}

void Map[K, V].grow() {
    oldKeys := self.keys
    oldVals := self.vals
    oldState := self.state
    size := if oldState.len == 0 { 8 } else if self.len * 2 >= oldState.len { oldState.len * 2 } else { oldState.len }
    self.keys = alloc(K, size)
    self.vals = alloc(V, size)
    self.state = alloc(u8, size)
    self.removed = 0
    for i in 0..oldState.len {
        if oldState[i] == 1 {
            at, _ := self.slot(oldKeys[i])
            self.keys[at] = oldKeys[i]
            self.vals[at] = oldVals[i]
            self.state[at] = 1
        }
    }
    free(oldKeys)
    free(oldVals)
    free(oldState)
}

// Sets the value of k, adding k if it isn't there.
pub void Map[K, V].set(K k, V v) {
    if (self.len + self.removed + 1) * 4 > self.state.len * 3 {
        self.grow()
    }
    at, found := self.slot(k)
    if !found {
        if self.state[at] == 2 {
            self.removed -= 1
        }
        self.keys[at] = keyOwn(k)
        self.state[at] = 1
        self.len += 1
    }
    self.vals[at] = v
}

// The value of k, and whether k is there.
pub (V, bool) Map[K, V].get(K k) {
    if self.len == 0 {
        V none
        return (none, false)
    }
    at, found := self.slot(k)
    if !found {
        V none
        return (none, false)
    }
    return (self.vals[at], true)
}

// The value of k, or fallback when k isn't there.
pub V Map[K, V].getOr(K k, V fallback) {
    v, found := self.get(k)
    return if found { v } else { fallback }
}

// Whether k is there.
pub bool Map[K, V].has(K k) {
    _, found := self.get(k)
    return found
}

// Takes k out; false when it wasn't there.
pub bool Map[K, V].remove(K k) {
    if self.len == 0 {
        return false
    }
    at, found := self.slot(k)
    if !found {
        return false
    }
    keyFree(self.keys[at])
    self.state[at] = 2
    self.len -= 1
    self.removed += 1
    return true
}

// Takes every key out and keeps the memory.
pub void Map[K, V].clear() {
    for i in 0..self.state.len {
        if self.state[i] == 1 {
            keyFree(self.keys[i])
        }
        self.state[i] = 0
    }
    self.len = 0
    self.removed = 0
}

// Gives the map's memory back; the map is empty after.
pub void Map[K, V].free() {
    self.clear()
    free(self.keys)
    free(self.vals)
    free(self.state)
    self.keys = alloc(K, 0)
    self.vals = alloc(V, 0)
    self.state = alloc(u8, 0)
}

// The keys, in no particular order. A str key points into the map's own
// copy, valid until the key is removed.
pub List[K] Map[K, V].keys() {
    List[K] out
    out.reserve(self.len)
    for i in 0..self.state.len {
        if self.state[i] == 1 {
            out.push(self.keys[i])
        }
    }
    return out
}

// for k, v in map, in no particular order
pub (K, V, bool) Map[K, V].next(i64 *at) {
    for *at < self.state.len {
        i := *at
        *at += 1
        if self.state[i] == 1 {
            return (self.keys[i], self.vals[i], true)
        }
    }
    K noKey
    V noValue
    return (noKey, noValue, false)
}
