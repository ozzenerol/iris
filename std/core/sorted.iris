// A map that keeps its keys in order, from less, given when the map is
// made: SortedMap[str, i64]{less: before}. less(a, b) says whether a goes
// before b; two keys where neither goes first are the same key. Loops go
// over the keys in order, and range gives the keys between two keys. Keys
// can be what a Map takes; a str or String key is copied, so the map keeps
// its own. A new SortedMap is empty; free gives its memory back.
pub struct SortedMap[K, V] {
    pub bool(K, K) less
    // A skip list. Node 0 is the head; links holds each node's next node at
    // each of its levels, 0 for none. A removed node waits in spare, by level.
    List[SortedNode[K, V]] nodes
    List[i64] links
    i64[25] spare
    i64 levels
    u64 seed
    pub i64 len
}

struct SortedNode[K, V] {
    K key
    V val
    i64 at // where its links start
    i64 levels
}

const SORTED_LEVELS = 24

// The node after n at level l.
i64 SortedMap[K, V].link(i64 n, i64 l) => self.links.buf[self.nodes.buf[n].at + l]

void SortedMap[K, V].setLink(i64 n, i64 l, i64 to) {
    self.links.buf[self.nodes.buf[n].at + l] = to
}

void SortedMap[K, V].start() {
    if self.less == null {
        panic("a SortedMap needs a less function: SortedMap[K, V]{{less: f}}")
    }
    if self.nodes.len > 0 {
        return
    }
    SortedNode[K, V] head
    head.levels = SORTED_LEVELS
    self.nodes.push(head)
    for i in 0..SORTED_LEVELS {
        self.links.push(0)
    }
    self.levels = 1
    if self.seed == 0 {
        self.seed = 0x9e3779b97f4a7c15
    }
}

// How many levels a new node has: one more with each chance of 1 in 4.
i64 SortedMap[K, V].newLevels() {
    x := self.seed
    x ^= x << 13
    x ^= x >> 7
    x ^= x << 17
    self.seed = x
    n := 1
    for n < SORTED_LEVELS && (x & 3) == 0 {
        n += 1
        x >>= 2
    }
    return n
}

// The last node at each level whose key goes before k, in before, and the
// node after it at level 0: the node with k, if k is there.
i64 SortedMap[K, V].seek(K k, i64[] before) {
    x := 0
    l := self.levels - 1
    for l >= 0 {
        for {
            n := self.link(x, l)
            break if n == 0 || !self.less(self.nodes.buf[n].key, k)
            x = n
        }
        before[l] = x
        l -= 1
    }
    return self.link(x, 0)
}

// The node with k, or 0.
i64 SortedMap[K, V].find(K k) {
    if self.len == 0 {
        return 0
    }
    i64[24] before
    n := self.seek(k, before[:])
    if n != 0 && !self.less(k, self.nodes.buf[n].key) {
        return n
    }
    return 0
}

// Sets the value of k, adding k if it isn't there.
pub void SortedMap[K, V].set(K k, V v) {
    self.start()
    i64[24] before
    n := self.seek(k, before[:])
    if n != 0 && !self.less(k, self.nodes.buf[n].key) {
        self.nodes.buf[n].val = v
        return
    }
    levels := self.newLevels()
    for self.levels < levels {
        before[self.levels] = 0
        self.levels += 1
    }
    node := self.spare[levels]
    if node != 0 {
        self.spare[levels] = self.link(node, 0)
    } else {
        node = self.nodes.len
        SortedNode[K, V] fresh
        fresh.at = self.links.len
        fresh.levels = levels
        self.nodes.push(fresh)
        for i in 0..levels {
            self.links.push(0)
        }
    }
    self.nodes.buf[node].key = keyOwn(k)
    self.nodes.buf[node].val = v
    for l in 0..levels {
        self.setLink(node, l, self.link(before[l], l))
        self.setLink(before[l], l, node)
    }
    self.len += 1
}

// The value of k, and whether k is there.
pub (V, bool) SortedMap[K, V].get(K k) {
    n := self.find(k)
    if n == 0 {
        V none
        return (none, false)
    }
    return (self.nodes.buf[n].val, true)
}

// The value of k, or fallback when k isn't there.
pub V SortedMap[K, V].getOr(K k, V fallback) {
    n := self.find(k)
    return if n == 0 { fallback } else { self.nodes.buf[n].val }
}

// Whether k is there.
pub bool SortedMap[K, V].has(K k) => self.find(k) != 0

// Takes k out; false when it wasn't there.
pub bool SortedMap[K, V].remove(K k) {
    if self.len == 0 {
        return false
    }
    i64[24] before
    n := self.seek(k, before[:])
    if n == 0 || self.less(k, self.nodes.buf[n].key) {
        return false
    }
    levels := self.nodes.buf[n].levels
    for l in 0..levels {
        self.setLink(before[l], l, self.link(n, l))
    }
    for self.levels > 1 && self.link(0, self.levels - 1) == 0 {
        self.levels -= 1
    }
    keyFree(self.nodes.buf[n].key)
    K noKey
    V noValue
    self.nodes.buf[n].key = noKey
    self.nodes.buf[n].val = noValue
    self.setLink(n, 0, self.spare[levels])
    self.spare[levels] = n
    self.len -= 1
    return true
}

// The first key and its value, and false when the map is empty.
pub (K, V, bool) SortedMap[K, V].first() {
    if self.len == 0 {
        K noKey
        V noValue
        return (noKey, noValue, false)
    }
    n := self.link(0, 0)
    return (self.nodes.buf[n].key, self.nodes.buf[n].val, true)
}

// The last key and its value, and false when the map is empty.
pub (K, V, bool) SortedMap[K, V].last() {
    if self.len == 0 {
        K noKey
        V noValue
        return (noKey, noValue, false)
    }
    x := 0
    l := self.levels - 1
    for l >= 0 {
        for self.link(x, l) != 0 {
            x = self.link(x, l)
        }
        l -= 1
    }
    return (self.nodes.buf[x].key, self.nodes.buf[x].val, true)
}

// The keys in order, as a new List. A str or String key is the map's own
// copy, valid until the key is removed; free only the list.
pub List[K] SortedMap[K, V].keys() {
    List[K] out
    out.reserve(self.len)
    for k, _ in self {
        out.push(k)
    }
    return out
}

// Takes every key out and keeps the memory.
pub void SortedMap[K, V].clear() {
    if self.nodes.len == 0 {
        return
    }
    n := self.link(0, 0)
    for n != 0 {
        keyFree(self.nodes.buf[n].key)
        n = self.link(n, 0)
    }
    self.nodes.clear()
    self.links.clear()
    for i in 0..self.spare.len {
        self.spare[i] = 0
    }
    self.len = 0
    self.start()
}

// Gives the map's memory back; the map is empty after.
pub void SortedMap[K, V].free() {
    self.clear()
    self.nodes.free()
    self.links.free()
}

// for k, v in map, in the order of the keys. The map must not change
// during the loop.
pub (K, V, bool) SortedMap[K, V].next(i64 *at) {
    n := *at
    if n == 0 && self.len > 0 {
        n = self.link(0, 0)
    }
    if n <= 0 {
        K noKey
        V noValue
        return (noKey, noValue, false)
    }
    next := self.link(n, 0)
    *at = if next == 0 { -1 } else { next }
    return (self.nodes.buf[n].key, self.nodes.buf[n].val, true)
}

// The keys from one key up to another, from range.
pub struct SortedRange[K, V] {
    SortedMap[K, V] *m
    i64 start
    K to
}

// The keys from from up to to, to not included, with their values: for
// k, v in map.range(a, b). The map must not change during the loop.
pub SortedRange[K, V] SortedMap[K, V].range(K from, K to) {
    i64 start = -1
    if self.len > 0 {
        i64[24] before
        n := self.seek(from, before[:])
        if n != 0 {
            start = n
        }
    }
    return SortedRange[K, V]{m: self, start: start, to: to}
}

// for k, v in map.range(a, b)
pub (K, V, bool) SortedRange[K, V].next(i64 *at) {
    n := if *at == 0 { self.start } else { *at }
    m := self.m
    if n <= 0 || !m.less(m.nodes.buf[n].key, self.to) {
        K noKey
        V noValue
        return (noKey, noValue, false)
    }
    next := m.link(n, 0)
    *at = if next == 0 { -1 } else { next }
    return (m.nodes.buf[n].key, m.nodes.buf[n].val, true)
}
