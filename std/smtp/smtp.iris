// Sending mail over SMTP. The server is given as an address:
//
//     smtp://user:password@mail.example.com:587    STARTTLS, then the login
//     smtps://user:password@mail.example.com       TLS from the start, port 465
//
// with ?ca=file to trust other certificates than the system's, and
// ?helo=name for the name the client gives itself. On smtp:// the
// connection switches to TLS whenever the server offers it, and a
// password is never sent without TLS.
//
//     try smtp.send("smtps://alerts:secret@mail.example.com", smtp.Mail{
//         from: "alerts@example.com",
//         to: ["ops@example.com"],
//         subject: "disk 91% full on db1",
//         text: "/var is at 91%.",
//     })
//
// Files go along as attachments, read with fs.readAll:
//
//     scoped String pdf = try fs.readAll("report.pdf")
//     mail.attachments = [smtp.Attachment{name: "report.pdf", data: pdf, contentType: "application/pdf"}]

import base64, net, str, time, url, uuid

// What sending fails with: connect (the server can't be reached, or TLS
// fails), auth (the login is refused, or would have to go out without
// TLS), rejected (the server refused a sender, a recipient or the mail,
// with its reply in the message), protocol (the server said something
// that isn't SMTP).
pub enum SmtpError { connect, auth, rejected, protocol }

// A mail. from, to and subject are needed, and text, html or both: with
// both, the mail program shows the one it can. cc goes in the header for
// everyone to see; bcc gets the mail without being shown. attachments are
// files sent along with it.
pub struct Mail {
    pub str from
    pub str[] to
    pub str[] cc
    pub str[] bcc
    pub str replyTo
    pub str subject
    pub str text
    pub str html
    pub Attachment[] attachments
}

// A file sent with a mail: its name as the reader sees it, its bytes, and
// its type ("" is application/octet-stream; http.mimeType gives one from
// the name). With an id, the file is part of the HTML instead of a file
// to save: <img src="cid:logo"> shows the attachment whose id is "logo".
pub struct Attachment {
    pub str name
    pub str data
    pub str contentType
    pub str id
}

// A connection to a mail server, for sending several mails. One task
// uses it at a time.
pub struct Client {
    net.Conn conn
    String host
    bool tls
    bool broken
}

struct Settings {
    String host
    u16 port
    String user
    String password
    String ca
    String helo
    bool implicitTls
}

void Settings.free() {
    self.host.free()
    self.user.free()
    self.password.free()
    self.ca.free()
    self.helo.free()
}

!Settings settingsOf(str address) {
    u := url.parse(address) catch e {
        return error(SmtpError.connect, "'{address}' isn't an smtp:// or smtps:// address")
    }
    if (u.scheme != "smtp" && u.scheme != "smtps") || u.host.len == 0 {
        return error(SmtpError.connect, "'{address}' isn't an smtp:// or smtps:// address")
    }
    Settings s
    errdefer s.free()
    name, pass, _ := str.cut(u.user, ":")
    s.user = try url.decode(name)
    s.password = try url.decode(pass)
    s.host = u.host.copy()
    s.implicitTls = u.scheme == "smtps"
    i64 port = u.port
    if port == 0 {
        port = 465 if s.implicitTls else 587
    }
    s.port = u16(port)
    str rest = u.query
    for rest.len > 0 {
        pair, after, _ := str.cut(rest, "&")
        rest = after
        key, value, _ := str.cut(pair, "=")
        if key == "ca" {
            s.ca = try url.decode(value)
        } else if key == "helo" {
            s.helo = try url.decode(value)
        }
    }
    if s.helo.len == 0 {
        s.helo = "localhost".copy()
    }
    return s
}

// A reply: its code, and its text, the lines joined with spaces.
!(i64, String) Client.reply() {
    String text
    for {
        line := self.conn.readLine(64KiB) catch e {
            text.free()
            self.broken = true
            return error(SmtpError.connect, "the server closed the connection: {e.message}")
        }
        defer line.free()
        if line.len < 3 {
            text.free()
            self.broken = true
            return error(SmtpError.protocol, "the server sent '{line}', not an SMTP reply")
        }
        code := line[0:3].parseInt() catch e {
            text.free()
            self.broken = true
            return error(SmtpError.protocol, "the server sent '{line}', not an SMTP reply")
        }
        if text.len > 0 {
            text.append(" ")
        }
        text.append(line[4:] if line.len > 4 else "")
        if line.len == 3 || line[3] != '-' {
            return (code, text)
        }
    }
}

// Sends a command and reads the reply, which must have the code want.
!String Client.command(str line, i64 want, SmtpError fail = SmtpError.rejected) {
    self.conn.write(line) catch e {
        self.broken = true
        return error(SmtpError.connect, "sending to the server: {e.message}")
    }
    code, text := try self.reply()
    if code != want && !(want == 250 && code == 251) {
        what := line.trimRight()
        if str.startsWith(what, "AUTH ") {
            what = "AUTH"
        }
        defer text.free()
        return error(fail, "{what}: the server said {code} {text}")
    }
    return text
}

// Connects to the server at address, starts TLS and logs in.
pub !Client connect(str address) {
    scoped s := try settingsOf(address)
    conn := net.dial(s.host, s.port, timeout: 30s) catch e {
        return error(SmtpError.connect, e.message)
    }
    conn.setTimeout(60s)
    c := Client{conn: conn, host: s.host.copy()}
    errdefer c.close()
    if s.implicitTls {
        c.conn.startTls(s.host, s.ca) catch e {
            return error(SmtpError.connect, e.message)
        }
        c.tls = true
    }
    code, greeting := try c.reply()
    greeting.free()
    if code != 220 {
        return error(SmtpError.connect, "{s.host} isn't taking mail: it said {code}")
    }
    scoped String ext = try c.command("EHLO {s.helo}\r\n", 250, SmtpError.protocol)
    if !c.tls && hasWord(ext, "STARTTLS") {
        scoped String ready = try c.command("STARTTLS\r\n", 220, SmtpError.connect)
        c.conn.startTls(s.host, s.ca) catch e {
            return error(SmtpError.connect, e.message)
        }
        c.tls = true
        ext.free()
        ext = try c.command("EHLO {s.helo}\r\n", 250, SmtpError.protocol)
    }
    if s.user.len > 0 {
        if !c.tls {
            return error(SmtpError.auth, "{s.host} doesn't offer TLS, so the password isn't sent")
        }
        scoped String plain = format("\x00{s.user}\x00{s.password}")
        scoped String encoded = base64.encode(plain)
        scoped String ok = try c.command("AUTH PLAIN {encoded}\r\n", 235, SmtpError.auth)
    }
    return c
}

bool hasWord(str text, str word) {
    for w in str.fields(text) {
        if w == word {
            return true
        }
    }
    return false
}

// Sends a mail.
pub !void Client.send(Mail m) {
    if m.from.len == 0 || m.to.len + m.cc.len + m.bcc.len == 0 {
        return error(SmtpError.rejected, "a mail needs from and at least one of to, cc and bcc")
    }
    try checkLine("from", m.from)
    try checkLine("subject", m.subject)
    try checkLine("replyTo", m.replyTo)
    for a in m.attachments {
        if a.name.len == 0 && a.id.len == 0 {
            return error(SmtpError.rejected, "an attachment needs a name or an id")
        }
        try checkLine("attachment's name", a.name)
        try checkLine("attachment's contentType", a.contentType)
        try checkLine("attachment's id", a.id)
        if str.contains(a.id, "<") || str.contains(a.id, ">") || str.contains(a.contentType, "\"") {
            return error(SmtpError.rejected, "an attachment's id can't have < or >, nor its contentType a quote")
        }
    }
    scoped String ok = try self.command("MAIL FROM:<{bare(m.from)}>\r\n", 250)
    for list in [m.to, m.cc, m.bcc] {
        for to in list {
            try checkLine("to", to)
            scoped String r = self.command("RCPT TO:<{bare(to)}>\r\n", 250) catch e {
                if !self.broken {
                    // the server forgets the mail, so the next send starts clean
                    scoped String reset = self.command("RSET\r\n", 250) catch e2 { "".copy() }
                }
                return e
            }
        }
    }
    scoped String go = try self.command("DATA\r\n", 354)
    scoped String msg = message(m, self.host)
    msg.append(".\r\n")
    scoped String done = try self.command(msg, 250)
}

// The address in "Ada <ada@example.com>", or the text when it has no <>.
str bare(str addr) {
    open := str.findLast(addr, "<")
    close := str.findLast(addr, ">")
    if open >= 0 && close > open {
        return addr[open + 1:close]
    }
    return addr.trim()
}

!void checkLine(str field, str value) {
    if str.contains(value, "\r") || str.contains(value, "\n") {
        return error(SmtpError.rejected, "the mail's {field} has a line break in it")
    }
}

// The mail as SMTP sends it: headers, then the body in base64, lines
// ending in \r\n.
String message(Mail m, str host) {
    String out
    scoped String date = rfc5322(time.now())
    scoped String id = uuid.v4().format()
    out.append("Date: {date}\r\n")
    out.append("Message-ID: <{id}@{host}>\r\n")
    out.append("From: {m.from}\r\n")
    if m.to.len > 0 {
        scoped String to = str.join(m.to, ", ")
        out.append("To: {to}\r\n")
    }
    if m.cc.len > 0 {
        scoped String cc = str.join(m.cc, ", ")
        out.append("Cc: {cc}\r\n")
    }
    if m.replyTo.len > 0 {
        out.append("Reply-To: {m.replyTo}\r\n")
    }
    scoped String subject = headerText(m.subject)
    out.append("Subject: {subject}\r\n")
    out.append("MIME-Version: 1.0\r\n")
    bool files = false
    for a in m.attachments {
        if a.id.len == 0 {
            files = true
        }
    }
    if !files {
        related(&out, m)
        return out
    }
    // multipart/mixed: the body, then each file
    scoped String boundary = uuid.v4().format()
    out.append("Content-Type: multipart/mixed; boundary=\"{boundary}\"\r\n\r\n")
    out.append("--{boundary}\r\n")
    related(&out, m)
    for a in m.attachments {
        if a.id.len == 0 {
            out.append("--{boundary}\r\n")
            attachment(&out, a)
        }
    }
    out.append("--{boundary}--\r\n")
    return out
}

// The body with the files that are part of its HTML, as multipart/related,
// or the body alone when there are none.
void related(String *out, Mail m) {
    bool inline = false
    for a in m.attachments {
        if a.id.len > 0 {
            inline = true
        }
    }
    if !inline {
        body(out, m)
        return
    }
    scoped String boundary = uuid.v4().format()
    out.append("Content-Type: multipart/related; boundary=\"{boundary}\"\r\n\r\n")
    out.append("--{boundary}\r\n")
    body(out, m)
    for a in m.attachments {
        if a.id.len > 0 {
            out.append("--{boundary}\r\n")
            attachment(out, a)
        }
    }
    out.append("--{boundary}--\r\n")
}

// The text and the HTML, as multipart/alternative when there are both.
void body(String *out, Mail m) {
    if m.html.len > 0 && m.text.len > 0 {
        scoped String boundary = uuid.v4().format()
        out.append("Content-Type: multipart/alternative; boundary=\"{boundary}\"\r\n\r\n")
        out.append("--{boundary}\r\n")
        part(out, "text/plain", m.text)
        out.append("--{boundary}\r\n")
        part(out, "text/html", m.html)
        out.append("--{boundary}--\r\n")
    } else if m.html.len > 0 {
        part(out, "text/html", m.html)
    } else {
        part(out, "text/plain", m.text)
    }
}

void part(String *out, str kind, str body) {
    out.append("Content-Type: {kind}; charset=utf-8\r\n")
    out.append("Content-Transfer-Encoding: base64\r\n\r\n")
    base64Lines(out, body)
}

// A file: its type and name, how it is shown, and its bytes in base64.
void attachment(String *out, Attachment a) {
    kind := if a.contentType.len > 0 { a.contentType } else { "application/octet-stream" }
    out.append("Content-Type: {kind}")
    if a.name.len > 0 {
        param(out, "name", a.name)
    }
    out.append("\r\n")
    out.append(if a.id.len > 0 { "Content-Disposition: inline" } else { "Content-Disposition: attachment" })
    if a.name.len > 0 {
        param(out, "filename", a.name)
    }
    out.append("\r\n")
    if a.id.len > 0 {
        out.append("Content-ID: <{a.id}>\r\n")
    }
    out.append("Content-Transfer-Encoding: base64\r\n\r\n")
    base64Lines(out, a.data)
}

// ; key="value", or for a value with bytes beyond ASCII or a quote,
// ; key*=UTF-8''value with %XX (RFC 2231).
void param(String *out, str key, str value) {
    for i in 0..value.len {
        c := value[i]
        if c >= 0x80 || c < 0x20 || c == '"' || c == '\\' {
            scoped String e = url.encode(value)
            out.append("; {key}*=UTF-8''{e}")
            return
        }
    }
    out.append("; {key}=\"{value}\"")
}

// data in base64, in lines of 76 characters.
void base64Lines(String *out, str data) {
    scoped String b = base64.encode(data)
    i := 0
    for i < b.len {
        end := i + 76 if i + 76 < b.len else b.len
        out.append(b[i:end])
        out.append("\r\n")
        i = end
    }
}

// Header text as it is, or, with bytes beyond ASCII, as an RFC 2047
// encoded word.
String headerText(str text) {
    for i in 0..text.len {
        if text[i] >= 0x80 {
            scoped String b = base64.encode(text)
            return format("=?UTF-8?B?{b}?=")
        }
    }
    return text.copy()
}

// "Thu, 22 Oct 2026 14:03:09 +0000"
String rfc5322(time.Time t) {
    u := t.utc()
    day := match u.weekday() {
        .monday => "Mon"
        .tuesday => "Tue"
        .wednesday => "Wed"
        .thursday => "Thu"
        .friday => "Fri"
        .saturday => "Sat"
        .sunday => "Sun"
    }
    months := ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
    scoped String clock = u.format("hh:mm:ss")
    return format("{day}, {u.day()} {months[u.month() - 1]} {u.year()} {clock} +0000")
}

// Sends a mail through the server at address: connect, send and close.
pub !void send(str address, Mail m) {
    c := try connect(address)
    defer c.close()
    try c.send(m)
}

// Says goodbye to the server and closes the connection.
pub void Client.close() {
    if !self.broken {
        scoped String bye = self.command("QUIT\r\n", 221) catch e { "".copy() }
    }
    self.conn.close()
    self.host.free()
}
