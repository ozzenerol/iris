// Base64: bytes as text, standard (RFC 4648) and URL-safe (for URLs and
// JSON Web Tokens).

// What decoding fails with: invalid for text that isn't Base64.
pub enum Base64Error { invalid }

const STANDARD = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
const URL = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"

String encodeWith(str data, str alphabet, bool pad) {
    String out
    i := 0
    for i + 2 < data.len {
        n := i64(data[i]) << 16 | i64(data[i + 1]) << 8 | i64(data[i + 2])
        out.append(alphabet[n >> 18 & 63:(n >> 18 & 63) + 1])
        out.append(alphabet[n >> 12 & 63:(n >> 12 & 63) + 1])
        out.append(alphabet[n >> 6 & 63:(n >> 6 & 63) + 1])
        out.append(alphabet[n & 63:(n & 63) + 1])
        i += 3
    }
    rest := data.len - i
    if rest > 0 {
        n := i64(data[i]) << 16
        if rest == 2 {
            n = n | i64(data[i + 1]) << 8
        }
        out.append(alphabet[n >> 18 & 63:(n >> 18 & 63) + 1])
        out.append(alphabet[n >> 12 & 63:(n >> 12 & 63) + 1])
        if rest == 2 {
            out.append(alphabet[n >> 6 & 63:(n >> 6 & 63) + 1])
        } else if pad {
            out.append("=")
        }
        if pad {
            out.append("=")
        }
    }
    return out
}

i64 value(u8 c, bool url) {
    if c >= 'A' && c <= 'Z' {
        return i64(c - 'A')
    }
    if c >= 'a' && c <= 'z' {
        return i64(c - 'a') + 26
    }
    if c >= '0' && c <= '9' {
        return i64(c - '0') + 52
    }
    if c == (if url { '-' } else { '+' }) {
        return 62
    }
    if c == (if url { '_' } else { '/' }) {
        return 63
    }
    return -1
}

!String decodeWith(str text, bool url) {
    String out
    errdefer out.free()
    i64 acc
    i64 bits
    i64 n
    for i in 0..text.len {
        c := text[i]
        if c == '=' {
            for k in i..text.len {
                if text[k] != '=' {
                    return error(Base64Error.invalid, "'=' in the middle of base64 text")
                }
            }
            break
        }
        if c == '\n' || c == '\r' {
            continue
        }
        v := value(c, url)
        if v < 0 {
            return error(Base64Error.invalid, "'{text[i:i + 1]}' isn't base64")
        }
        acc = (acc << 6 | v) & 0xffffff
        bits += 6
        n += 1
        if bits >= 8 {
            bits -= 8
            u8[1] b = [u8(acc >> bits & 255)]
            out.append(b)
        }
    }
    if n % 4 == 1 {
        return error(Base64Error.invalid, "base64 text that ends in the middle of a byte")
    }
    return out
}

// The bytes of data as standard base64, with = at the end.
pub String encode(str data) => encodeWith(data, STANDARD, true)

// The bytes of standard base64 text; = at the end and line breaks may be
// left out.
pub !String decode(str text) => try decodeWith(text, false)

// The bytes of data as URL-safe base64 (- and _), without =.
pub String encodeUrl(str data) => encodeWith(data, URL, false)

// The bytes of URL-safe base64 text.
pub !String decodeUrl(str text) => try decodeWith(text, true)
