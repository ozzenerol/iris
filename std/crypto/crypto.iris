// Hashes for checking data and signing it: SHA-256, SHA-512, HMAC, HKDF,
// PBKDF2 and Ed25519 signatures, and SHA-1 and MD5 for older protocols.

@extern("iris_sha256")
void rawSha256(u8 *data, i64 len, u8 *out)

@extern("iris_hmac_sha256")
void rawHmac(u8 *key, i64 keyLen, u8 *data, i64 len, u8 *out)

@extern("iris_sha1")
void rawSha1(u8 *data, i64 len, u8 *out)

@extern("iris_md5")
void rawMd5(u8 *data, i64 len, u8 *out)

@extern("iris_const_equal")
i32 rawEqual(u8 *a, i64 na, u8 *b, i64 nb)

@extern("iris_sha512")
void rawSha512(u8 *data, i64 len, u8 *out)

@extern("iris_hmac_sha512")
void rawHmac512(u8 *key, i64 keyLen, u8 *data, i64 len, u8 *out)

@extern("iris_ed25519_public")
void rawEdPublic(u8 *seed, u8 *out)

@extern("iris_ed25519_sign")
void rawEdSign(u8 *seed, u8 *msg, i64 len, u8 *out)

@extern("iris_ed25519_verify")
i32 rawEdVerify(u8 *key, u8 *msg, i64 len, u8 *sig)

// The SHA-256 hash of data: 32 bytes. hex.encode makes it readable.
pub u8[32] sha256(str data) {
    u8[32] out
    rawSha256(data.ptr, data.len, &out[0])
    return out
}

// The HMAC-SHA256 of data with key: 32 bytes that only someone with the
// key can make.
pub u8[32] hmacSha256(str key, str data) {
    u8[32] out
    rawHmac(key.ptr, key.len, data.ptr, data.len, &out[0])
    return out
}

// The SHA-512 hash of data: 64 bytes.
pub u8[64] sha512(str data) {
    u8[64] out
    rawSha512(data.ptr, data.len, &out[0])
    return out
}

// The HMAC-SHA512 of data with key: 64 bytes that only someone with the
// key can make.
pub u8[64] hmacSha512(str key, str data) {
    u8[64] out
    rawHmac512(key.ptr, key.len, data.ptr, data.len, &out[0])
    return out
}

// HKDF with HMAC-SHA256 (RFC 5869): size bytes of keys made from a shared
// secret. The salt can be empty; info says what the keys are for, so one
// secret gives different keys for different uses. size is at most 8160.
pub String hkdfSha256(str secret, str salt, str info, i64 size = 32) {
    if size < 0 || size > 255 * 32 {
        panic("hkdfSha256 makes 0 to 8160 bytes, not {size}")
    }
    u8[32] prk = hmacSha256(salt, secret)
    String out
    u8[32] t
    i64 tLen = 0
    i64 block = 1
    for out.len < size {
        String input
        input.append(t[0:tLen])
        input.append(info)
        u8[1] n = [u8(block)]
        input.append(n[0:1])
        t = hmacSha256(prk[0:32], input)
        input.free()
        tLen = 32
        take := if size - out.len < 32 { size - out.len } else { 32 }
        out.append(t[0:take])
        block += 1
    }
    return out
}

// The Ed25519 public key for a secret seed of 32 bytes (RFC 8032). Make a
// seed with random.bytes and keep it secret; the public key can be shared.
pub u8[32] ed25519Public(str seed) {
    if seed.len != 32 {
        panic("an Ed25519 seed is 32 bytes, not {seed.len}")
    }
    u8[32] out
    rawEdPublic(seed.ptr, &out[0])
    return out
}

// The Ed25519 signature of message with the secret seed: 64 bytes that
// anyone with the public key can check, and only the seed can make.
pub u8[64] ed25519Sign(str seed, str message) {
    if seed.len != 32 {
        panic("an Ed25519 seed is 32 bytes, not {seed.len}")
    }
    u8[64] out
    rawEdSign(seed.ptr, message.ptr, message.len, &out[0])
    return out
}

// Whether signature is the Ed25519 signature of message for the public
// key. A key or signature of the wrong size is false.
pub bool ed25519Verify(str publicKey, str message, str signature) {
    if publicKey.len != 32 || signature.len != 64 {
        return false
    }
    return rawEdVerify(publicKey.ptr, message.ptr, message.len, signature.ptr) != 0
}

// Whether a and b are the same, taking the same time wherever they differ.
// Use it to compare hashes and tokens.
pub bool equal(str a, str b) => rawEqual(a.ptr, a.len, b.ptr, b.len) != 0

// The SHA-1 hash of data: 20 bytes. Old and broken for signatures; it is
// here for protocols that still use it, like the WebSocket handshake.
pub u8[20] sha1(str data) {
    u8[20] out
    rawSha1(data.ptr, data.len, &out[0])
    return out
}

// The MD5 hash of data: 16 bytes. Broken for signatures too; for older
// protocols and checksums only.
pub u8[16] md5(str data) {
    u8[16] out
    rawMd5(data.ptr, data.len, &out[0])
    return out
}

// PBKDF2 with HMAC-SHA256 (RFC 8018): a key of size bytes from a password
// and a salt, made slow by iterations. For storing passwords, and for
// logins like SCRAM.
pub String pbkdf2Sha256(str password, str salt, i64 iterations, i64 size = 32) {
    String out
    i64 block = 1
    for out.len < size {
        String first
        first.append(salt)
        u8[4] index = [u8(block >> 24 & 0xff), u8(block >> 16 & 0xff), u8(block >> 8 & 0xff), u8(block & 0xff)]
        first.append(index[0:4])
        u8[32] u = hmacSha256(password, first)
        first.free()
        u8[32] t = u
        for i in 1..iterations {
            u = hmacSha256(password, u[0:32])
            for k in 0..32 {
                t[k] = t[k] ^ u[k]
            }
        }
        take := if size - out.len < 32 { size - out.len } else { 32 }
        out.append(t[0:take])
        block += 1
    }
    return out
}
