// Hashes, signatures and encryption: SHA-256, SHA-384, SHA-512, HMAC, HKDF,
// PBKDF2, Ed25519, ECDSA and RSA signatures, X25519 key exchange,
// ChaCha20-Poly1305 and AES-GCM, the bare AES and ChaCha20 ciphers that
// protocols build on, and SHA-1 and MD5 for older protocols.

// What can go wrong: a peer's key that isn't one, or sealed data that was
// changed or sealed with another key.
pub enum CryptoError {
    badKey
    tampered
}

@extern("iris_sha256")
void rawSha256(u8 *data, i64 len, u8 *out)

@extern("iris_hmac_sha256")
void rawHmac(u8 *key, i64 keyLen, u8 *data, i64 len, u8 *out)

@extern("iris_sha1")
void rawSha1(u8 *data, i64 len, u8 *out)

@extern("iris_md5")
void rawMd5(u8 *data, i64 len, u8 *out)

@extern("iris_const_equal")
i32 rawEqual(u8 *a, i64 na, u8 *b, i64 nb)

@extern("iris_sha512")
void rawSha512(u8 *data, i64 len, u8 *out)

@extern("iris_hmac_sha512")
void rawHmac512(u8 *key, i64 keyLen, u8 *data, i64 len, u8 *out)

@extern("iris_ed25519_public")
void rawEdPublic(u8 *seed, u8 *out)

@extern("iris_ed25519_sign")
void rawEdSign(u8 *seed, u8 *msg, i64 len, u8 *out)

@extern("iris_ed25519_verify")
i32 rawEdVerify(u8 *key, u8 *msg, i64 len, u8 *sig)

@extern("iris_x25519")
i32 rawX25519(u8 *secret, u8 *point, u8 *out)

@extern("iris_x25519_public")
void rawX25519Public(u8 *secret, u8 *out)

@extern("iris_chacha_seal")
void rawSeal(u8 *key, u8 *nonce, u8 *data, i64 len, u8 *extra, i64 extraLen, String *out)

@extern("iris_chacha_open")
i32 rawOpen(u8 *key, u8 *nonce, u8 *data, i64 len, u8 *extra, i64 extraLen, String *out)

// The SHA-256 hash of data: 32 bytes. hex.encode makes it readable.
pub u8[32] sha256(str data) {
    u8[32] out
    rawSha256(data.ptr, data.len, &out[0])
    return out
}

// The HMAC-SHA256 of data with key: 32 bytes that only someone with the
// key can make.
pub u8[32] hmacSha256(str key, str data) {
    u8[32] out
    rawHmac(key.ptr, key.len, data.ptr, data.len, &out[0])
    return out
}

// The SHA-512 hash of data: 64 bytes.
pub u8[64] sha512(str data) {
    u8[64] out
    rawSha512(data.ptr, data.len, &out[0])
    return out
}

// The HMAC-SHA512 of data with key: 64 bytes that only someone with the
// key can make.
pub u8[64] hmacSha512(str key, str data) {
    u8[64] out
    rawHmac512(key.ptr, key.len, data.ptr, data.len, &out[0])
    return out
}

// HKDF with HMAC-SHA256 (RFC 5869): size bytes of keys made from a shared
// secret. The salt can be empty; info says what the keys are for, so one
// secret gives different keys for different uses. size is at most 8160.
pub String hkdfSha256(str secret, str salt, str info, i64 size = 32) {
    if size < 0 || size > 255 * 32 {
        panic("hkdfSha256 makes 0 to 8160 bytes, not {size}")
    }
    u8[32] prk = hmacSha256(salt, secret)
    String out
    u8[32] t
    i64 tLen = 0
    i64 block = 1
    for out.len < size {
        String input
        input.append(t[0:tLen])
        input.append(info)
        u8[1] n = [u8(block)]
        input.append(n[0:1])
        t = hmacSha256(prk[0:32], input)
        input.free()
        tLen = 32
        take := if size - out.len < 32 { size - out.len } else { 32 }
        out.append(t[0:take])
        block += 1
    }
    return out
}

// The Ed25519 public key for a secret seed of 32 bytes (RFC 8032). Make a
// seed with random.bytes and keep it secret; the public key can be shared.
pub u8[32] ed25519Public(str seed) {
    if seed.len != 32 {
        panic("an Ed25519 seed is 32 bytes, not {seed.len}")
    }
    u8[32] out
    rawEdPublic(seed.ptr, &out[0])
    return out
}

// The Ed25519 signature of message with the secret seed: 64 bytes that
// anyone with the public key can check, and only the seed can make.
pub u8[64] ed25519Sign(str seed, str message) {
    if seed.len != 32 {
        panic("an Ed25519 seed is 32 bytes, not {seed.len}")
    }
    u8[64] out
    rawEdSign(seed.ptr, message.ptr, message.len, &out[0])
    return out
}

// Whether signature is the Ed25519 signature of message for the public
// key. A key or signature of the wrong size is false.
pub bool ed25519Verify(str publicKey, str message, str signature) {
    if publicKey.len != 32 || signature.len != 64 {
        return false
    }
    return rawEdVerify(publicKey.ptr, message.ptr, message.len, signature.ptr) != 0
}

// The X25519 public key for a secret of 32 random bytes (RFC 7748). Two
// sides each make a secret with random.bytes and send the other their
// public key; x25519 then gives both of them the same shared secret.
pub u8[32] x25519Public(str secret) {
    if secret.len != 32 {
        panic("an X25519 secret is 32 bytes, not {secret.len}")
    }
    u8[32] out
    rawX25519Public(secret.ptr, &out[0])
    return out
}

// The secret shared with the peer whose public key is peerPublic. Make
// keys from it with hkdfSha256 rather than using it as one.
// CryptoError.badKey when peerPublic isn't 32 bytes or gives nothing
// secret.
pub !u8[32] x25519(str secret, str peerPublic) {
    if secret.len != 32 {
        panic("an X25519 secret is 32 bytes, not {secret.len}")
    }
    if peerPublic.len != 32 {
        return error(CryptoError.badKey, "an X25519 public key is 32 bytes, not {peerPublic.len}")
    }
    u8[32] out
    if rawX25519(secret.ptr, peerPublic.ptr, &out[0]) == 0 {
        return error(CryptoError.badKey, "the peer's public key gives no shared secret")
    }
    return out
}

// Encrypts data with ChaCha20-Poly1305 (RFC 8439): a 32-byte key and a
// 12-byte nonce. What it gives is data.len + 16 bytes: the data, hidden,
// and a tag that unseal checks. extra is data that isn't hidden but is
// checked too, like a header sent alongside. A nonce must never be used
// twice with one key: count them, or take each from random.bytes.
pub String seal(str key, str nonce, str data, str extra = "") {
    if key.len != 32 || nonce.len != 12 {
        panic("seal takes a 32-byte key and a 12-byte nonce, not {key.len} and {nonce.len}")
    }
    String out
    rawSeal(key.ptr, nonce.ptr, data.ptr, data.len, extra.ptr, extra.len, &out)
    return out
}

// seal, adding to the end of out instead of making a new String: a
// program that seals many packets keeps one out and empties it between
// them.
pub void sealTo(String *out, str key, str nonce, str data, str extra = "") {
    if key.len != 32 || nonce.len != 12 {
        panic("sealTo takes a 32-byte key and a 12-byte nonce, not {key.len} and {nonce.len}")
    }
    rawSeal(key.ptr, nonce.ptr, data.ptr, data.len, extra.ptr, extra.len, out)
}

@extern("iris_aes_seal")
void rawAesSeal(u8 *key, i64 keyLen, u8 *nonce, u8 *data, i64 len, u8 *extra, i64 extraLen, String *out)

@extern("iris_aes_open")
i32 rawAesOpen(u8 *key, i64 keyLen, u8 *nonce, u8 *data, i64 len, u8 *extra, i64 extraLen, String *out)

// Encrypts data with AES-GCM: a 16, 24 or 32-byte key (AES-128, AES-192 or
// AES-256) and a 12-byte nonce. It works as seal does and gives
// data.len + 16 bytes. On CPUs with AES instructions (x86_64 and most
// ARM64 ones) it is the fastest choice. A nonce must never be used twice
// with one key.
pub String aesSeal(str key, str nonce, str data, str extra = "") {
    aesCheck("aesSeal", key, nonce)
    String out
    rawAesSeal(key.ptr, key.len, nonce.ptr, data.ptr, data.len, extra.ptr, extra.len, &out)
    return out
}

// The data that aesSeal hid, with the same key, nonce and extra.
// CryptoError.tampered when anything was changed, or the key, nonce or
// extra differ.
pub !String aesUnseal(str key, str nonce, str sealed, str extra = "") {
    aesCheck("aesUnseal", key, nonce)
    String out
    if rawAesOpen(key.ptr, key.len, nonce.ptr, sealed.ptr, sealed.len, extra.ptr, extra.len, &out) == 0 {
        return error(CryptoError.tampered, "the sealed data was changed, or the key doesn't fit")
    }
    return out
}

// aesSeal, adding to the end of out instead of making a new String.
pub void aesSealTo(String *out, str key, str nonce, str data, str extra = "") {
    aesCheck("aesSealTo", key, nonce)
    rawAesSeal(key.ptr, key.len, nonce.ptr, data.ptr, data.len, extra.ptr, extra.len, out)
}

// aesUnseal, adding the data to the end of out. out is left as it was when
// the data doesn't open.
pub !void aesUnsealTo(String *out, str key, str nonce, str sealed, str extra = "") {
    aesCheck("aesUnsealTo", key, nonce)
    if rawAesOpen(key.ptr, key.len, nonce.ptr, sealed.ptr, sealed.len, extra.ptr, extra.len, out) == 0 {
        return error(CryptoError.tampered, "the sealed data was changed, or the key doesn't fit")
    }
}

void aesCheck(str name, str key, str nonce) {
    if (key.len != 16 && key.len != 24 && key.len != 32) || nonce.len != 12 {
        panic("{name} takes a 16, 24 or 32-byte key and a 12-byte nonce, not {key.len} and {nonce.len}")
    }
}

// The data that seal hid, with the same key, nonce and extra.
// CryptoError.tampered when anything was changed, or the key, nonce or
// extra differ.
pub !String unseal(str key, str nonce, str sealed, str extra = "") {
    if key.len != 32 || nonce.len != 12 {
        panic("unseal takes a 32-byte key and a 12-byte nonce, not {key.len} and {nonce.len}")
    }
    String out
    if rawOpen(key.ptr, nonce.ptr, sealed.ptr, sealed.len, extra.ptr, extra.len, &out) == 0 {
        return error(CryptoError.tampered, "the sealed data was changed, or the key doesn't fit")
    }
    return out
}

// unseal, adding the data to the end of out. out is left as it was when
// the data doesn't open.
pub !void unsealTo(String *out, str key, str nonce, str sealed, str extra = "") {
    if key.len != 32 || nonce.len != 12 {
        panic("unsealTo takes a 32-byte key and a 12-byte nonce, not {key.len} and {nonce.len}")
    }
    if rawOpen(key.ptr, nonce.ptr, sealed.ptr, sealed.len, extra.ptr, extra.len, out) == 0 {
        return error(CryptoError.tampered, "the sealed data was changed, or the key doesn't fit")
    }
}

// Whether a and b are the same, taking the same time wherever they differ.
// Use it to compare hashes and tokens.
pub bool equal(str a, str b) => rawEqual(a.ptr, a.len, b.ptr, b.len) != 0

// The SHA-1 hash of data: 20 bytes. Old and broken for signatures; it is
// here for protocols that still use it, like the WebSocket handshake.
pub u8[20] sha1(str data) {
    u8[20] out
    rawSha1(data.ptr, data.len, &out[0])
    return out
}

// The MD5 hash of data: 16 bytes. Broken for signatures too; for older
// protocols and checksums only.
pub u8[16] md5(str data) {
    u8[16] out
    rawMd5(data.ptr, data.len, &out[0])
    return out
}

// PBKDF2 with HMAC-SHA256 (RFC 8018): a key of size bytes from a password
// and a salt, made slow by iterations. For storing passwords, and for
// logins like SCRAM.
pub String pbkdf2Sha256(str password, str salt, i64 iterations, i64 size = 32) {
    String out
    i64 block = 1
    for out.len < size {
        String first
        first.append(salt)
        u8[4] index = [u8(block >> 24 & 0xff), u8(block >> 16 & 0xff), u8(block >> 8 & 0xff), u8(block & 0xff)]
        first.append(index[0:4])
        u8[32] u = hmacSha256(password, first)
        first.free()
        u8[32] t = u
        for i in 1..iterations {
            u = hmacSha256(password, u[0:32])
            for k in 0..32 {
                t[k] = t[k] ^ u[k]
            }
        }
        take := if size - out.len < 32 { size - out.len } else { 32 }
        out.append(t[0:take])
        block += 1
    }
    return out
}

@extern("iris_sha384")
void rawSha384(u8 *data, i64 len, u8 *out)

@extern("iris_hmac_sha384")
void rawHmac384(u8 *key, i64 keyLen, u8 *data, i64 len, u8 *out)

@extern("iris_hmac_sha1")
void rawHmac1(u8 *key, i64 keyLen, u8 *data, i64 len, u8 *out)

@extern("iris_aes_block")
void rawAesBlock(u8 *key, i64 keyLen, u8 *data, u8 *out)

@extern("iris_aes_ctr")
void rawAesCtr(u8 *key, i64 keyLen, u8 *iv, u8 *data, i64 len, String *out)

@extern("iris_chacha20")
void rawChacha(u8 *key, u8 *nonce, u32 counter, u8 *data, i64 len, String *out)

@extern("iris_wipe")
void rawWipe(u8 *p, i64 n)

// The SHA-384 hash of data: 48 bytes.
pub u8[48] sha384(str data) {
    u8[48] out
    rawSha384(data.ptr, data.len, &out[0])
    return out
}

// The HMAC-SHA384 of data with key: 48 bytes.
pub u8[48] hmacSha384(str key, str data) {
    u8[48] out
    rawHmac384(key.ptr, key.len, data.ptr, data.len, &out[0])
    return out
}

// The HMAC-SHA1 of data with key: 20 bytes, for older protocols such as
// TOTP codes (RFC 6238). Don't pick it for new ones.
pub u8[20] hmacSha1(str key, str data) {
    u8[20] out
    rawHmac1(key.ptr, key.len, data.ptr, data.len, &out[0])
    return out
}

void aesKey(str key) {
    if key.len != 16 && key.len != 24 && key.len != 32 {
        panic("an AES key is 16, 24 or 32 bytes, not {key.len}")
    }
}

// One 16-byte block encrypted with AES and key (16, 24 or 32 bytes), with
// nothing around it (ECB): what QUIC's header protection takes a mask
// from. Use aesSeal to encrypt data.
pub u8[16] aesBlock(str key, str block) {
    aesKey(key)
    if block.len != 16 {
        panic("an AES block is 16 bytes, not {block.len}")
    }
    u8[16] out
    rawAesBlock(key.ptr, key.len, block.ptr, &out[0])
    return out
}

// data encrypted, or decrypted, with AES in counter mode: iv (16 bytes) is
// the first counter block, counted up as one big-endian number. It doesn't
// check that the data wasn't changed, so protocols add a MAC, as SSH's
// aes128-ctr does with HMAC.
pub String aesCtr(str key, str iv, str data) {
    aesKey(key)
    if iv.len != 16 {
        panic("an AES-CTR iv is 16 bytes, not {iv.len}")
    }
    String out
    rawAesCtr(key.ptr, key.len, iv.ptr, data.ptr, data.len, &out)
    return out
}

// data xored with the ChaCha20 stream (RFC 8439) for key (32 bytes) and
// nonce (12), from block counter on: encrypting and decrypting are the
// same. Without a MAC; seal is ChaCha20-Poly1305.
pub String chacha20(str key, str nonce, str data, u32 counter = 0) {
    if key.len != 32 || nonce.len != 12 {
        panic("ChaCha20 takes a 32-byte key and a 12-byte nonce, not {key.len} and {nonce.len}")
    }
    String out
    rawChacha(key.ptr, nonce.ptr, counter, data.ptr, data.len, &out)
    return out
}

// Overwrites the bytes with zeros, in a way the compiler can't leave out,
// for keys and passwords that are done with: wipe(key[0:]) or
// wipe(secret.items()).
pub void wipe(u8[] bytes) => rawWipe(bytes.ptr, bytes.len)

@extern("iris_bcrypt_pbkdf")
void rawBcryptPbkdf(u8 *password, i64 passwordLen, u8 *salt, i64 saltLen, i64 rounds, u8 *key, i64 size)

// bcrypt_pbkdf: a key of size bytes from a password and a salt, made slow
// by rounds, as OpenSSH uses for private keys with a passphrase (16 rounds
// unless ssh-keygen -a says).
pub String bcryptPbkdf(str password, str salt, i64 rounds, i64 size = 32) {
    if rounds < 1 || size < 1 || size > 1024 {
        panic("bcryptPbkdf takes 1 or more rounds and 1 to 1024 bytes, not {rounds} and {size}")
    }
    String out
    out.reserve(size)
    for out.len < size {
        out.append("\x00")
    }
    rawBcryptPbkdf(password.ptr, password.len, salt.ptr, salt.len, rounds, out.ptr, size)
    return out
}

// ------------------------------------------------------------ SHA-3 and ML-KEM

@extern("iris_sha3")
void rawSha3(i32 bits, u8 *data, i64 len, u8 *out)

@extern("iris_shake")
void rawShake(i32 bits, u8 *data, i64 len, String *out, i64 size)

@extern("iris_mlkem768_public")
void rawMlkemPublic(u8 *seed, String *out)

@extern("iris_mlkem768_encapsulate")
i32 rawMlkemEncapsulate(u8 *publicKey, String *ciphertext, u8 *shared)

@extern("iris_mlkem768_decapsulate")
void rawMlkemDecapsulate(u8 *seed, u8 *ciphertext, u8 *shared)

// The SHA3-256 hash of data (FIPS 202): 32 bytes.
pub u8[32] sha3_256(str data) {
    u8[32] out
    rawSha3(256, data.ptr, data.len, &out[0])
    return out
}

// The SHA3-512 hash of data: 64 bytes.
pub u8[64] sha3_512(str data) {
    u8[64] out
    rawSha3(512, data.ptr, data.len, &out[0])
    return out
}

// size bytes of SHAKE128 or SHAKE256 of data, as bits says (128 or 256).
pub String shake(str data, i64 size, i64 bits = 256) {
    if bits != 128 && bits != 256 {
        panic("SHAKE is SHAKE128 or SHAKE256, not {bits}")
    }
    String out
    rawShake(i32(bits), data.ptr, data.len, &out, size)
    return out
}

// The sizes of ML-KEM-768's keys and ciphertexts.
pub const i64 MLKEM_SEED = 64
pub const i64 MLKEM_PUBLIC = 1184
pub const i64 MLKEM_CIPHERTEXT = 1088

// The public key (the encapsulation key, 1184 bytes) of the ML-KEM-768
// key with the secret seed of 64 random bytes (FIPS 203). The seed is how
// the secret key is kept, as TLS and SSH do.
pub String mlkemPublic(str seed) {
    if seed.len != MLKEM_SEED {
        panic("an ML-KEM seed is 64 bytes, not {seed.len}")
    }
    String out
    rawMlkemPublic(seed.ptr, &out)
    return out
}

// A new shared secret for the holder of publicKey: the ciphertext to send
// them (1088 bytes) and the 32-byte secret. CryptoError.badKey when
// publicKey isn't an ML-KEM-768 key.
pub !(String, u8[32]) mlkemEncapsulate(str publicKey) {
    if publicKey.len != MLKEM_PUBLIC {
        return error(CryptoError.badKey, "an ML-KEM-768 public key is 1184 bytes, not {publicKey.len}")
    }
    String c
    u8[32] shared
    if rawMlkemEncapsulate(publicKey.ptr, &c, &shared[0]) == 0 {
        c.free()
        return error(CryptoError.badKey, "not an ML-KEM-768 public key")
    }
    return (c, shared)
}

// The shared secret in ciphertext, for the key with the secret seed. A
// ciphertext that was changed gives another secret, not an error, so the
// two sides' secrets differ.
pub !u8[32] mlkemDecapsulate(str seed, str ciphertext) {
    if seed.len != MLKEM_SEED {
        panic("an ML-KEM seed is 64 bytes, not {seed.len}")
    }
    if ciphertext.len != MLKEM_CIPHERTEXT {
        return error(CryptoError.badKey, "an ML-KEM-768 ciphertext is 1088 bytes, not {ciphertext.len}")
    }
    u8[32] shared
    rawMlkemDecapsulate(seed.ptr, ciphertext.ptr, &shared[0])
    return shared
}

// ------------------------------------------------------------ ECDSA and RSA

@extern("iris_pk_load_private")
u8 *rawLoadPrivate(u8 *data, i64 len)

@extern("iris_pk_load_public")
u8 *rawLoadPublic(u8 *data, i64 len)

@extern("iris_pk_ec_public")
u8 *rawEcPublic(i32 curve, u8 *point, i64 len)

@extern("iris_pk_rsa_public")
u8 *rawRsaPublic(u8 *n, i64 nLen, u8 *e, i64 eLen)

@extern("iris_pk_generate")
u8 *rawGenerate(i32 kind, i64 bits)

@extern("iris_pk_kind")
i32 rawKind(u8 *key, i64 *bits)

@extern("iris_pk_export")
i32 rawExport(u8 *key, i32 private, i32 der, String *out)

@extern("iris_pk_free")
void rawKeyFree(u8 *key)

@extern("iris_pk_sign")
i32 rawSign(u8 *key, u8 *data, i64 len, i32 hash, i32 pss, String *out)

@extern("iris_pk_verify")
i32 rawVerify(u8 *key, u8 *data, i64 len, u8 *sig, i64 sigLen, i32 hash, i32 pss)

@extern("iris_ecdsa_der_to_raw")
i32 rawDerToRaw(u8 *d, i64 n, i64 size, String *out)

@extern("iris_ecdsa_raw_to_der")
void rawRawToDer(u8 *raw, i64 n, String *out)

@extern("iris_tls_message_ptr")
u8 *rawMessagePtr()

@extern("iris_tls_message_len")
i64 rawMessageLen()

str keyMessage() => rawMessagePtr()[0:rawMessageLen()]

// The kinds of key for ECDSA and RSA signatures: ECDSA on the curves
// P-256, P-384 and P-521, and RSA.
pub enum KeyType { ecP256, ecP384, ecP521, rsa, other }

// The hash a signature is made over.
pub enum Hash { sha1, sha256, sha384, sha512 }

// RSA's padding: PKCS#1 v1.5, as most certificates and DNSSEC use, or PSS,
// as TLS 1.3 and QUIC do. ECDSA has none.
pub enum Padding { pkcs1, pss }

// A private key for ECDSA or RSA signatures. free gives it back.
pub struct PrivateKey {
    u8 *k
}

// A public key, to check ECDSA or RSA signatures with.
pub struct PublicKey {
    u8 *k
}

i32 hashCode(Hash h) => match h {
    .sha1 => 0
    .sha256 => 1
    .sha384 => 2
    .sha512 => 3
}

KeyType typeOf(u8 *k) {
    i64 bits
    kind := rawKind(k, &bits)
    if kind == 1 {
        return if bits <= 256 { KeyType.ecP256 } else if bits <= 384 { KeyType.ecP384 } else { KeyType.ecP521 }
    }
    return if kind == 2 { KeyType.rsa } else { KeyType.other }
}

// A private key from PEM (PKCS#8, or EC and RSA keys in their own PEM) or
// DER, as openssl and ssh-keygen -m PEM write them.
pub !PrivateKey loadPrivateKey(str data) {
    k := rawLoadPrivate(data.ptr, data.len)
    if k == null {
        return error(CryptoError.badKey, keyMessage())
    }
    return PrivateKey{k: k}
}

// A public key from PEM or DER (a SubjectPublicKeyInfo, as in a
// certificate).
pub !PublicKey loadPublicKey(str data) {
    k := rawLoadPublic(data.ptr, data.len)
    if k == null {
        return error(CryptoError.badKey, keyMessage())
    }
    return PublicKey{k: k}
}

// An ECDSA public key from its point: 04 then x and y, or x and y alone,
// as DNSSEC's DNSKEY records and JSON Web Keys hold it. curve is ecP256,
// ecP384 or ecP521.
pub !PublicKey ecPublicKey(KeyType curve, str point) {
    if curve != .ecP256 && curve != .ecP384 && curve != .ecP521 {
        return error(CryptoError.badKey, "an EC point needs the curve ecP256, ecP384 or ecP521")
    }
    k := rawEcPublic(match curve {
        .ecP256 => 0
        .ecP384 => 1
        _ => 2
    }, point.ptr, point.len)
    if k == null {
        return error(CryptoError.badKey, keyMessage())
    }
    return PublicKey{k: k}
}

// An RSA public key from its modulus n and its exponent e, as big-endian
// bytes, as DNSSEC's DNSKEY records hold them.
pub !PublicKey rsaPublicKey(str n, str e) {
    k := rawRsaPublic(n.ptr, n.len, e.ptr, e.len)
    if k == null {
        return error(CryptoError.badKey, keyMessage())
    }
    return PublicKey{k: k}
}

// A new private key of type: ecP256, ecP384, ecP521, or rsa of bits (2048
// or more). It needs OpenSSL 3.
pub !PrivateKey generateKey(KeyType t, i64 bits = 2048) {
    if t == .other {
        return error(CryptoError.badKey, "no key of type other")
    }
    k := rawGenerate(match t {
        .ecP256 => 0
        .ecP384 => 1
        .ecP521 => 3
        _ => 2
    }, bits)
    if k == null {
        return error(CryptoError.badKey, keyMessage())
    }
    return PrivateKey{k: k}
}

// The key's kind: ecP256, ecP384, ecP521 or rsa.
pub KeyType PrivateKey.kind() => typeOf(self.k)

// The key's kind: ecP256, ecP384, ecP521 or rsa.
pub KeyType PublicKey.kind() => typeOf(self.k)

// The public half of the key.
pub PublicKey PrivateKey.publicKey() {
    scoped String der
    _ = rawExport(self.k, 0, 1, &der)
    return PublicKey{k: rawLoadPublic(der.ptr, der.len)}
}

// The key in PEM, PKCS#8, unencrypted: keep it where only its owner reads.
pub String PrivateKey.pem() {
    String out
    _ = rawExport(self.k, 1, 0, &out)
    return out
}

// The key in PEM (BEGIN PUBLIC KEY).
pub String PublicKey.pem() {
    String out
    _ = rawExport(self.k, 0, 0, &out)
    return out
}

// The key in DER, as a SubjectPublicKeyInfo.
pub String PublicKey.der() {
    String out
    _ = rawExport(self.k, 0, 1, &out)
    return out
}

// Signs data, hashed with hash: ECDSA's signature in DER (ecdsaRaw turns
// it into r and s), or RSA's with padding.
pub !String PrivateKey.sign(str data, Hash hash = .sha256, Padding padding = .pkcs1) {
    String out
    if rawSign(self.k, data.ptr, data.len, hashCode(hash), if padding == .pss { 1 } else { 0 }, &out) == 0 {
        out.free()
        return error(CryptoError.badKey, keyMessage())
    }
    return out
}

// Whether signature is the key's signature of data, hashed with hash: in
// DER for ECDSA (ecdsaDer makes one from r and s), with padding for RSA.
pub bool PublicKey.verify(str data, str signature, Hash hash = .sha256, Padding padding = .pkcs1) {
    return rawVerify(self.k, data.ptr, data.len, signature.ptr, signature.len, hashCode(hash),
        if padding == .pss { 1 } else { 0 }) != 0
}

// Gives the key back.
pub void PrivateKey.free() {
    rawKeyFree(self.k)
    self.k = null
}

// Gives the key back.
pub void PublicKey.free() {
    rawKeyFree(self.k)
    self.k = null
}

// An ECDSA signature in DER as r and s of size bytes each (32 for P-256,
// 48 for P-384, 66 for P-521), as DNSSEC and JSON Web Tokens carry it.
pub !String ecdsaRaw(str der, i64 size) {
    String out
    if rawDerToRaw(der.ptr, der.len, size, &out) == 0 {
        out.free()
        return error(CryptoError.badKey, "not an ECDSA signature in DER of {size}-byte numbers")
    }
    return out
}

// An ECDSA signature given as r and s, of the same size each, in DER.
pub String ecdsaDer(str raw) {
    if raw.len == 0 || raw.len % 2 != 0 || raw.len > 132 {
        panic("an ECDSA signature as r and s has two halves of the same size, not {raw.len} bytes")
    }
    String out
    rawRawToDer(raw.ptr, raw.len, &out)
    return out
}

@extern("iris_pk_encrypt_oaep")
i32 rawEncryptOaep(u8 *key, u8 *data, i64 len, i32 hash, String *out)

// data encrypted with an RSA key, with OAEP padding over hash (sha1, as
// MySQL uses it, or sha256). data must be shorter than the key's size in
// bytes less 42 (sha1) or 66 (sha256).
pub !String PublicKey.encrypt(str data, Hash hash = .sha1) {
    if hash != .sha1 && hash != .sha256 {
        return error(CryptoError.badKey, "OAEP here is over sha1 or sha256")
    }
    String out
    if rawEncryptOaep(self.k, data.ptr, data.len, hashCode(hash), &out) == 0 {
        out.free()
        return error(CryptoError.badKey, keyMessage())
    }
    return out
}
