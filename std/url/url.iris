// URLs: taking them apart, and the %XX encoding of their parts.

pub enum UrlError { invalid }

// The parts of a URL, as views into the text it was read from:
// https://ada:pw@example.com:8443/docs/a?q=1#top has scheme "https", user
// "ada:pw", host "example.com", port 8443, path "/docs/a", query "q=1" and
// fragment "top".
pub struct Url {
    pub str scheme
    pub str user
    pub str host
    pub i64 port
    pub str path
    pub str query
    pub str fragment
}

i64 defaultPort(str scheme) => if scheme == "https" { 443 } else if scheme == "http" { 80 } else { 0 }

// Takes a URL apart. port is the scheme's usual one when none is written.
pub !Url parse(str text) {
    Url u
    rest := text
    for i in 0..rest.len {
        if rest[i] == ':' && i + 2 < rest.len && rest[i + 1] == '/' && rest[i + 2] == '/' {
            u.scheme = rest[0:i]
            rest = rest[i + 3:]
            break
        }
        if rest[i] == '/' || rest[i] == '?' || rest[i] == '#' {
            break
        }
    }
    if u.scheme.len == 0 && text.len > 0 && text[0] != '/' {
        return error(UrlError.invalid, "'{text}' has no scheme (like https://) and isn't a path")
    }
    for i in 0..rest.len {
        if rest[i] == '#' {
            u.fragment = rest[i + 1:]
            rest = rest[0:i]
            break
        }
    }
    for i in 0..rest.len {
        if rest[i] == '?' {
            u.query = rest[i + 1:]
            rest = rest[0:i]
            break
        }
    }
    authority := rest
    if u.scheme.len > 0 {
        i := 0
        for i < rest.len && rest[i] != '/' {
            i += 1
        }
        authority = rest[0:i]
        u.path = rest[i:]
    } else {
        authority = ""
        u.path = rest
    }
    for i in 0..authority.len {
        if authority[i] == '@' {
            u.user = authority[0:i]
            authority = authority[i + 1:]
            break
        }
    }
    u.host = authority
    u.port = defaultPort(u.scheme)
    i := authority.len
    for i > 0 && authority[i - 1] >= '0' && authority[i - 1] <= '9' {
        i -= 1
    }
    if i > 0 && i < authority.len && authority[i - 1] == ':' {
        i64 p
        for k in i..authority.len {
            p = p * 10 + i64(authority[k] - '0')
        }
        if p < 1 || p > 65535 {
            return error(UrlError.invalid, "'{text}' has a port out of range")
        }
        u.port = p
        u.host = authority[0:i - 1]
    }
    if u.scheme.len > 0 && u.host.len == 0 {
        return error(UrlError.invalid, "'{text}' has no host")
    }
    return u
}

bool plain(u8 c) => (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') ||
    c == '-' || c == '_' || c == '.' || c == '~'

const DIGITS = "0123456789ABCDEF"

// text with every character but letters, digits and -_.~ as %XX, for a
// query value or a part of a path.
pub String encode(str text) {
    String out
    for i in 0..text.len {
        c := text[i]
        if plain(c) {
            out.append(text[i:i + 1])
        } else {
            b := i64(c)
            out.append("%")
            out.append(DIGITS[b >> 4:(b >> 4) + 1])
            out.append(DIGITS[b & 15:(b & 15) + 1])
        }
    }
    return out
}

i64 hexDigit(u8 c) {
    if c >= '0' && c <= '9' {
        return i64(c - '0')
    }
    if c >= 'a' && c <= 'f' {
        return i64(c - 'a') + 10
    }
    if c >= 'A' && c <= 'F' {
        return i64(c - 'A') + 10
    }
    return -1
}

// The text with %XX turned back into bytes and + into spaces, as query
// values are sent.
pub !String decode(str text) {
    String out
    errdefer out.free()
    i := 0
    for i < text.len {
        c := text[i]
        if c == '%' {
            if i + 2 >= text.len {
                return error(UrlError.invalid, "'{text}' ends in the middle of a %XX")
            }
            hi := hexDigit(text[i + 1])
            lo := hexDigit(text[i + 2])
            if hi < 0 || lo < 0 {
                return error(UrlError.invalid, "'{text[i:i + 3]}' isn't a %XX")
            }
            u8[1] b = [u8(hi * 16 + lo)]
            out.append(b)
            i += 3
        } else if c == '+' {
            out.append(" ")
            i += 1
        } else {
            out.append(text[i:i + 1])
            i += 1
        }
    }
    return out
}
