// Running other programs.

import net

// What run fails with: notFound for a program that isn't there, failed when it
// can't be started.
pub enum ProcessError { notFound, failed }

// What a program wrote, and its exit status. free gives the text back.
pub struct Output {
    pub String stdout
    pub String stderr
    pub i32 status
}

// Whether the program ended with status 0.
pub bool Output.ok() => self.status == 0

// Frees what the program printed.
pub void Output.free() {
    self.stdout.free()
    self.stderr.free()
}

@extern("iris_process_run")
i32 rawRun(str *argv, i64 argc, u8 *input, i64 inputLen, String *out, String *err, i32 *status)

// Runs argv[0] with the arguments that follow, finds it on PATH when it
// has no /, gives it input on its standard input, and waits for it to end.
// The other tasks of the thread run meanwhile. A program that ends with a
// status other than 0 is no error: see status.
pub !Output run(str[] argv, str input = "") {
    if argv.len == 0 {
        return error(ProcessError.notFound, "run needs the program's name")
    }
    Output o
    code := rawRun(argv.ptr, argv.len, input.ptr, input.len, &o.stdout, &o.stderr, &o.status)
    if code == 1 {
        o.free()
        return error(ProcessError.notFound, "{argv[0]}: no such program")
    }
    if code != 0 {
        o.free()
        return error(ProcessError.failed, "{argv[0]}: can't be started")
    }
    return o
}

@extern("iris_process_start")
i32 rawStart(str *argv, i64 argc, i32 *keep, i64 nkeep, i64 *pid, i32 *handle)

@extern("iris_process_poll")
i32 rawPoll(i64 pid, i32 *status)

@extern("iris_process_wait")
i32 rawWaitChild(i64 pid, i32 handle)

@extern("iris_process_signal")
void rawSignal(i64 pid, i32 kill9)

@extern("iris_process_release")
void rawRelease(i32 handle)

// A program that start runs beside this one. pid is its process id, and
// with Options.pipes, stdin, stdout and stderr are the other ends of its
// standard input, output and error.
pub struct Child {
    pub i64 pid
    i32 handle
    bool ended
    i32 status
    pub net.Conn stdin
    pub net.Conn stdout
    pub net.Conn stderr
}

// How startWith starts a program. Each field's zero value is what start
// does.
pub struct Options {
    // descriptors the program gets as 3, 4 and so on
    pub i32[] keep
    // NAME=value entries that replace or add to this program's environment,
    // or are the whole of it with cleanEnv
    pub str[] env
    pub bool cleanEnv
    // the folder it starts in
    pub str dir
    // its argv[0], when it isn't argv's first: "-bash" starts a login shell
    pub str argv0
    // its standard input, output and error as Conns on the Child
    pub bool pipes
    // a session and process group of its own, as a daemon or a job has
    pub bool newSession
    // the user it runs as, in that user's groups (root only)
    pub str user
    // a pty's terminalFd(): its standard input, output and error and its
    // controlling terminal, in a session of its own (-1, the start, none)
    pub i32 terminal = -1
}

@extern("iris_process_spawn")
i32 rawSpawn(str *argv, i64 argc, i32 *keep, i64 nkeep, str *env, i64 nenv, i32 cleanEnv, u8 *dir, i64 dirLen,
    u8 *argv0, i64 argv0Len, i32 pipes, i32 newSession, u8 *user, i64 userLen, i32 terminal, i64 *pid, i32 *handle,
    i32 *io)

// Starts argv[0] as start does, set up as o says: in a folder, with an
// environment, as another user, on a terminal, with its standard streams
// as connections to read and write.
pub !Child startWith(str[] argv, Options o) {
    if argv.len == 0 {
        return error(ProcessError.notFound, "startWith needs the program's name")
    }
    if o.keep.len > 256 {
        return error(ProcessError.failed, "{argv[0]}: at most 256 descriptors can be kept")
    }
    Child c
    i32[3] io
    code := rawSpawn(argv.ptr, argv.len, o.keep.ptr, o.keep.len, o.env.ptr, o.env.len, if o.cleanEnv { 1 } else { 0 },
        o.dir.ptr, o.dir.len, o.argv0.ptr, o.argv0.len, if o.pipes { 1 } else { 0 }, if o.newSession { 1 } else { 0 },
        o.user.ptr, o.user.len, o.terminal, &c.pid, &c.handle, &io[0])
    if code == 1 {
        return error(ProcessError.notFound, "{argv[0]}: no such program")
    }
    if code == 3 {
        return error(ProcessError.failed, "{argv[0]}: no user {o.user}")
    }
    if code != 0 {
        return error(ProcessError.failed, "{argv[0]}: can't be started")
    }
    if o.pipes {
        c.stdin = try net.adoptConn(io[0])
        c.stdout = try net.adoptConn(io[1])
        c.stderr = try net.adoptConn(io[2])
    }
    return c
}

// Closes the connections to the program's standard streams that pipes
// made; wait doesn't close them.
pub void Child.closePipes() {
    for c in [&self.stdin, &self.stdout, &self.stderr] {
        if c.fd() > 0 {
            c.close()
        }
    }
}

// Starts argv[0] with the arguments that follow, as run does, and doesn't
// wait for it: it shares this program's standard input, output and error,
// and its environment. keep are descriptors it gets as 3, 4 and so on, in
// order: a server passes its listening sockets to its next version this
// way, which takes the first with net.adoptListener(3).
pub !Child start(str[] argv, i32[] keep = []) {
    if argv.len == 0 {
        return error(ProcessError.notFound, "start needs the program's name")
    }
    if keep.len > 256 {
        return error(ProcessError.failed, "{argv[0]}: at most 256 descriptors can be kept")
    }
    Child c
    code := rawStart(argv.ptr, argv.len, keep.ptr, keep.len, &c.pid, &c.handle)
    if code == 1 {
        return error(ProcessError.notFound, "{argv[0]}: no such program")
    }
    if code != 0 {
        return error(ProcessError.failed, "{argv[0]}: can't be started")
    }
    return c
}

// Waits for the program to end, while the other tasks run, and gives its
// exit status: 128 + the signal's number when a signal ended it.
pub i32 Child.wait() {
    if !self.ended {
        self.status = rawWaitChild(self.pid, self.handle)
        self.ended = true
        self.handle = -1
    }
    return self.status
}

// Whether the program still runs. Once it ended, wait gives its status
// at once.
pub bool Child.running() {
    if self.ended {
        return false
    }
    if rawPoll(self.pid, &self.status) == 0 {
        return true
    }
    self.ended = true
    rawRelease(self.handle)
    self.handle = -1
    return false
}

// Asks the program to stop (SIGTERM).
pub void Child.stop() {
    if !self.ended {
        rawSignal(self.pid, 0)
    }
}

// Ends the program at once (SIGKILL).
pub void Child.kill() {
    if !self.ended {
        rawSignal(self.pid, 1)
    }
}
