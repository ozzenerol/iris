// Log lines on standard error, with the time and a level:
// 2026-10-17T09:30:00.250Z INFO listening on 8080
// Each line is written at once, so lines from several threads don't mix.
// They can go to a file instead, or to the system log (syslog).

import fs, io, json, time

// How much a line matters. setLevel hides the lines below a level.
pub enum Level { debug, info, warn, error }

// The value of a field: log.info("signed in", [("user", .text(name)), ("id", .int(7))]).
pub enum Value { int(i64 v), float(f64 v), text(str v), bool(bool v) }

Level minimum = .info
bool asJson
bool noTime
bool toFileOn
bool toSyslogOn
fs.File out

// Where syslog files a program's lines: user, daemon (servers), auth and
// authPriv (logins, as SSH servers use), and local0 to local7 for a site's
// own uses.
pub enum Facility { user, daemon, auth, authPriv, local0, local1, local2, local3, local4, local5, local6, local7 }

@extern("iris_syslog_open")
void rawSyslogOpen(u8 *ident, i64 identLen, i32 facility)

@extern("iris_syslog_write")
void rawSyslogWrite(i32 priority, u8 *msg, i64 len)

@extern("iris_syslog_close")
void rawSyslogClose()

i32 facilityCode(Facility f) => match f {
    .user => 0
    .daemon => 1
    .auth => 2
    .authPriv => 3
    .local0 => 4
    .local1 => 5
    .local2 => 6
    .local3 => 7
    .local4 => 8
    .local5 => 9
    .local6 => 10
    .local7 => 11
}

// Lines below level are left out. The start is info.
pub void setLevel(Level level) {
    minimum = level
}

// Writes each line as a JSON object instead:
// {"time": "...", "level": "info", "message": "...", "user": "ada"}.
pub void useJson(bool on = true) {
    asJson = on
}

// Whether lines start with the time. Off suits a program run by systemd or
// Docker, which add the time themselves.
pub void showTime(bool on = true) {
    noTime = !on
}

// Writes the lines at the end of the file at path, making it if needed,
// instead of on standard error.
pub !void toFile(str path) {
    f := try fs.openAppend(path)
    if toFileOn {
        out.close()
    }
    out = f
    toFileOn = true
}

// Writes the lines on standard error again, closing the file of toFile or
// leaving syslog.
pub void toStderr() {
    if toFileOn {
        out.close()
        toFileOn = false
    }
    if toSyslogOn {
        rawSyslogClose()
        toSyslogOn = false
    }
}

// Sends the lines to the system log (syslog) as facility, each with ident
// (the program's name when "") and the process id: journald, rsyslog or
// macOS's log keep them, and tools like fail2ban read them. The level
// becomes syslog's priority; syslog adds the time itself.
pub void toSyslog(str ident = "", Facility facility = .daemon) {
    if toFileOn {
        out.close()
        toFileOn = false
    }
    rawSyslogOpen(ident.ptr, ident.len, facilityCode(facility))
    toSyslogOn = true
}

// syslog's priority for a level
i32 priority(Level l) => match l {
    .debug => 7
    .info => 6
    .warn => 4
    .error => 3
}

i64 rank(Level l) => match l {
    .debug => 0
    .info => 1
    .warn => 2
    .error => 3
}

str name(Level l) => match l {
    .debug => "DEBUG"
    .info => "INFO"
    .warn => "WARN"
    .error => "ERROR"
}

str lower(Level l) => match l {
    .debug => "debug"
    .info => "info"
    .warn => "warn"
    .error => "error"
}

// Whether text can go after key= as it is: no spaces, quotes or =.
bool plain(str s) {
    if s.len == 0 {
        return false
    }
    for c in s {
        if c <= ' ' || c == '"' || c == '=' || c == 127 {
            return false
        }
    }
    return true
}

void addValue(String *line, Value v, bool quoted) {
    match v {
        .int(n) => line.append("{n}")
        .float(x) => line.append("{x}")
        .bool(b) => line.append("{b}")
        .text(s) => {
            if quoted || !plain(s) {
                scoped String q = json.quote(s)
                line.append(q)
            } else {
                line.append(s)
            }
        }
    }
}

// Writes a line at level, if the level isn't left out. Each field goes after
// the message as key=value, text in quotes when it has spaces.
pub void write(Level level, str message, (str, Value)[] fields = []) {
    if rank(level) < rank(minimum) {
        return
    }
    if toSyslogOn {
        scoped String sl
        if asJson {
            scoped String m = json.quote(message)
            sl.append("{{\"level\": \"{lower(level)}\", \"message\": {m}")
            for f in fields {
                k, v := f
                scoped String key = json.quote(k)
                sl.append(", {key}: ")
                addValue(&sl, v, true)
            }
            sl.append("}}")
        } else {
            sl.append(message)
            for f in fields {
                k, v := f
                sl.append(" {k}=")
                addValue(&sl, v, false)
            }
        }
        rawSyslogWrite(priority(level), sl.ptr, sl.len)
        return
    }
    scoped String stamp = time.now().format("YYYY-MM-DDThh:mm:ss.SSSZ")
    scoped String line
    if asJson {
        line.append("{{")
        if !noTime {
            line.append("\"time\": \"{stamp}\", ")
        }
        scoped String m = json.quote(message)
        line.append("\"level\": \"{lower(level)}\", \"message\": {m}")
        for f in fields {
            k, v := f
            scoped String key = json.quote(k)
            line.append(", {key}: ")
            addValue(&line, v, true)
        }
        line.append("}}\n")
    } else {
        if !noTime {
            line.append("{stamp} ")
        }
        line.append("{name(level)} {message}")
        for f in fields {
            k, v := f
            line.append(" {k}=")
            addValue(&line, v, false)
        }
        line.append("\n")
    }
    if toFileOn {
        out.write(line) catch e {
            io.ewrite(line)
        }
        return
    }
    io.ewrite(line)
}

// Writes message at the debug level: details for finding a problem.
pub void debug(str message, (str, Value)[] fields = []) => write(.debug, message, fields)

// Writes message at the info level: what the program is doing.
pub void info(str message, (str, Value)[] fields = []) => write(.info, message, fields)

// Writes message at the warn level: something went wrong, and the program goes
// on.
pub void warn(str message, (str, Value)[] fields = []) => write(.warn, message, fields)

// Writes message at the error level: something failed.
pub void error(str message, (str, Value)[] fields = []) => write(.error, message, fields)
