// Log lines on standard error, with the time and a level:
// 2026-10-17T09:30:00.250Z INFO listening on 8080
// Each line is written at once, so lines from several threads don't mix.

import io, json, time

pub enum Level { debug, info, warn, error }

Level minimum = .info
bool asJson

// Lines below level are left out. The start is info.
pub void setLevel(Level level) {
    minimum = level
}

// Writes each line as a JSON object instead:
// {"time": "...", "level": "info", "message": "..."}.
pub void useJson(bool on = true) {
    asJson = on
}

i64 rank(Level l) => match l {
    .debug => 0
    .info => 1
    .warn => 2
    .error => 3
}

str name(Level l) => match l {
    .debug => "DEBUG"
    .info => "INFO"
    .warn => "WARN"
    .error => "ERROR"
}

str lower(Level l) => match l {
    .debug => "debug"
    .info => "info"
    .warn => "warn"
    .error => "error"
}

// Writes a line at level, if the level isn't left out.
pub void write(Level level, str message) {
    if rank(level) < rank(minimum) {
        return
    }
    scoped String stamp = time.now().format("YYYY-MM-DDThh:mm:ss.SSSZ")
    if asJson {
        scoped String m = json.quote(message)
        scoped String line = format("{{\"time\": \"{stamp}\", \"level\": \"{lower(level)}\", \"message\": {m}}}\n")
        io.ewrite(line)
        return
    }
    scoped String line = format("{stamp} {name(level)} {message}\n")
    io.ewrite(line)
}

pub void debug(str message) => write(.debug, message)

pub void info(str message) => write(.info, message)

pub void warn(str message) => write(.warn, message)

pub void error(str message) => write(.error, message)
