// TCP and UDP: listening, connecting, reading and writing, also over TLS,
// and looking up names. A task that waits for the network lets the other
// tasks run.

import time

// What network calls fail with: refused, closed, timeout, notFound (for a name
// that doesn't resolve), inUse (for an address taken already), tls, tooLong
// (for a line past its limit), and other.
pub enum NetError { refused, closed, timeout, notFound, inUse, other, tls, tooLong }

@extern("iris_net_listen")
i32 rawListen(u8 *host, i64 hostLen, i64 port, i32 shared, i32 *err)

@extern("iris_net_port")
i64 rawPort(i32 fd)

@extern("iris_net_accept")
i32 rawAccept(i32 fd, i32 *err, i64 timeout)

@extern("iris_net_dial")
i32 rawDial(u8 *host, i64 hostLen, i64 port, i32 *err, i64 timeout)

@extern("iris_net_read")
i64 rawRead(i32 fd, u8 *buf, i64 len, i64 timeout)

@extern("iris_net_write")
i32 rawWrite(i32 fd, u8 *buf, i64 len, i64 timeout)

@extern("iris_net_close")
void rawClose(i32 fd)

@extern("iris_net_shutdown")
void rawShutdown(i32 fd)

@extern("iris_tls_connect")
u8 *rawTlsConnect(i32 fd, u8 *host, i64 hostLen, u8 *ca, i64 caLen, u8 *alpn, i64 alpnLen, u8 *cert, i64 certLen,
    u8 *key, i64 keyLen)

@extern("iris_tls_ctx_http2")
void rawTlsHttp2(u8 *ctx)

@extern("iris_tls_alpn")
void rawTlsAlpn(u8 *ssl, u8 **p, i64 *n)

@extern("iris_tls_server_ctx")
u8 *rawTlsServerCtx(u8 *cert, i64 certLen, u8 *key, i64 keyLen)

@extern("iris_tls_ctx_free")
void rawTlsCtxFree(u8 *ctx)

@extern("iris_tls_accept")
u8 *rawTlsAccept(u8 *ctx, i32 fd, i64 timeout)

@extern("iris_tls_read")
i64 rawTlsRead(u8 *ssl, u8 *buf, i64 len, i64 timeout)

@extern("iris_tls_write")
i32 rawTlsWrite(u8 *ssl, u8 *data, i64 len, i64 timeout)

@extern("iris_tls_close")
void rawTlsClose(u8 *ssl)

@extern("iris_tls_server_add")
i32 rawTlsServerAdd(u8 *ctx, u8 *cert, i64 certLen, u8 *key, i64 keyLen)

@extern("iris_tls_server_reload")
i32 rawTlsServerReload(u8 *ctx)

@extern("iris_tls_server_clients")
i32 rawTlsServerClients(u8 *ctx, u8 *ca, i64 caLen, i32 required)

@extern("iris_tls_server_alpn")
i32 rawTlsServerAlpn(u8 *ctx, u8 *protos, i64 len)

@extern("iris_tls_server_name")
void rawTlsServerName(u8 *ssl, u8 **p, i64 *n)

@extern("iris_tls_peer_subject")
i32 rawTlsPeerSubject(u8 *ssl, String *out)

@extern("iris_tls_close_write")
i32 rawTlsCloseWrite(u8 *ssl, i64 timeout)

@extern("iris_tls_message_ptr")
u8 *tlsMessagePtr()

@extern("iris_tls_message_len")
i64 tlsMessageLen()

str tlsMessage() => tlsMessagePtr()[0:tlsMessageLen()]

NetError netCode(i32 code) => match code {
    1 => NetError.refused
    2 => NetError.closed
    3 => NetError.timeout
    4 => NetError.notFound
    5 => NetError.inUse
    7 => NetError.tls
    _ => NetError.other
}

str reason(i32 code) => match code {
    1 => "connection refused"
    2 => "connection closed"
    3 => "timed out"
    4 => "no such host"
    5 => "address in use"
    7 => tlsMessage()
    _ => "network error"
}

// A socket that accepts connections.
pub struct Listener {
    i32 sock
    pub u16 port
}

// A connection. Reads go through a buffer, so lines can be read one at a time.
// received and sent count the bytes that came in and went out, over TLS the
// bytes of the data.
pub struct Conn {
    i32 sock
    u8[] buf
    i64 start
    i64 end
    u8 *tls
    Duration timeout
    pub i64 received
    pub i64 sent
}

// Each read and write after this fails with NetError.timeout when it waits
// longer than d; 0 is the start, no limit.
pub void Conn.setTimeout(Duration d) {
    self.timeout = d
}

i64 Conn.rawRead(u8[] buf) {
    n := if self.tls != null {
        rawTlsRead(self.tls, buf.ptr, buf.len, self.timeout)
    } else {
        rawRead(self.sock, buf.ptr, buf.len, self.timeout)
    }
    if n > 0 {
        self.received += n
    }
    return n
}

// Listens on port (0 picks a free one; see .port) on host ("" for all
// addresses, IPv6 and IPv4). shared lets several threads, or programs,
// listen on the same port. A Socket sets up the rest: options before it
// binds, the backlog.
pub !Listener listen(u16 port, str host = "", bool shared = false) {
    i32 err
    fd := rawListen(host.ptr, host.len, i64(port), if shared { 1 } else { 0 }, &err)
    if fd < 0 {
        return error(netCode(err), "listening on port {port}: {reason(err)}")
    }
    return Listener{sock: fd, port: u16(rawPort(fd))}
}

// Waits for the next connection, for at most timeout when it isn't 0.
pub !Conn Listener.accept(Duration timeout = 0s) {
    i32 err
    fd := rawAccept(self.sock, &err, timeout)
    if fd < 0 {
        return error(netCode(err), "accepting a connection: {reason(err)}")
    }
    return Conn{sock: fd, buf: alloc(u8, 16KiB)}
}

// The listener's file descriptor, for socket options and calls through
// import c. Accepting on it or closing it directly breaks the listener.
pub i32 Listener.fd() => self.sock

// Stops listening and closes the socket.
pub void Listener.close() => rawClose(self.sock)

// Wakes a task that waits in accept, which then fails: for stopping a
// server.
pub void Listener.interrupt() => rawShutdown(self.sock)

// Connects to host:port, waiting at most timeout when it isn't 0. host is
// a name or an IP. Each of the name's addresses is tried in turn until one
// answers.
pub !Conn dial(str host, u16 port, Duration timeout = 0s) {
    start := time.clock()
    addrs := lookup(host) catch e {
        // a name only the system knows (mDNS, a VPN's own servers): its
        // resolver, which keeps the thread waiting
        i32 err
        fd := rawDial(host.ptr, host.len, i64(port), &err, timeout)
        if fd < 0 {
            return error(netCode(err), "connecting to {host}:{port}: {reason(err)}")
        }
        return Conn{sock: fd, buf: alloc(u8, 16KiB)}
    }
    defer addrs.free()
    i32 err = 4
    for a in addrs {
        left := timeout
        if timeout > 0s {
            left = timeout - (time.clock() - start)
            if left <= 0s {
                err = 3
                break
            }
        }
        fd := rawDialIp(&a.ip[0], i64(port), &err, left)
        if fd >= 0 {
            return Conn{sock: fd, buf: alloc(u8, 16KiB)}
        }
    }
    return error(netCode(err), "connecting to {host}:{port}: {reason(err)}")
}

// Connects to an address, waiting at most timeout when it isn't 0.
pub !Conn dialAddr(Addr addr, Duration timeout = 0s) {
    i32 err
    fd := rawDialIp(&addr.ip[0], i64(addr.port), &err, timeout)
    if fd < 0 {
        scoped String where = addr.format()
        return error(netCode(err), "connecting to {where}: {reason(err)}")
    }
    return Conn{sock: fd, buf: alloc(u8, 16KiB)}
}

// Reads into buf: the number of bytes, 0 when the other side has closed.
pub !i64 Conn.read(u8[] buf) {
    if self.start < self.end {
        n := if self.end - self.start < buf.len { self.end - self.start } else { buf.len }
        for i in 0..n {
            buf[i] = self.buf[self.start + i]
        }
        self.start += n
        return n
    }
    n := self.rawRead(buf)
    if n < 0 {
        return error(netCode(i32(-n)), "reading: {reason(i32(-n))}")
    }
    return n
}

// Fills the buffer when it is empty. False at the end of the data.
!bool Conn.fill() {
    if self.start < self.end {
        return true
    }
    n := self.rawRead(self.buf)
    if n < 0 {
        return error(netCode(i32(-n)), "reading: {reason(i32(-n))}")
    }
    self.start = 0
    self.end = n
    return n > 0
}

// The next line, without its line break (\n or \r\n). NetError.closed at the
// end; NetError.tooLong when limit isn't 0 and the line is longer.
pub !String Conn.readLine(i64 limit = 0) {
    String line
    for {
        if limit > 0 && line.len > limit {
            line.free()
            return error(NetError.tooLong, "reading a line: longer than {limit} bytes")
        }
        more := try self.fill()
        if !more {
            if line.len > 0 {
                return line
            }
            line.free()
            return error(NetError.closed, "reading a line: connection closed")
        }
        for i in self.start..self.end {
            if self.buf[i] == '\n' {
                line.append(self.buf[self.start:i])
                self.start = i + 1
                if limit > 0 && line.len > limit + 1 {
                    line.free()
                    return error(NetError.tooLong, "reading a line: longer than {limit} bytes")
                }
                if line.len > 0 && line.ptr[0:line.len][line.len - 1] == '\r' {
                    String trimmed = line.ptr[0:line.len - 1].copy()
                    line.free()
                    return trimmed
                }
                return line
            }
        }
        line.append(self.buf[self.start:self.end])
        self.start = self.end
    }
}

// Reads exactly n bytes into a new String.
pub !String Conn.readExactly(i64 n) {
    String out
    for out.len < n {
        more := try self.fill()
        if !more {
            out.free()
            return error(NetError.closed, "reading: connection closed")
        }
        take := if self.end - self.start < n - out.len { self.end - self.start } else { n - out.len }
        out.append(self.buf[self.start:self.start + take])
        self.start += take
    }
    return out
}

// Writes all of data.
pub !void Conn.write(str data) {
    code := if self.tls != null {
        rawTlsWrite(self.tls, data.ptr, data.len, self.timeout)
    } else {
        rawWrite(self.sock, data.ptr, data.len, self.timeout)
    }
    if code != 0 {
        return error(netCode(code), "writing: {reason(code)}")
    }
    self.sent += data.len
}

// The address of the other side: the client on a server, the server on a
// client. All zeros once the connection is gone.
pub Addr Conn.remoteAddr() {
    Addr a
    i64 port
    rawRemote(self.sock, &a.ip[0], &port)
    a.port = u16(port)
    return a
}

// The address of this side of the connection.
pub Addr Conn.localAddr() {
    Addr a
    i64 port
    rawLocal(self.sock, &a.ip[0], &port)
    a.port = u16(port)
    return a
}

// The connection's file descriptor, for socket options and calls through
// import c. It belongs to the event loop and doesn't block: reading,
// writing or closing it directly, or making it blocking, breaks the
// connection and can stall every task on the thread.
pub i32 Conn.fd() => self.sock

// Ends the connection's reads and writes from another task: a task that
// waits on it wakes up as if the other side had closed. close still has to
// be called.
pub void Conn.interrupt() => rawShutdown(self.sock)

// Closes the connection.
pub void Conn.close() {
    if self.tls != null {
        rawTlsClose(self.tls)
        self.tls = null
    }
    rawClose(self.sock)
    if self.buf.len > 0 {
        free(self.buf)
        self.buf = alloc(u8, 0)
    }
}

// Connects to host:port over TLS. The server's certificate must be valid
// for host and signed by a certificate the system trusts, or one in the
// file ca (PEM) when ca is given. cert and key are the client's own
// certificate and key (PEM files), for servers that ask for one.
pub !Conn dialTls(str host, u16 port, str ca = "", str cert = "", str key = "") {
    c := try dial(host, port)
    c.startTls(host, ca, cert: cert, key: key) catch e {
        c.close()
        return e
    }
    return c
}

// Starts TLS as the client on a connection that is open, as dialTls does.
// host is the name, or the IP, the server's certificate must have; it
// can't be empty. A name is also sent to the server (SNI).
// protocols are offered to the server with ALPN, each with its length in
// front: "\x02h2\x08http/1.1"; protocol() says which one it took. cert and
// key are the client's own certificate and key; key "" means the key is in
// cert.
pub !void Conn.startTls(str host, str ca = "", str protocols = "", str cert = "", str key = "") {
    ssl := rawTlsConnect(self.sock, host.ptr, host.len, ca.ptr, ca.len, protocols.ptr, protocols.len, cert.ptr,
        cert.len, key.ptr, key.len)
    if ssl == null {
        return error(NetError.tls, "{host}: {tlsMessage()}")
    }
    self.tls = ssl
}

// The protocol the two sides of a TLS connection agreed on with ALPN, as
// "h2"; "" when they didn't.
pub str Conn.protocol() {
    u8 *p
    i64 n
    rawTlsAlpn(self.tls, &p, &n)
    return p[0:n]
}

// A server's certificates and keys, for accepting TLS connections. It can be
// shared by every thread, and changed while they use it, one change at a
// time: a handshake uses what it was when the handshake started. A change
// of settings keeps the certificates loaded already; only addCert, for its
// new one, and reload read files.
pub struct TlsConfig {
    u8 *ctx
}

// Reads a certificate chain and its private key from PEM files. This is
// the certificate for clients that ask for no name, or for a name no other
// certificate has.
pub !TlsConfig tlsConfig(str certFile, str keyFile) {
    ctx := rawTlsServerCtx(certFile.ptr, certFile.len, keyFile.ptr, keyFile.len)
    if ctx == null {
        return error(NetError.tls, tlsMessage())
    }
    return TlsConfig{ctx: ctx}
}

// Lets clients ask for HTTP/2 with ALPN; http's servers call it.
pub void TlsConfig.offerHttp2() => rawTlsHttp2(self.ctx)

// Adds a certificate and its key (PEM files), used for the clients that ask
// for a name it has (SNI). Its names come from the certificate, wildcards
// like *.example.com too.
pub !void TlsConfig.addCert(str certFile, str keyFile) {
    if rawTlsServerAdd(self.ctx, certFile.ptr, certFile.len, keyFile.ptr, keyFile.len) != 0 {
        return error(NetError.tls, tlsMessage())
    }
}

// Reads every certificate and key again from their files, as after they
// were renewed. Connections that are open keep the ones they had. On an
// error the config keeps the ones it had.
pub !void TlsConfig.reload() {
    if rawTlsServerReload(self.ctx) != 0 {
        return error(NetError.tls, tlsMessage())
    }
}

// Asks each client for a certificate signed by one in the file ca (PEM).
// With required, a client without one fails the handshake; without it, the
// client may send none. A certificate that isn't signed by ca always fails.
// peerSubject says who the client is.
pub !void TlsConfig.verifyClients(str ca, bool required = true) {
    if rawTlsServerClients(self.ctx, ca.ptr, ca.len, if required { 1 } else { 0 }) != 0 {
        return error(NetError.tls, tlsMessage())
    }
}

// The protocols offered with ALPN, each with its length in front:
// "\x02h2\x08http/1.1". The server takes the first of them that the client
// offers too.
pub !void TlsConfig.offerProtocols(str protocols) {
    if rawTlsServerAlpn(self.ctx, protocols.ptr, protocols.len) != 0 {
        return error(NetError.tls, tlsMessage())
    }
}

// Frees the certificate and the key.
pub void TlsConfig.free() {
    rawTlsCtxFree(self.ctx)
    self.ctx = null
}

// Starts TLS as the server on an accepted connection.
pub !void Conn.acceptTls(TlsConfig *config) {
    ssl := rawTlsAccept(config.ctx, self.sock, self.timeout)
    if ssl == null {
        return error(NetError.tls, tlsMessage())
    }
    self.tls = ssl
}

// The name the client asked for in its TLS handshake (SNI), on a server:
// "" when it asked for none.
pub str Conn.serverName() {
    u8 *p
    i64 n
    rawTlsServerName(self.tls, &p, &n)
    return p[0:n]
}

// The subject of the certificate the other side showed, as
// "/CN=client.example.com"; "" when it showed none.
pub String Conn.peerSubject() {
    String out
    _ = rawTlsPeerSubject(self.tls, &out)
    return out
}

// Lets the other tasks run.
pub void yield() => sleep(0ns)
