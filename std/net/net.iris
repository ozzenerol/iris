// TCP: listening for connections, connecting, reading and writing, also
// over TLS. A task that waits for the network lets the other tasks run.

pub enum NetError { refused, closed, timeout, notFound, inUse, other, tls, tooLong }

@extern("iris_net_listen")
i32 rawListen(u8 *host, i64 hostLen, i64 port, i32 shared, i32 *err)

@extern("iris_net_port")
i64 rawPort(i32 fd)

@extern("iris_net_accept")
i32 rawAccept(i32 fd, i32 *err, i64 timeout)

@extern("iris_net_dial")
i32 rawDial(u8 *host, i64 hostLen, i64 port, i32 *err, i64 timeout)

@extern("iris_net_read")
i64 rawRead(i32 fd, u8 *buf, i64 len, i64 timeout)

@extern("iris_net_write")
i32 rawWrite(i32 fd, u8 *buf, i64 len, i64 timeout)

@extern("iris_net_close")
void rawClose(i32 fd)

@extern("iris_net_shutdown")
void rawShutdown(i32 fd)

@extern("iris_tls_connect")
u8 *rawTlsConnect(i32 fd, u8 *host, i64 hostLen, u8 *ca, i64 caLen)

@extern("iris_tls_server_ctx")
u8 *rawTlsServerCtx(u8 *cert, i64 certLen, u8 *key, i64 keyLen)

@extern("iris_tls_ctx_free")
void rawTlsCtxFree(u8 *ctx)

@extern("iris_tls_accept")
u8 *rawTlsAccept(u8 *ctx, i32 fd, i64 timeout)

@extern("iris_tls_read")
i64 rawTlsRead(u8 *ssl, u8 *buf, i64 len, i64 timeout)

@extern("iris_tls_write")
i32 rawTlsWrite(u8 *ssl, u8 *data, i64 len, i64 timeout)

@extern("iris_tls_close")
void rawTlsClose(u8 *ssl)

@extern("iris_tls_message_ptr")
u8 *tlsMessagePtr()

@extern("iris_tls_message_len")
i64 tlsMessageLen()

str tlsMessage() => tlsMessagePtr()[0:tlsMessageLen()]

NetError netCode(i32 code) => match code {
    1 => NetError.refused
    2 => NetError.closed
    3 => NetError.timeout
    4 => NetError.notFound
    5 => NetError.inUse
    7 => NetError.tls
    _ => NetError.other
}

str reason(i32 code) => match code {
    1 => "connection refused"
    2 => "connection closed"
    3 => "timed out"
    4 => "no such host"
    5 => "address in use"
    7 => tlsMessage()
    _ => "network error"
}

// A socket that accepts connections.
pub struct Listener {
    i32 fd
    pub u16 port
}

// A connection. Reads go through a buffer, so lines can be read one at a time.
pub struct Conn {
    i32 fd
    u8[] buf
    i64 start
    i64 end
    u8 *tls
    Duration timeout
}

// Each read and write after this fails with NetError.timeout when it waits
// longer than d; 0 is the start, no limit.
pub void Conn.setTimeout(Duration d) {
    self.timeout = d
}

i64 Conn.rawRead(u8[] buf) {
    if self.tls != null {
        return rawTlsRead(self.tls, buf.ptr, buf.len, self.timeout)
    }
    return rawRead(self.fd, buf.ptr, buf.len, self.timeout)
}

// Listens on port (0 picks a free one; see .port) on host ("" for all
// addresses). shared lets several threads listen on the same port.
pub !Listener listen(u16 port, str host = "", bool shared = false) {
    i32 err
    fd := rawListen(host.ptr, host.len, i64(port), if shared { 1 } else { 0 }, &err)
    if fd < 0 {
        return error(netCode(err), "listening on port {port}: {reason(err)}")
    }
    return Listener{fd: fd, port: u16(rawPort(fd))}
}

// Waits for the next connection, for at most timeout when it isn't 0.
pub !Conn Listener.accept(Duration timeout = 0s) {
    i32 err
    fd := rawAccept(self.fd, &err, timeout)
    if fd < 0 {
        return error(netCode(err), "accepting a connection: {reason(err)}")
    }
    return Conn{fd: fd, buf: alloc(u8, 16KiB)}
}

pub void Listener.close() => rawClose(self.fd)

// Wakes a task that waits in accept, which then fails: for stopping a
// server.
pub void Listener.interrupt() => rawShutdown(self.fd)

// Connects to host:port, waiting at most timeout when it isn't 0.
pub !Conn dial(str host, u16 port, Duration timeout = 0s) {
    i32 err
    fd := rawDial(host.ptr, host.len, i64(port), &err, timeout)
    if fd < 0 {
        return error(netCode(err), "connecting to {host}:{port}: {reason(err)}")
    }
    return Conn{fd: fd, buf: alloc(u8, 16KiB)}
}

// Reads into buf: the number of bytes, 0 when the other side has closed.
pub !i64 Conn.read(u8[] buf) {
    if self.start < self.end {
        n := if self.end - self.start < buf.len { self.end - self.start } else { buf.len }
        for i in 0..n {
            buf[i] = self.buf[self.start + i]
        }
        self.start += n
        return n
    }
    n := self.rawRead(buf)
    if n < 0 {
        return error(netCode(i32(-n)), "reading: {reason(i32(-n))}")
    }
    return n
}

// Fills the buffer when it is empty. False at the end of the data.
!bool Conn.fill() {
    if self.start < self.end {
        return true
    }
    n := self.rawRead(self.buf)
    if n < 0 {
        return error(netCode(i32(-n)), "reading: {reason(i32(-n))}")
    }
    self.start = 0
    self.end = n
    return n > 0
}

// The next line, without its line break (\n or \r\n). NetError.closed at the
// end; NetError.tooLong when limit isn't 0 and the line is longer.
pub !String Conn.readLine(i64 limit = 0) {
    String line
    for {
        if limit > 0 && line.len > limit {
            line.free()
            return error(NetError.tooLong, "reading a line: longer than {limit} bytes")
        }
        more := try self.fill()
        if !more {
            if line.len > 0 {
                return line
            }
            line.free()
            return error(NetError.closed, "reading a line: connection closed")
        }
        for i in self.start..self.end {
            if self.buf[i] == '\n' {
                line.append(self.buf[self.start:i])
                self.start = i + 1
                if limit > 0 && line.len > limit + 1 {
                    line.free()
                    return error(NetError.tooLong, "reading a line: longer than {limit} bytes")
                }
                if line.len > 0 && line.ptr[0:line.len][line.len - 1] == '\r' {
                    String trimmed = line.ptr[0:line.len - 1].copy()
                    line.free()
                    return trimmed
                }
                return line
            }
        }
        line.append(self.buf[self.start:self.end])
        self.start = self.end
    }
}

// Reads exactly n bytes into a new String.
pub !String Conn.readExactly(i64 n) {
    String out
    for out.len < n {
        more := try self.fill()
        if !more {
            out.free()
            return error(NetError.closed, "reading: connection closed")
        }
        take := if self.end - self.start < n - out.len { self.end - self.start } else { n - out.len }
        out.append(self.buf[self.start:self.start + take])
        self.start += take
    }
    return out
}

// Writes all of data.
pub !void Conn.write(str data) {
    code := if self.tls != null {
        rawTlsWrite(self.tls, data.ptr, data.len, self.timeout)
    } else {
        rawWrite(self.fd, data.ptr, data.len, self.timeout)
    }
    if code != 0 {
        return error(netCode(code), "writing: {reason(code)}")
    }
}

// Ends the connection's reads and writes from another task: a task that
// waits on it wakes up as if the other side had closed. close still has to
// be called.
pub void Conn.interrupt() => rawShutdown(self.fd)

// Closes the connection.
pub void Conn.close() {
    if self.tls != null {
        rawTlsClose(self.tls)
        self.tls = null
    }
    rawClose(self.fd)
    if self.buf.len > 0 {
        free(self.buf)
        self.buf = alloc(u8, 0)
    }
}

// Connects to host:port over TLS. The server's certificate must be valid
// for host and signed by a certificate the system trusts, or one in the
// file ca (PEM) when ca is given.
pub !Conn dialTls(str host, u16 port, str ca = "") {
    c := try dial(host, port)
    c.startTls(host, ca) catch e {
        c.close()
        return e
    }
    return c
}

// Starts TLS as the client on a connection that is open, as dialTls does.
pub !void Conn.startTls(str host, str ca = "") {
    ssl := rawTlsConnect(self.fd, host.ptr, host.len, ca.ptr, ca.len)
    if ssl == null {
        return error(NetError.tls, "{host}: {tlsMessage()}")
    }
    self.tls = ssl
}

// A server's certificate and key, for accepting TLS connections. It can be
// shared by every thread.
pub struct TlsConfig {
    u8 *ctx
}

// Reads a certificate chain and its private key from PEM files.
pub !TlsConfig tlsConfig(str certFile, str keyFile) {
    ctx := rawTlsServerCtx(certFile.ptr, certFile.len, keyFile.ptr, keyFile.len)
    if ctx == null {
        return error(NetError.tls, tlsMessage())
    }
    return TlsConfig{ctx: ctx}
}

pub void TlsConfig.free() {
    rawTlsCtxFree(self.ctx)
    self.ctx = null
}

// Starts TLS as the server on an accepted connection.
pub !void Conn.acceptTls(TlsConfig *config) {
    ssl := rawTlsAccept(config.ctx, self.fd, self.timeout)
    if ssl == null {
        return error(NetError.tls, tlsMessage())
    }
    self.tls = ssl
}

// Lets the other tasks run.
pub void yield() => sleep(0ns)
