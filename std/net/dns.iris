// Looking up names: a DNS resolver that waits like any other network
// call, so the other tasks keep running. It reads /etc/resolv.conf for the
// servers and /etc/hosts for names it knows already.

import dns, fs, random, str, time

// The kinds of DNS record query can ask for.
pub enum RecordType { a, ns, cname, soa, ptr, mx, txt, aaaa, srv }

// One answer to a query.
pub struct Record {
    pub String name
    pub RecordType kind
    pub Duration ttl
    // a and aaaa: the address
    pub Addr ip
    // cname, ns, ptr, mx and srv: the host; soa: the primary server; txt:
    // the text
    pub String target
    // mx: the preference; srv: the priority and the weight
    pub i64 priority
    pub i64 weight
    // srv: the port
    pub u16 port
}

// Frees the record's name and target.
pub void Record.free() {
    self.name.free()
    self.target.free()
}

i64 typeCode(RecordType t) => match t {
    .a => 1,
    .ns => 2,
    .cname => 5,
    .soa => 6,
    .ptr => 12,
    .mx => 15,
    .txt => 16,
    .aaaa => 28,
    .srv => 33,
}

(RecordType, bool) typeOf(i64 code) => match code {
    1 => (RecordType.a, true),
    2 => (RecordType.ns, true),
    5 => (RecordType.cname, true),
    6 => (RecordType.soa, true),
    12 => (RecordType.ptr, true),
    15 => (RecordType.mx, true),
    16 => (RecordType.txt, true),
    28 => (RecordType.aaaa, true),
    33 => (RecordType.srv, true),
    _ => (RecordType.a, false),
}

// Where names are looked up.
pub struct Resolver {
    // the DNS servers, tried in turn
    pub List[Addr] servers
    // how long to wait for an answer from one server, and how many rounds
    // of the servers to try
    pub Duration timeout
    pub i64 attempts
    // what goes after a short name ("db" can be "db.example.com"), and how
    // many dots a name needs to be tried as it is first
    pub List[String] search
    pub i64 ndots
    // the names in the hosts file, and their addresses
    List[String] hostNames
    List[Addr] hostAddrs
}

// A resolver for servers ("1.1.1.1", "[2001:db8::53]:5353"); with none,
// the ones in /etc/resolv.conf. hostsFile is read for names it knows
// already ("" for /etc/hosts).
pub !Resolver resolver(str[] servers = [], str hostsFile = "") {
    Resolver r
    errdefer r.free()
    r.timeout = 5s
    r.attempts = 2
    r.ndots = 1
    if servers.len == 0 {
        r.readConf("/etc/resolv.conf")
    }
    for s in servers {
        r.servers.push(try parseAddr(s, 53))
    }
    if r.servers.len == 0 {
        // no servers named: one on this machine, as other resolvers do
        r.servers.push(try parseAddr("127.0.0.1", 53))
        r.servers.push(try parseAddr("::1", 53))
    }
    r.readHosts(if hostsFile.len > 0 { hostsFile } else { "/etc/hosts" })
    return r
}

// Frees the resolver's servers, search domains and hosts.
pub void Resolver.free() {
    self.servers.free()
    self.search.freeEach()
    self.hostNames.freeEach()
    self.hostAddrs.free()
}

// The words of a line, without what follows a #.
List[str] words(str line) {
    List[str] out
    body, _, _ := str.cut(line, "#")
    i := 0
    for i < body.len {
        for i < body.len && (body[i] == ' ' || body[i] == '\t' || body[i] == '\r') {
            i += 1
        }
        start := i
        for i < body.len && body[i] != ' ' && body[i] != '\t' && body[i] != '\r' {
            i += 1
        }
        if i > start {
            out.push(body[start:i])
        }
    }
    return out
}

i64 smallNumber(str s, i64 fallback) {
    n := str.parseInt(s) catch e {
        return fallback
    }
    return if n > 0 && n < 100 { n } else { fallback }
}

void Resolver.readConf(str path) {
    scoped String text = fs.readAll(path) catch e {
        return
    }
    str rest = text
    for rest.len > 0 {
        line, after, _ := str.cut(rest, "\n")
        rest = after
        scoped List[str] w = words(line)
        if w.len < 2 {
            continue
        }
        key := w.at(0)
        if key == "nameserver" {
            a := parseAddr(w.at(1), 53) catch e {
                continue
            }
            self.servers.push(a)
        } else if key == "search" || key == "domain" {
            self.search.freeEach()
            for i in 1..w.len {
                self.search.push(w.at(i).copy())
            }
        } else if key == "options" {
            for i in 1..w.len {
                name, value, _ := str.cut(w.at(i), ":")
                if name == "ndots" {
                    self.ndots = smallNumber(value, 1)
                } else if name == "timeout" {
                    self.timeout = Duration(smallNumber(value, 5)) * 1s
                } else if name == "attempts" {
                    self.attempts = smallNumber(value, 2)
                }
            }
        }
    }
}

void Resolver.readHosts(str path) {
    scoped String text = fs.readAll(path) catch e {
        return
    }
    str rest = text
    for rest.len > 0 {
        line, after, _ := str.cut(rest, "\n")
        rest = after
        scoped List[str] w = words(line)
        if w.len < 2 {
            continue
        }
        a := ip(w.at(0)) catch e {
            continue
        }
        for i in 1..w.len {
            self.hostNames.push(str.lower(w.at(i)))
            self.hostAddrs.push(a)
        }
    }
}

// ------------------------------------------------------------ messages

dns.Type wireType(RecordType t) => match t {
    .a => dns.Type.a,
    .ns => dns.Type.ns,
    .cname => dns.Type.cname,
    .soa => dns.Type.soa,
    .ptr => dns.Type.ptr,
    .mx => dns.Type.mx,
    .txt => dns.Type.txt,
    .aaaa => dns.Type.aaaa,
    .srv => dns.Type.srv,
}

// A query for name: a random id, recursion wanted, and room for answers
// up to 1232 bytes over UDP (EDNS).
!String question(str name, RecordType t, i64 id) {
    scoped m := dns.query(u16(id), name, wireType(t))
    m.additionals.push(dns.Record{name: "".copy(), kind: .opt, class: 1232})
    return try encodeQuery(&m, name)
}

!String encodeQuery(dns.Message *m, str name) {
    return m.encode() catch e {
        return error(NetError.notFound, "'{name}' isn't a host name")
    }
}

void putU16(String *out, i64 v) {
    u8[2] b = [u8(v >> 8 & 0xff), u8(v & 0xff)]
    out.append(b[0:2])
}

i64 u16At(str m, i64 i) => if i + 2 <= m.len { i64(m[i]) << 8 | i64(m[i + 1]) } else { 0 }

// What a reply said: 0 answers, 1 no such name, 2 the server failed, 3
// truncated, 4 not a reply to this query.
i64 parseReply(str bytes, i64 id, RecordType want, List[Record] *out) {
    scoped m := dns.parse(bytes) catch e {
        return 4
    }
    h := m.header
    if i64(h.id) != id || !h.response {
        return 4
    }
    if h.truncated {
        return 3
    }
    if h.rcode == 3 {
        return 1
    }
    if h.rcode != 0 {
        return 2
    }
    for a in m.answers {
        t, known := typeOf(a.kind.value)
        if !known || t != want && !(t == .cname && want != .cname) {
            continue
        }
        Record r = .{name: a.name.copy(), kind: t, ttl: a.ttl, priority: a.priority, weight: a.weight, port: a.port}
        r.ip.ip = a.ip
        r.target = if t == .txt { a.text.copy() } else { a.target.copy() }
        out.push(r)
    }
    return 0
}

// ------------------------------------------------------------ asking

// One exchange with a server over UDP: the reply, or an error.
!String askUdp(Addr server, str q, i64 id, Duration timeout) {
    u := try dialUdp(server)
    defer u.close()
    u.setTimeout(timeout)
    try u.send(q)
    u8[] buf = alloc(u8, 1232)
    defer free(buf)
    start := time.clock()
    for {
        n := try u.read(buf)
        reply := buf[0:n]
        // a datagram that isn't the reply (an old one, or a forged one) is
        // dropped
        if n >= 2 && u16At(reply, 0) == id {
            return reply.copy()
        }
        left := timeout - (time.clock() - start)
        if left <= 0s {
            return error(NetError.timeout, "no reply")
        }
        u.setTimeout(left)
    }
}

// The same over TCP, for answers too long for a datagram.
!String askTcp(Addr server, str q, Duration timeout) {
    c := try dialAddr(server, timeout)
    defer c.close()
    c.setTimeout(timeout)
    String framed
    defer framed.free()
    putU16(&framed, q.len)
    framed.append(q)
    try c.write(framed)
    scoped String size = try c.readExactly(2)
    return try c.readExactly(u16At(size, 0))
}

// Asks the servers about one name. 0 with the records, 1 when the name
// isn't there.
!i64 Resolver.ask(str name, RecordType t, List[Record] *out) {
    id := random.int(0, 65536)
    scoped String q = try question(name, t, id)
    i64 failures = 0
    for round in 0..(if self.attempts > 0 { self.attempts } else { 1 }) {
        for server in self.servers {
            timeout := if self.timeout > 0s { self.timeout } else { 5s }
            scoped String reply = askUdp(server, q, id, timeout) catch e {
                failures += 1
                continue
            }
            List[Record] got
            result := parseReply(reply, id, t, &got)
            if result == 3 {
                got.freeEach()
                scoped String long = askTcp(server, q, timeout) catch e {
                    failures += 1
                    continue
                }
                result = parseReply(long, id, t, &got)
            }
            if result == 0 {
                for r in got {
                    out.push(r)
                }
                got.free()
                return 0
            }
            got.freeEach()
            if result == 1 {
                return 1
            }
            failures += 1
        }
    }
    return error(NetError.timeout, "looking up {name}: no DNS server answered")
}

// The names to try for name: with the search domains, in the order the
// resolver tries them.
List[String] Resolver.candidates(str name) {
    List[String] out
    if str.endsWith(name, ".") {
        out.push(name.copy())
        return out
    }
    dots := str.count(name, ".")
    if dots >= self.ndots {
        out.push(name.copy())
    }
    for s in self.search {
        out.push(format("{name}.{s}"))
    }
    if dots < self.ndots {
        out.push(name.copy())
    }
    return out
}

// The records of a kind for name. A name that isn't there fails with
// NetError.notFound.
pub !List[Record] Resolver.query(str name, RecordType t) {
    scoped List[String] names = self.candidates(name)
    defer names.freeEach()
    for n in names {
        List[Record] out
        result := self.ask(n, t, &out) catch e {
            out.freeEach()
            return e
        }
        if result == 0 {
            return out
        }
        out.free()
    }
    return error(NetError.notFound, "{name}: no such host")
}

struct Lookup {
    List[Addr] addrs
    bool ok
}

void lookupTask(Resolver *r, str name, RecordType t, chan[Lookup] done) {
    Lookup l
    scoped List[Record] found = r.query(name, t) catch e {
        done <- l
        return
    }
    defer found.freeEach()
    for rec in found {
        if rec.kind == t {
            l.addrs.push(rec.ip)
        }
    }
    l.ok = true
    done <- l
}

// The addresses of host: an IP as it is, then the hosts file, then DNS,
// asking for IPv4 and IPv6 at once. The IPv4 addresses come first.
pub !List[Addr] Resolver.lookup(str host) {
    List[Addr] out
    a := ip(host) catch e {
        Addr{}
    }
    if host.len > 0 && (a.ip[10] != 0 || a.ip[15] != 0 || host == "::") {
        out.push(a)
        return out
    }
    scoped String lower = str.lower(if str.endsWith(host, ".") { host[0:host.len - 1] } else { host })
    for i in 0..self.hostNames.len {
        if self.hostNames.at(i) == lower {
            out.push(self.hostAddrs.at(i))
        }
    }
    if out.len > 0 {
        return out
    }
    if lower == "localhost" || str.endsWith(lower, ".localhost") {
        out.push(try ip("127.0.0.1"))
        out.push(try ip("::1"))
        return out
    }
    v6 := chan[Lookup](1)
    spawn lookupTask(self, host, .aaaa, v6)
    bool asked = true
    scoped List[Record] v4 = self.query(host, .a) catch e {
        asked = e.code == NetError.notFound
        List[Record]{}
    }
    defer v4.freeEach()
    six := <-v6
    if !asked && !six.ok {
        return error(NetError.timeout, "looking up {host}: no DNS server answered")
    }
    for rec in v4 {
        if rec.kind == .a {
            out.push(rec.ip)
        }
    }
    for addr in six.addrs {
        out.push(addr)
    }
    six.addrs.free()
    if out.len == 0 {
        return error(NetError.notFound, "{host}: no such host")
    }
    return out
}

// ------------------------------------------------------------ the system's

Resolver systemResolver
bool systemReady
Mutex systemLock

Resolver *system() {
    systemLock.lock()
    defer systemLock.unlock()
    if !systemReady {
        systemResolver = resolver() catch e {
            Resolver{}
        }
        systemReady = true
    }
    return &systemResolver
}

// The addresses of host, with the system's resolver.
pub !List[Addr] lookup(str host) => try system().lookup(host)

// The records of a kind for name, with the system's resolver.
pub !List[Record] query(str name, RecordType t) => try system().query(name, t)
