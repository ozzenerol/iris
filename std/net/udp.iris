// IP addresses and UDP.

@extern("iris_udp_open")
i32 rawUdpOpen(u8 *ip, i64 port, i32 connect, i32 *family, i32 *err)

@extern("iris_udp_send")
i32 rawUdpSend(i32 fd, i32 family, u8 *buf, i64 len, u8 *ip, i64 port, i64 timeout)

@extern("iris_udp_recv")
i64 rawUdpRecv(i32 fd, u8 *buf, i64 len, u8 *ip, i64 *port, i64 timeout)

@extern("iris_sock_local")
void rawLocal(i32 fd, u8 *ip, i64 *port)

@extern("iris_net_dial_ip")
i32 rawDialIp(u8 *ip, i64 port, i32 *err, i64 timeout)

@extern("iris_ip_format")
void rawIpFormat(u8 *ip, String *out)

@extern("iris_ip_parse")
i32 rawIpParse(u8 *text, i64 len, u8 *ip)

// An IP address and a port. An IPv4 address is kept as an IPv6 one:
// ::ffff:a.b.c.d.
pub struct Addr {
    pub u8[16] ip
    pub u16 port
}

// Whether a is an IPv4 address.
pub bool Addr.isV4() {
    for i in 0..10 {
        if self.ip[i] != 0 {
            return false
        }
    }
    return self.ip[10] == 0xff && self.ip[11] == 0xff
}

// The address's IP as text: "192.0.2.1" or "2001:db8::1".
pub String Addr.ipText() {
    String out
    rawIpFormat(&self.ip[0], &out)
    return out
}

// "192.0.2.1:53", or "[2001:db8::1]:53" for IPv6.
pub String Addr.format() {
    scoped String ip = self.ipText()
    if self.isV4() {
        return format("{ip}:{self.port}")
    }
    return format("[{ip}]:{self.port}")
}

// Whether the two addresses have the same IP and port.
pub bool Addr.equal(Addr other) {
    if self.port != other.port {
        return false
    }
    for i in 0..16 {
        if self.ip[i] != other.ip[i] {
            return false
        }
    }
    return true
}

// The address of an IP written as text, "192.0.2.1" or "2001:db8::1",
// with port.
pub !Addr ip(str text, u16 port = 0) {
    Addr a
    a.port = port
    if rawIpParse(text.ptr, text.len, &a.ip[0]) == 0 {
        return error(NetError.notFound, "'{text}' isn't an IP address")
    }
    return a
}

// An address written as text: "192.0.2.1:53", "[2001:db8::1]:53", or an
// IP without a port, which gets port.
pub !Addr parseAddr(str text, u16 port = 0) {
    if text.len > 0 && text[0] == '[' {
        for i in 1..text.len {
            if text[i] == ']' {
                p := try portOf(text, text[i + 1:], port)
                return try ip(text[1:i], p)
            }
        }
        return error(NetError.notFound, "'{text}' has no ] after the IPv6 address")
    }
    colons := 0
    last := -1
    for i in 0..text.len {
        if text[i] == ':' {
            colons += 1
            last = i
        }
    }
    if colons == 1 {
        p := try portOf(text, text[last:], port)
        return try ip(text[0:last], p)
    }
    return try ip(text, port)
}

!u16 portOf(str text, str rest, u16 given) {
    if rest.len == 0 {
        return given
    }
    if rest[0] != ':' || rest.len == 1 {
        return error(NetError.notFound, "'{text}' isn't an address")
    }
    i64 n = 0
    for i in 1..rest.len {
        c := rest[i]
        if c < '0' || c > '9' || n > 65535 {
            return error(NetError.notFound, "'{text}' has a port that isn't a number up to 65535")
        }
        n = n * 10 + i64(c - '0')
    }
    if n > 65535 {
        return error(NetError.notFound, "'{text}' has a port that isn't a number up to 65535")
    }
    return u16(n)
}

// A UDP socket. Each read and write sends or gets one datagram.
pub struct Udp {
    i32 fd
    i32 family
    bool connected
    Duration timeout
}

// Each read and write after this fails with NetError.timeout when it waits
// longer than d; 0 is the start, no limit.
pub void Udp.setTimeout(Duration d) {
    self.timeout = d
}

// A UDP socket on port (0 picks a free one) of host, an IP ("" for all
// addresses), for reading datagrams from anywhere and sending them
// anywhere.
pub !Udp listenUdp(u16 port = 0, str host = "") {
    i32 err
    i32 family
    i32 fd
    if host.len == 0 {
        fd = rawUdpOpen(null, i64(port), 0, &family, &err)
    } else {
        a := try ip(host, port)
        fd = rawUdpOpen(&a.ip[0], i64(port), 0, &family, &err)
    }
    if fd < 0 {
        return error(netCode(err), "opening UDP port {port}: {reason(err)}")
    }
    return Udp{fd: fd, family: family}
}

// A UDP socket that sends to addr and only reads what comes from it.
pub !Udp dialUdp(Addr addr) {
    i32 err
    i32 family
    fd := rawUdpOpen(&addr.ip[0], i64(addr.port), 1, &family, &err)
    if fd < 0 {
        scoped String where = addr.format()
        return error(netCode(err), "connecting to {where}: {reason(err)}")
    }
    return Udp{fd: fd, family: family, connected: true}
}

!void udpFail(i32 code, str doing) {
    if code == 9 {
        return error(NetError.tooLong, "{doing}: the datagram is too large")
    }
    return error(netCode(code), "{doing}: {reason(code)}")
}

// Sends data as one datagram to addr.
pub !void Udp.sendTo(str data, Addr addr) {
    code := rawUdpSend(self.fd, self.family, data.ptr, data.len, &addr.ip[0], i64(addr.port), self.timeout)
    if code != 0 {
        scoped String where = addr.format()
        try udpFail(code, "sending to {where}")
    }
}

// Sends data as one datagram to where a dialUdp socket is connected.
pub !void Udp.send(str data) {
    code := rawUdpSend(self.fd, self.family, data.ptr, data.len, null, 0, self.timeout)
    if code != 0 {
        try udpFail(code, "sending")
    }
}

// Waits for a datagram, puts it in buf and gives its length and who sent
// it. A datagram longer than buf is cut to fit.
pub !(i64, Addr) Udp.readFrom(u8[] buf) {
    Addr from
    i64 port
    n := rawUdpRecv(self.fd, buf.ptr, buf.len, &from.ip[0], &port, self.timeout)
    if n < 0 {
        code := i32(-n)
        try udpFail(code, "reading a datagram")
    }
    from.port = u16(port)
    return (n, from)
}

// readFrom, without who sent it.
pub !i64 Udp.read(u8[] buf) {
    n, _ := try self.readFrom(buf)
    return n
}

// The address the socket is bound to: its port for listenUdp(0).
pub Addr Udp.localAddr() {
    Addr a
    i64 port
    rawLocal(self.fd, &a.ip[0], &port)
    a.port = u16(port)
    return a
}

// Closes the socket.
pub void Udp.close() => rawClose(self.fd)
