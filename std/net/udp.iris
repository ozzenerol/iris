// IP addresses and UDP.

@extern("iris_udp_open")
i32 rawUdpOpen(u8 *ip, i64 port, i32 connect, i32 *family, i32 *err)

@extern("iris_udp_send")
i32 rawUdpSend(i32 fd, i32 family, u8 *buf, i64 len, u8 *ip, i64 port, i64 timeout)

@extern("iris_udp_recv")
i64 rawUdpRecv(i32 fd, u8 *buf, i64 len, u8 *ip, i64 *port, i64 timeout)

@extern("iris_udp_recv_many")
i64 rawUdpRecvMany(i32 fd, Datagram *d, i64 n, i64 timeout)

@extern("iris_udp_send_many")
i32 rawUdpSendMany(i32 fd, i32 family, i32 connected, Datagram *d, i64 n, i64 timeout)

@extern("iris_sock_local")
void rawLocal(i32 fd, u8 *ip, i64 *port)

@extern("iris_sock_remote")
void rawRemote(i32 fd, u8 *ip, i64 *port)

@extern("iris_net_dial_ip")
i32 rawDialIp(u8 *ip, i64 port, i32 *err, i64 timeout)

@extern("iris_ip_format")
void rawIpFormat(u8 *ip, String *out)

@extern("iris_ip_parse")
i32 rawIpParse(u8 *text, i64 len, u8 *ip)

// An IP address and a port. An IPv4 address is kept as an IPv6 one:
// ::ffff:a.b.c.d.
pub struct Addr {
    pub u8[16] ip
    pub u16 port
}

// Whether a is an IPv4 address.
pub bool Addr.isV4() {
    for i in 0..10 {
        if self.ip[i] != 0 {
            return false
        }
    }
    return self.ip[10] == 0xff && self.ip[11] == 0xff
}

// The address's IP as text: "192.0.2.1" or "2001:db8::1".
pub String Addr.ipText() {
    String out
    rawIpFormat(&self.ip[0], &out)
    return out
}

// "192.0.2.1:53", or "[2001:db8::1]:53" for IPv6.
pub String Addr.format() {
    scoped String ip = self.ipText()
    if self.isV4() {
        return format("{ip}:{self.port}")
    }
    return format("[{ip}]:{self.port}")
}

// Whether the two addresses have the same IP and port.
pub bool Addr.equal(Addr other) {
    if self.port != other.port {
        return false
    }
    for i in 0..16 {
        if self.ip[i] != other.ip[i] {
            return false
        }
    }
    return true
}

// The address of an IP written as text, "192.0.2.1" or "2001:db8::1",
// with port.
pub !Addr ip(str text, u16 port = 0) {
    Addr a
    a.port = port
    if rawIpParse(text.ptr, text.len, &a.ip[0]) == 0 {
        return error(NetError.notFound, "'{text}' isn't an IP address")
    }
    return a
}

// An address written as text: "192.0.2.1:53", "[2001:db8::1]:53", or an
// IP without a port, which gets port.
pub !Addr parseAddr(str text, u16 port = 0) {
    if text.len > 0 && text[0] == '[' {
        for i in 1..text.len {
            if text[i] == ']' {
                p := try portOf(text, text[i + 1:], port)
                return try ip(text[1:i], p)
            }
        }
        return error(NetError.notFound, "'{text}' has no ] after the IPv6 address")
    }
    colons := 0
    last := -1
    for i in 0..text.len {
        if text[i] == ':' {
            colons += 1
            last = i
        }
    }
    if colons == 1 {
        p := try portOf(text, text[last:], port)
        return try ip(text[0:last], p)
    }
    return try ip(text, port)
}

!u16 portOf(str text, str rest, u16 given) {
    if rest.len == 0 {
        return given
    }
    if rest[0] != ':' || rest.len == 1 {
        return error(NetError.notFound, "'{text}' isn't an address")
    }
    i64 n = 0
    for i in 1..rest.len {
        c := rest[i]
        if c < '0' || c > '9' || n > 65535 {
            return error(NetError.notFound, "'{text}' has a port that isn't a number up to 65535")
        }
        n = n * 10 + i64(c - '0')
    }
    if n > 65535 {
        return error(NetError.notFound, "'{text}' has a port that isn't a number up to 65535")
    }
    return u16(n)
}

// A UDP socket. Each read and write sends or gets one datagram.
pub struct Udp {
    i32 sock
    i32 family
    bool connected
    Duration timeout
}

// Each read and write after this fails with NetError.timeout when it waits
// longer than d; 0 is the start, no limit.
pub void Udp.setTimeout(Duration d) {
    self.timeout = d
}

// A UDP socket on port (0 picks a free one) of host, an IP ("" for all
// addresses), for reading datagrams from anywhere and sending them
// anywhere. Several sockets can listen on one port, such as one per
// thread; each datagram goes to one of them.
pub !Udp listenUdp(u16 port = 0, str host = "") {
    i32 err
    i32 family
    i32 fd
    if host.len == 0 {
        fd = rawUdpOpen(null, i64(port), 0, &family, &err)
    } else {
        a := try ip(host, port)
        fd = rawUdpOpen(&a.ip[0], i64(port), 0, &family, &err)
    }
    if fd < 0 {
        return error(netCode(err), "opening UDP port {port}: {reason(err)}")
    }
    return Udp{sock: fd, family: family}
}

// A UDP socket that sends to addr and only reads what comes from it.
pub !Udp dialUdp(Addr addr) {
    i32 err
    i32 family
    fd := rawUdpOpen(&addr.ip[0], i64(addr.port), 1, &family, &err)
    if fd < 0 {
        scoped String where = addr.format()
        return error(netCode(err), "connecting to {where}: {reason(err)}")
    }
    return Udp{sock: fd, family: family, connected: true}
}

!void udpFail(i32 code, str doing) {
    if code == 9 {
        return error(NetError.tooLong, "{doing}: the datagram is too large")
    }
    return error(netCode(code), "{doing}: {reason(code)}")
}

@extern("iris_udp_multicast")
i32 rawMulticast(i32 fd, i32 family, i32 op, u8 *ip, u8 *iface, i64 ifaceLen, i32 value)

!void multicastFail(i32 e, str what, str iface) {
    if e == -1 {
        return error(NetError.notFound, "{what}: no interface {iface} (with an IPv4 address, for IPv4)")
    }
    try optionFail(e, what)
}

// Joins the multicast group, an address such as 239.255.255.250 or
// ff02::fb: datagrams sent to it come to this socket too. iface names the
// interface to listen on ("" lets the system choose). An IPv4 group needs
// a socket of IPv4, such as listenUdp(port, "0.0.0.0"), on every system.
pub !void Udp.joinGroup(Addr group, str iface = "") {
    scoped String g = group.ipText()
    try multicastFail(rawMulticast(self.sock, self.family, 1, &group.ip[0], iface.ptr, iface.len, 0),
        "joining {g}", iface)
}

// Leaves a group joinGroup joined.
pub !void Udp.leaveGroup(Addr group, str iface = "") {
    scoped String g = group.ipText()
    try multicastFail(rawMulticast(self.sock, self.family, 2, &group.ip[0], iface.ptr, iface.len, 0),
        "leaving {g}", iface)
}

// How many routers a multicast datagram this socket sends may pass (1 is
// the start: this network only).
pub !void Udp.setMulticastHops(i64 hops) {
    try multicastFail(rawMulticast(self.sock, self.family, 3, null, "".ptr, 0, i32(hops)), "setting the hops", "")
}

// Whether multicast this socket sends also comes back to sockets on this
// machine that joined the group (true is the start).
pub !void Udp.setMulticastLoop(bool on) {
    try multicastFail(rawMulticast(self.sock, self.family, 4, null, "".ptr, 0, if on { 1 } else { 0 }),
        "setting the loop", "")
}

// The interface multicast this socket sends goes out of.
pub !void Udp.setMulticastInterface(str iface) {
    try multicastFail(rawMulticast(self.sock, self.family, 5, null, iface.ptr, iface.len, 0),
        "setting the interface", iface)
}

// Lets the socket send to a broadcast address such as 255.255.255.255.
pub !void Udp.setBroadcast(bool on) {
    try multicastFail(rawMulticast(self.sock, self.family, 6, null, "".ptr, 0, if on { 1 } else { 0 }),
        "setting SO_BROADCAST", "")
}

@extern("iris_udp_info")
i32 rawUdpInfo(i32 fd, i32 family, i32 op, i32 value)

@extern("iris_udp_recvmsg")
i64 rawRecvMsg(i32 fd, u8 *buf, i64 len, u8 *ip, i64 *port, u8 *to, i64 *tos, i64 *segment, i64 *flags,
    i64 timeout)

@extern("iris_udp_sendmsg")
i32 rawSendMsg(i32 fd, i32 family, u8 *buf, i64 len, u8 *ip, i64 port, u8 *from, i64 tos, i64 segment,
    i64 timeout)

// A datagram readMsg read, with what came with it.
pub struct Message {
    // its length, cut to the buffer's when truncated is set
    pub i64 len
    pub bool truncated
    // who sent it, and the local address it came to (zeros when
    // setReceiveInfo is off)
    pub Addr from
    pub Addr to
    // its TOS byte (the traffic class on IPv6): DSCP in the top six bits,
    // ECN in the low two; -1 when unknown
    pub i64 tos
    // with setGro, the size of each datagram it holds, the last maybe
    // shorter; 0 when it is one
    pub i64 segment
}

// Asks for the local address and the TOS byte of each datagram readMsg
// reads: what a server on several addresses answers from, and ECN.
pub !void Udp.setReceiveInfo(bool on) {
    try optionFail(rawUdpInfo(self.sock, self.family, 1, if on { 1 } else { 0 }), "asking for the datagrams' details")
}

// The TOS byte of what the socket sends, such as 0x02 for ECT(0) or 0xb8
// for expedited forwarding (the traffic class on IPv6).
pub !void Udp.setTos(i64 tos) {
    try optionFail(rawUdpInfo(self.sock, self.family, 2, i32(tos)), "setting the TOS byte")
}

// Turns generic receive offload on (Linux): one readMsg may take several
// datagrams of one size from a sender at once, as Message.segment says.
pub !void Udp.setGro(bool on) {
    e := rawUdpInfo(self.sock, self.family, 3, if on { 1 } else { 0 })
    if e == -1 {
        return error(NetError.other, "UDP GRO: only on Linux")
    }
    try optionFail(e, "turning GRO on")
}

// Reads one datagram into buf, with its sender, the address it came to
// and its TOS byte, as setReceiveInfo asks.
pub !Message Udp.readMsg(u8[] buf) {
    Message m
    i64 port
    i64 flags
    n := rawRecvMsg(self.sock, buf.ptr, buf.len, &m.from.ip[0], &port, &m.to.ip[0], &m.tos, &m.segment, &flags,
        self.timeout)
    if n < 0 {
        return error(netCode(i32(-n)), "reading a datagram: {reason(i32(-n))}")
    }
    m.len = n
    m.from.port = u16(port)
    m.truncated = flags & 1 != 0
    return m
}

// Sends data to addr as sendTo does, from the local address from when it
// isn't zero (one of this machine's), with the TOS byte tos when it isn't
// -1, and, when segment is above 0, cut by the kernel into datagrams of
// segment bytes (GSO, Linux), so one call sends many.
pub !void Udp.sendMsg(str data, Addr addr, Addr from = Addr{}, i64 tos = -1, i64 segment = 0) {
    bool hasFrom = false
    for b in from.ip {
        if b != 0 {
            hasFrom = true
        }
    }
    code := rawSendMsg(self.sock, self.family, data.ptr, data.len, &addr.ip[0], i64(addr.port),
        if hasFrom { &from.ip[0] } else { null }, tos, segment, self.timeout)
    if code == 10 {
        return error(NetError.other, "sending in segments (GSO): not here")
    }
    if code != 0 {
        scoped String where = addr.format()
        try udpFail(code, "sending to {where}")
    }
}

// Sends data as one datagram to addr.
pub !void Udp.sendTo(str data, Addr addr) {
    code := rawUdpSend(self.sock, self.family, data.ptr, data.len, &addr.ip[0], i64(addr.port), self.timeout)
    if code != 0 {
        scoped String where = addr.format()
        try udpFail(code, "sending to {where}")
    }
}

// Sends data as one datagram to where a dialUdp socket is connected.
pub !void Udp.send(str data) {
    code := rawUdpSend(self.sock, self.family, data.ptr, data.len, null, 0, self.timeout)
    if code != 0 {
        try udpFail(code, "sending")
    }
}

// Waits for a datagram, puts it in buf and gives its length and who sent
// it. A datagram longer than buf is cut to fit.
pub !(i64, Addr) Udp.readFrom(u8[] buf) {
    Addr from
    i64 port
    n := rawUdpRecv(self.sock, buf.ptr, buf.len, &from.ip[0], &port, self.timeout)
    if n < 0 {
        code := i32(-n)
        try udpFail(code, "reading a datagram")
    }
    from.port = u16(port)
    return (n, from)
}

// readFrom, without who sent it.
pub !i64 Udp.read(u8[] buf) {
    n, _ := try self.readFrom(buf)
    return n
}

// One datagram of a batch for readMany and sendMany: buf is the space
// for it, len how many bytes of buf it uses, and addr where it came from
// or goes to.
pub struct Datagram {
    pub u8[] buf
    pub i64 len
    pub Addr addr
}

// The bytes of the datagram: buf cut to len.
pub str Datagram.data() => self.buf[0:self.len]

// Waits for a datagram, then reads as many as are already waiting, up to
// msgs.len, with one system call on Linux. Each one goes into the buf of
// the next item of msgs, which gets its len and addr. Gives how many it
// read. A datagram longer than its buf is cut to fit.
pub !i64 Udp.readMany(Datagram[] msgs) {
    n := rawUdpRecvMany(self.sock, msgs.ptr, msgs.len, self.timeout)
    if n < 0 {
        try udpFail(i32(-n), "reading datagrams")
    }
    return n
}

// Sends each item of msgs, the first len bytes of its buf, to its addr,
// with one system call per 64 on Linux. On a dialUdp socket each goes to
// where the socket is connected and addr is not used.
pub !void Udp.sendMany(Datagram[] msgs) {
    i32 connected = 0
    if self.connected {
        connected = 1
    }
    code := rawUdpSendMany(self.sock, self.family, connected, msgs.ptr, msgs.len, self.timeout)
    if code != 0 {
        try udpFail(code, "sending datagrams")
    }
}

// The address the socket is bound to: its port for listenUdp(0).
pub Addr Udp.localAddr() {
    Addr a
    i64 port
    rawLocal(self.sock, &a.ip[0], &port)
    a.port = u16(port)
    return a
}

// The socket's file descriptor, for socket options and calls through
// import c. Reading, writing or closing it directly breaks the socket.
pub i32 Udp.fd() => self.sock

// Closes the socket.
pub void Udp.close() => rawClose(self.sock)
