// SQLite databases. The system's SQLite is loaded when a program first
// opens one. Calls wait for the database on the calling thread; a Db can be
// shared by threads.

// What database calls fail with: failed, busy (the database is locked),
// constraint (a UNIQUE, NOT NULL or other constraint), and noRows (one found
// nothing).
pub enum SqliteError { failed, busy, constraint, noRows }

// A value for a ? in SQL: .int(36), .float(1.5), .text("ada"), .blob(bytes)
// for bytes kept as they are, or .none for NULL.
pub enum Value { int(i64 v), float(f64 v), text(str v), blob(u8[] v), none }

@extern("iris_sql_open")
i32 rawOpen(u8 *path, i64 len, u8 **db)

@extern("iris_sql_close")
void rawClose(u8 *db)

@extern("iris_sql_prepare")
i32 rawPrepare(u8 *db, u8 *sql, i64 len, i64 *at, u8 **stmt)

@extern("iris_sql_take")
i32 rawTake(u8 *db, u8 *sql, i64 len, u8 **stmt, i64 *more)

@extern("iris_sql_give")
void rawGive(u8 *db, u8 *stmt)

@extern("iris_sql_bind")
i32 rawBind(u8 *db, u8 *stmt, i64 i, i32 kind, i64 iv, f64 fv, u8 *text, i64 len)

@extern("iris_sql_params")
i64 rawParams(u8 *db, u8 *stmt)

@extern("iris_sql_step")
i32 rawStep(u8 *db, u8 *stmt)

@extern("iris_sql_finalize")
void rawFinalize(u8 *db, u8 *stmt)

@extern("iris_sql_columns")
i64 rawColumns(u8 *db, u8 *stmt)

@extern("iris_sql_type")
i64 rawType(u8 *db, u8 *stmt, i64 i)

@extern("iris_sql_int")
i64 rawInt(u8 *db, u8 *stmt, i64 i)

@extern("iris_sql_float")
f64 rawFloat(u8 *db, u8 *stmt, i64 i)

@extern("iris_sql_text")
u8 *rawText(u8 *db, u8 *stmt, i64 i, i64 *len)

@extern("iris_sql_blob")
u8 *rawBlob(u8 *db, u8 *stmt, i64 i, i64 *len)

@extern("iris_sql_name")
u8 *rawName(u8 *db, u8 *stmt, i64 i, i64 *len)

@extern("iris_sql_last_id")
i64 rawLastId(u8 *db)

@extern("iris_sql_changes")
i64 rawChanges(u8 *db)

@extern("iris_sql_scan")
i32 rawScan(u8 *db, u8 *stmt, u8 *table, u8 *out, u8 **memo)

@extern("iris_sql_map_free")
void rawMapFree(u8 *memo)

@extern("iris_sql_find")
i32 rawFind(u8 *db, u8 *ent, i32 kind, i64 iv, f64 fv, u8 *text, i64 len, u8 *out)

@extern("iris_sql_update")
i64 rawUpdate(u8 *db, u8 *ent, u8 *row)

@extern("iris_sql_delete")
i64 rawDelete(u8 *db, u8 *ent, i32 kind, i64 iv, f64 fv, u8 *text, i64 len)

@extern("iris_sql_insert")
i32 rawInsert(u8 *db, u8 *stmt, u8 *table, u8 *row, i64 *which, i64 n, i64 back, i64 *id, u8 **memo)

@extern("iris_sql_message_ptr")
u8 *messagePtr()

@extern("iris_sql_message_len")
i64 messageLen()

@builtin
void tableOf()

str message() => messagePtr()[0:messageLen()]

Error sqlError(i32 kind) => match kind {
    2 => error(SqliteError.busy, "{message()}")
    3 => error(SqliteError.constraint, "{message()}")
    _ => error(SqliteError.failed, "{message()}")
}

// An open database.
pub struct Db {
    u8 *handle
}

// Opens the database in the file at path, making it if needed.
// ":memory:" is a database that lives in memory until it is closed.
pub !Db open(str path) {
    u8 *h
    kind := rawOpen(path.ptr, path.len, &h)
    if kind != 0 {
        return sqlError(kind)
    }
    return Db{handle: h}
}

// Closes the database, and the statements it kept. Its Rows are closed
// before it.
pub void Db.close() {
    rawClose(self.handle)
    self.handle = null
}

// A Value as the runtime binds it: its kind (0 int, 1 float, 2 text, 3
// NULL, 4 blob) and what it holds.
i32 valueOf(Value v, i64 *iv, f64 *fv, u8 **ptr, i64 *len) => match v {
    .int(n) => {
        *iv = n
        0
    }
    .float(f) => {
        *fv = f
        1
    }
    .text(t) => {
        *ptr = t.ptr
        *len = t.len
        2
    }
    .blob(b) => {
        *ptr = b.ptr
        *len = b.len
        4
    }
    .none => 3
}

// The first statement of sql with args bound, kept to be used again;
// rawGive hands it back. *more is true when another statement follows.
!u8 *Db.prepare(str sql, bool *more, Value[] args) {
    u8 *stmt
    i64 after
    kind := rawTake(self.handle, sql.ptr, sql.len, &stmt, &after)
    if kind != 0 {
        return sqlError(kind)
    }
    *more = after != 0
    if stmt == null {
        return stmt
    }
    want := rawParams(self.handle, stmt)
    if want != args.len {
        rawGive(self.handle, stmt)
        return error(SqliteError.failed, "the SQL has {want} ? but {args.len} value{if args.len == 1 { "" } else { "s" }} were given")
    }
    for i in 0..args.len {
        i64 iv
        f64 fv
        u8 *ptr
        i64 len
        what := valueOf(args[i], &iv, &fv, &ptr, &len)
        k := rawBind(self.handle, stmt, i + 1, what, iv, fv, ptr, len)
        if k != 0 {
            rawGive(self.handle, stmt)
            return sqlError(k)
        }
    }
    return stmt
}

// Runs SQL that gives no rows: CREATE, INSERT, UPDATE, DELETE. Each ? takes
// the next of args. Without args, sql can hold several statements; with
// args, only one, and more after it is an error.
pub !void Db.exec(str sql, Value[] args = []) {
    bool more
    stmt := try self.prepare(sql, &more, args)
    if stmt == null {
        return
    }
    if more {
        rawGive(self.handle, stmt)
        if args.len > 0 {
            return error(SqliteError.failed, "exec with values runs one statement, and the SQL has more after it")
        }
        try self.script(sql)
        return
    }
    defer rawGive(self.handle, stmt)
    try run(self.handle, stmt)
}

// Runs a statement to its end.
!void run(u8 *db, u8 *stmt) {
    for {
        r := rawStep(db, stmt)
        if r < 0 {
            return sqlError(-r)
        }
        if r == 0 {
            return
        }
    }
}

// Runs each statement of sql in turn.
!void Db.script(str sql) {
    i64 at
    for {
        u8 *stmt
        kind := rawPrepare(self.handle, sql.ptr, sql.len, &at, &stmt)
        if kind != 0 {
            return sqlError(kind)
        }
        if stmt == null {
            return
        }
        run(self.handle, stmt) catch e {
            rawFinalize(self.handle, stmt)
            return e
        }
        rawFinalize(self.handle, stmt)
    }
}

// Runs a query; its rows come one at a time from Rows.next.
pub !Rows Db.query(str sql, Value[] args = []) {
    bool more
    stmt := try self.prepare(sql, &more, args)
    if stmt == null {
        return error(SqliteError.failed, "the query is empty")
    }
    return Rows{db: self.handle, stmt: stmt}
}

// The rowid of the last row INSERT added.
pub i64 Db.lastId() => rawLastId(self.handle)

// How many rows the last INSERT, UPDATE or DELETE changed.
pub i64 Db.changes() => rawChanges(self.handle)

// Starts a transaction.
pub !void Db.begin() => try self.exec("BEGIN")

// Makes the transaction's changes last.
pub !void Db.commit() => try self.exec("COMMIT")

// Drops the transaction's changes.
pub !void Db.rollback() => try self.exec("ROLLBACK")

// The rows of a query. close gives it back.
pub struct Rows {
    u8 *db
    u8 *stmt
    bool done
    u8 *memo // which field each column fills, for scan
}

// Moves to the next row: false when there are no more.
pub !bool Rows.next() {
    if self.done {
        return false
    }
    r := rawStep(self.db, self.stmt)
    if r < 0 {
        return sqlError(-r)
    }
    if r == 0 {
        self.done = true
        return false
    }
    return true
}

// The number of columns.
pub i64 Rows.columns() => rawColumns(self.db, self.stmt)

// A column's name.
pub str Rows.name(i64 col) {
    i64 n
    p := rawName(self.db, self.stmt, col, &n)
    return p[0:n]
}

// A column as an integer.
pub i64 Rows.int(i64 col) => rawInt(self.db, self.stmt, col)

// A column as a float.
pub f64 Rows.float(i64 col) => rawFloat(self.db, self.stmt, col)

// A column as text, valid until the next call to next.
pub str Rows.text(i64 col) {
    i64 n
    p := rawText(self.db, self.stmt, col, &n)
    return p[0:n]
}

// A column's bytes as they are, for a BLOB; valid until the next call to
// next. A String field of a @json struct gets them too.
pub u8[] Rows.bytes(i64 col) {
    i64 n
    p := rawBlob(self.db, self.stmt, col, &n)
    return p[0:n]
}

// Whether a column is NULL.
pub bool Rows.isNull(i64 col) => rawType(self.db, self.stmt, col) == 5

// Ends the query; the row's text is gone after it.
pub void Rows.close() {
    rawGive(self.db, self.stmt)
    self.stmt = null
    rawMapFree(self.memo)
    self.memo = null
}

// close, for scoped.
pub void Rows.free() => self.close()

// Fills a @json struct from the row: each field from the column of the
// same name (or its @json name). A NULL column leaves the field as it is.
pub !void scan[T](Rows *rows, T *out) {
    str table
    i64 id
    if rawScan(rows.db, rows.stmt, rawEntity(entityOf(out), &table, &id), out, &rows.memo) != 0 {
        return error(SqliteError.failed, "{message()}")
    }
}

// Every row of a query, as @json structs: sqlite.all[User](&db, "SELECT ...").
// The values' Strings are the caller's to free.
pub !List[T] all[T](Db *db, str sql, Value[] args = []) {
    rows := try db.query(sql, args)
    defer rows.close()
    List[T] out
    for {
        more := rows.next() catch e {
            out.freeEach()
            return e
        }
        if !more {
            return out
        }
        T v
        scan(&rows, &v) catch e {
            v.free()
            out.freeEach()
            return e
        }
        out.push(v)
    }
}

// The first row of a query, as a @json struct. A query with no rows fails
// with SqliteError.noRows.
pub !T one[T](Db *db, str sql, Value[] args = []) {
    rows := try db.query(sql, args)
    defer rows.close()
    if !(try rows.next()) {
        return error(SqliteError.noRows, "the query has no rows")
    }
    T v
    scan(&rows, &v) catch e {
        v.free()
        return e
    }
    return v
}

// ------------------------------------------------------------ rows from structs

@builtin
void entityOf()

@builtin
void rowOf()

@extern("iris_sql_entity")
u8 *rawEntity(u8 *e, str *table, i64 *id)

@extern("iris_sql_fields")
i64 rawFields(u8 *table)

@extern("iris_sql_field")
i64 rawField(u8 *table, u8 *row, i64 i, str *name, i64 *iv, f64 *fv, str *text, String *tmp)

@extern("iris_pg_scan")
i32 rawScanText(u8 *table, u8 *out, str *names, str *values, u8 *nulls, i64 n)

@extern("iris_pg_message_ptr")
u8 *textMessagePtr()

@extern("iris_pg_message_len")
i64 textMessageLen()

// An @entity struct's row: its table, the JSON table with its column names,
// and the number of its @id field.
struct Entity {
    str table
    u8 *cols
    i64 id
}

// From rowOf in the public call, so a struct without @entity is an error
// where it is called.
Entity entityFor(u8 *row) {
    Entity e
    e.cols = rawEntity(row, &e.table, &e.id)
    return e
}

// The table a call works on: the one given, else the struct's @entity.
str tableFor(Entity *e, str table) => if table.len > 0 { table } else { e.table }

bool skipped(str[] skip, str name) {
    for s in skip {
        if s == name {
            return true
        }
    }
    return false
}

// The numbers and columns of row's fields that go in a statement: all but
// those named in skip and the @id when skipId.
void columnsOf[T](Entity *e, T *row, str[] skip, bool skipId, List[i64] *which, List[str] *names) {
    for i in 0..rawFields(e.cols) {
        name := columnOf(e, row, i)
        if (skipId && i == e.id) || skipped(skip, name) {
            continue
        }
        which.push(i)
        names.push(name)
    }
}

// A kept statement for sql, which has one statement and the values the
// caller binds.
!u8 *Db.statement(str sql) {
    u8 *stmt
    i64 more
    kind := rawTake(self.handle, sql.ptr, sql.len, &stmt, &more)
    if kind != 0 {
        return sqlError(kind)
    }
    return stmt
}

// Whether row's @id is 0 or empty, so the database fills it.
bool idZero[T](Entity *e, T *row) {
    if e.id < 0 {
        return false
    }
    str name
    i64 iv
    f64 fv
    str text
    String tmp
    kind := rawField(e.cols, row, e.id, &name, &iv, &fv, &text, &tmp)
    tmp.free()
    return if kind == 2 { text.len == 0 } else if kind == 1 { fv == 0.0 } else { iv == 0 }
}

// Whether row's @id is a whole number, which an AUTO_INCREMENT id can go in.
bool intId[T](Entity *e, T *row) {
    str name
    i64 iv
    f64 fv
    str text
    String tmp
    kind := rawField(e.cols, row, e.id, &name, &iv, &fv, &text, &tmp)
    tmp.free()
    return kind == 0
}

// The column of field number i.
str columnOf[T](Entity *e, T *row, i64 i) {
    str name
    i64 iv
    f64 fv
    str text
    String tmp
    _ = rawField(e.cols, row, i, &name, &iv, &fv, &text, &tmp)
    tmp.free()
    return name
}

// A column name in double quotes, so any name works.
void putName(String *sql, str name) {
    sql.append("\"")
    i64 from = 0
    for i in 0..name.len {
        if name[i] == '"' {
            sql.append(name[from:i + 1])
            sql.append("\"")
            from = i + 1
        }
    }
    sql.append(name[from:name.len])
    sql.append("\"")
}

// INSERT INTO table (columns) VALUES and n rows of placeholders.
void insertSql(String *sql, str table, str[] names, i64 n) {
    sql.append("INSERT INTO ")
    sql.append(table)
    sql.append(" (")
    for i, name in names {
        if i > 0 {
            sql.append(", ")
        }
        putName(sql, name)
    }
    sql.append(") VALUES ")
    for r in 0..n {
        sql.append(if r > 0 { ", (" } else { "(" })
        for i in 0..names.len {
            if i > 0 {
                sql.append(", ")
            }
            sql.append("?")
        }
        sql.append(")")
    }
}

// Sets the column col of row from text, as a row read back would.
!void setColumn[T](Entity *e, T *row, str col, str value) {
    str[] names = alloc(str, 1)
    defer free(names)
    str[] values = alloc(str, 1)
    defer free(values)
    u8[] nulls = alloc(u8, 1)
    defer free(nulls)
    names[0] = col
    values[0] = value
    nulls[0] = 0
    if rawScanText(e.cols, row, names.ptr, values.ptr, nulls.ptr, 1) != 0 {
        return error(SqliteError.failed, "{textMessagePtr()[0:textMessageLen()]}")
    }
}

// Adds an @entity struct as a row: the id an AUTO_INCREMENT column gave it,
// or 0. Each field goes in its column: the field's name, or its @column
// name. An @id of 0 or "" is left out and set from that id:
// sqlite.insert(&db, &user). table puts it in another table, skip leaves
// out columns the database fills, and returning reads columns back:
// sqlite.insert(&db, &u, skip: ["created_at"], returning: ["created_at"]).
pub !i64 insert[T](Db *db, T *row, str table = "", str[] skip = [], str[] returning = []) {
    e := entityFor(rowOf(row))
    name := tableFor(&e, table)
    auto := idZero(&e, row)
    scoped List[i64] which
    scoped List[str] names
    columnsOf(&e, row, skip, auto, &which, &names)
    if which.len == 0 {
        return error(SqliteError.failed, "the row has no fields to insert")
    }
    scoped String sql
    insertSql(&sql, name, names.items(), 1)
    if returning.len > 0 {
        sql.append(" RETURNING ")
        for i, col in returning {
            if i > 0 {
                sql.append(", ")
            }
            putName(&sql, col)
        }
    }
    stmt := try db.statement(sql)
    defer rawGive(db.handle, stmt)
    i64 id
    u8 *memo
    defer rawMapFree(memo)
    k := rawInsert(db.handle, stmt, e.cols, row, which.items().ptr, which.len, returning.len, &id, &memo)
    if k != 0 {
        return sqlError(k)
    }
    if auto && id > 0 && intId(&e, row) {
        scoped String text = format("{id}")
        try setColumn(&e, row, columnOf(&e, row, e.id), text)
    }
    return id
}

// Adds structs as rows, as insert does, many to a statement: how many were
// added. The @id is left out when every row's is 0 or "". A statement takes
// at most 32766 values, so a long list goes in several, which a transaction
// makes all or nothing.
pub !i64 insertMany[T](Db *db, T[] rows, str table = "", str[] skip = []) {
    if rows.len == 0 {
        return 0
    }
    e := entityFor(rowOf(&rows[0]))
    name := tableFor(&e, table)
    bool auto = e.id >= 0
    for i in 0..rows.len {
        auto = auto && idZero(&e, &rows[i])
    }
    scoped List[i64] which
    scoped List[str] names
    columnsOf(&e, &rows[0], skip, auto, &which, &names)
    if which.len == 0 {
        return error(SqliteError.failed, "the rows have no fields to insert")
    }
    scoped String sql
    insertSql(&sql, name, names.items(), 1)
    stmt := try db.statement(sql)
    defer rawGive(db.handle, stmt)
    for i in 0..rows.len {
        i64 id
        k := rawInsert(db.handle, stmt, e.cols, &rows[i], which.items().ptr, which.len, 0, &id, null)
        if k != 0 {
            return sqlError(k)
        }
    }
    return rows.len
}

// The row of an @entity struct whose @id is id: sqlite.find[User](&db,
// .int(7)). No row fails with SqliteError.noRows.
pub !T find[T](Db *db, Value id) {
    T v
    ent := rowOf(&v)
    i64 iv
    f64 fv
    u8 *ptr
    i64 len
    kind := valueOf(id, &iv, &fv, &ptr, &len)
    r := rawFind(db.handle, ent, kind, iv, fv, ptr, len, &v)
    if r < 0 {
        v.free()
        return sqlError(-r)
    }
    if r == 0 {
        e := entityFor(ent)
        return error(SqliteError.noRows, "{e.table} has no row with that id")
    }
    return v
}

// Writes every field of an @entity struct to its row, found by the @id:
// how many rows changed, 0 when there is none.
pub !i64 update[T](Db *db, T *row) {
    n := rawUpdate(db.handle, rowOf(row), row)
    if n < 0 {
        return sqlError(i32(-n))
    }
    return n
}

// Removes the row of an @entity struct whose @id is id:
// sqlite.delete[User](&db, .int(7)). It gives how many rows went, 0 or 1.
pub !i64 delete[T](Db *db, Value id) {
    T v
    i64 iv
    f64 fv
    u8 *ptr
    i64 len
    kind := valueOf(id, &iv, &fv, &ptr, &len)
    n := rawDelete(db.handle, rowOf(&v), kind, iv, fv, ptr, len)
    if n < 0 {
        return sqlError(i32(-n))
    }
    return n
}
