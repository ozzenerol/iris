// Waiting for and limiting other tasks and threads, and sharing data
// between them: wait groups, semaphores, run-once, read-write locks, a pool
// of worker tasks, a Map many threads can use and a value behind a lock.
// Each works between tasks of one thread and between threads.

// Waits for a number of tasks or threads to finish: add before starting
// each, done when each ends, and wait until all are. A WaitGroup can't be
// copied; pass a pointer to it.
pub struct WaitGroup {
    Mutex lock
    i64 count
    List[chan[bool]] waiters
}

// n more to wait for.
pub void WaitGroup.add(i64 n = 1) {
    self.lock.lock()
    self.count += n
    if self.count < 0 {
        self.lock.unlock()
        panic("WaitGroup count below 0")
    }
    if self.count == 0 {
        self.wakeAll()
    }
    self.lock.unlock()
}

// One of them is finished.
pub void WaitGroup.done() => self.add(-1)

// Waits until the count is 0.
pub void WaitGroup.wait() {
    self.lock.lock()
    if self.count == 0 {
        self.lock.unlock()
        return
    }
    ch := chan[bool](1)
    self.waiters.push(ch)
    self.lock.unlock()
    _ = <-ch
    ch.free()
}

// the lock is held
void WaitGroup.wakeAll() {
    for ch in self.waiters {
        ch <- true
    }
    self.waiters.clear()
}

// Gives the WaitGroup's memory back; nothing may be waiting on it.
pub void WaitGroup.free() {
    self.waiters.free()
}

// Lets at most a number of callers in at once; the others wait for a
// release.
pub struct Semaphore {
    chan[bool] slots
}

// A Semaphore that lets n in at once.
pub Semaphore semaphore(i64 n) {
    if n < 1 {
        panic("a semaphore needs room for at least 1, not {n}")
    }
    s := Semaphore{slots: chan[bool](n)}
    for _ in 0..n {
        s.slots <- true
    }
    return s
}

// Waits for a place, and takes it.
pub void Semaphore.acquire() {
    _ = <-self.slots
}

// Gives a place back.
pub void Semaphore.release() {
    self.slots <- true
}

// Gives the Semaphore's memory back; nothing may be waiting on it.
pub void Semaphore.free() {
    // the places still in the channel are bools, which own nothing
    self.slots.free()
}

// Runs a function once, the first time run is called, and makes every
// other caller wait until it has finished. A Once can't be copied.
pub struct Once {
    Mutex lock
    Atomic[i64] finished
}

// Calls f, unless it has been called already.
pub void Once.run(void() f) {
    if self.finished.load() == 1 {
        return
    }
    self.lock.lock()
    if self.finished.load() == 0 {
        f()
        self.finished.store(1)
    }
    self.lock.unlock()
}

// Whether the function has run.
pub bool Once.done() => self.finished.load() == 1

// Many readers at once, or one writer. A writer that waits keeps new
// readers out, and a writer that finishes lets the waiting readers in
// before the next writer, so neither waits for ever. An RwLock can't be
// copied.
pub struct RwLock {
    Mutex keep   // not used: it only stops the RwLock being copied
    i64[8] state // the runtime's lock word and queues
}

@extern("iris_rw_read_lock")
void rawReadLock(i64 *l)

@extern("iris_rw_read_unlock")
i32 rawReadUnlock(i64 *l)

@extern("iris_rw_write_lock")
void rawWriteLock(i64 *l)

@extern("iris_rw_write_unlock")
i32 rawWriteUnlock(i64 *l)

// Waits until no writer has the lock or waits for it, then reads.
pub void RwLock.readLock() => rawReadLock(&self.state[0])

// One reader is finished.
pub void RwLock.readUnlock() {
    if rawReadUnlock(&self.state[0]) == 0 {
        panic("readUnlock of an RwLock that isn't read-locked")
    }
}

// Waits until no one reads or writes, then writes.
pub void RwLock.writeLock() => rawWriteLock(&self.state[0])

// The writer is finished: the waiting readers go first, then the next
// writer.
pub void RwLock.writeUnlock() {
    if rawWriteUnlock(&self.state[0]) == 0 {
        panic("writeUnlock of an RwLock that isn't write-locked")
    }
}

// Gives the RwLock's memory back: it holds none, so this only marks the end
// of its use.
pub void RwLock.free() {}

// A job for the workers, or the sign to stop.
struct Job[T] {
    T value
    bool stop
}

// A number of tasks that take jobs from a queue and hand each to one
// function: work that waits, such as requests to other servers, done a few
// at a time. The tasks run on the thread that made the Workers.
pub struct Workers[T] {
    chan[Job[T]] jobs
    chan[bool] finished
    i64 count
}

// n tasks, each calling handle with the jobs given to submit. queue jobs
// can wait to be taken before submit waits too.
pub Workers[T] workers[T](i64 n, void(T) handle, i64 queue = 64) {
    if n < 1 {
        panic("workers needs at least 1 task, not {n}")
    }
    w := Workers[T]{jobs: chan[Job[T]](queue), finished: chan[bool](n), count: n}
    for _ in 0..n {
        spawn work(w.jobs, w.finished, handle)
    }
    return w
}

void work[T](chan[Job[T]] jobs, chan[bool] finished, void(T) handle) {
    for {
        j := <-jobs
        if j.stop {
            finished <- true
            return
        }
        handle(j.value)
    }
}

// Hands a job to the next task that is free, waiting while the queue is
// full.
pub void Workers[T].submit(T job) {
    self.jobs <- Job[T]{value: job}
}

// Waits for every job given so far to be done, then stops the tasks and
// gives the Workers' memory back.
pub void Workers[T].finish() {
    for _ in 0..self.count {
        self.jobs <- Job[T]{stop: true}
    }
    for _ in 0..self.count {
        _ = <-self.finished
    }
    self.jobs.free()
    self.finished.free()
}

// One part of a sync.Map: its own lock and the keys that hash to it.
struct Shard[K, V] {
    Mutex lock
    core.Map[K, V] map
    i64[6] pad // 128 bytes a shard, so two threads on two shards don't share a cache line
}

@builtin
u64 hashOf()

// A Map that many tasks and threads can use at once. The keys are spread
// over 32 parts, each with its own lock, so callers that use different
// keys seldom wait for each other. Keys are as in a Map: integers, bool,
// enums, pointers, str or String, and a str or String key is copied. A
// value is copied in and out, so a value that owns memory, such as a
// String, belongs to whoever frees it: take and swap give the old one
// back. A sync.Map can't be copied; keep it in a global or a struct.
pub struct Map[K, V] {
    Shard[K, V][32] shards
}

Shard[K, V] *Map[K, V].shardOf(K k) => &self.shards[i64((hashOf(k) >> 40) & 31)]

// Sets the value of k, adding k if it isn't there.
pub void Map[K, V].set(K k, V v) {
    s := self.shardOf(k)
    s.lock.lock()
    s.map.set(k, v)
    s.lock.unlock()
}

// The value of k, and whether k is there.
pub (V, bool) Map[K, V].get(K k) {
    s := self.shardOf(k)
    s.lock.lock()
    v, found := s.map.get(k)
    s.lock.unlock()
    return (v, found)
}

// The value of k, or fallback when k isn't there.
pub V Map[K, V].getOr(K k, V fallback) {
    v, found := self.get(k)
    return if found { v } else { fallback }
}

// Whether k is there.
pub bool Map[K, V].has(K k) {
    _, found := self.get(k)
    return found
}

// The value of k and true when k is there; otherwise sets k to v and
// gives v and false. Of many callers that try at once, one sets the value
// and the others get it.
pub (V, bool) Map[K, V].getOrSet(K k, V v) {
    s := self.shardOf(k)
    s.lock.lock()
    old, found := s.map.get(k)
    if !found {
        s.map.set(k, v)
        old = v
    }
    s.lock.unlock()
    return (old, found)
}

// Sets k to v and gives the value it had, and whether it had one.
pub (V, bool) Map[K, V].swap(K k, V v) {
    s := self.shardOf(k)
    s.lock.lock()
    old, found := s.map.get(k)
    s.map.set(k, v)
    s.lock.unlock()
    return (old, found)
}

// Sets k to f(value, found), where found says whether k was there, and
// gives the new value. f runs with k's part locked, so no other caller
// changes k in between; it must not use the map itself.
pub V Map[K, V].update(K k, V(V, bool) f) {
    s := self.shardOf(k)
    s.lock.lock()
    old, found := s.map.get(k)
    v := f(old, found)
    s.map.set(k, v)
    s.lock.unlock()
    return v
}

// Takes k out; false when it wasn't there.
pub bool Map[K, V].remove(K k) {
    _, found := self.take(k)
    return found
}

// Takes k out and gives its value, and whether k was there.
pub (V, bool) Map[K, V].take(K k) {
    s := self.shardOf(k)
    s.lock.lock()
    v, found := s.map.get(k)
    if found {
        s.map.remove(k)
    }
    s.lock.unlock()
    return (v, found)
}

// The number of keys. Other callers may change it right after.
pub i64 Map[K, V].len() {
    i64 n = 0
    for i in 0..32 {
        s := &self.shards[i]
        s.lock.lock()
        n += s.map.len
        s.lock.unlock()
    }
    return n
}

// Calls f with each key and value, in no particular order. Each part is
// locked while f runs on its keys, so f must not use the map itself. Keys
// set or taken out by others meanwhile may or may not be seen.
pub void Map[K, V].each(void(K, V) f) {
    for i in 0..32 {
        s := &self.shards[i]
        s.lock.lock()
        for k, v in s.map {
            f(k, v)
        }
        s.lock.unlock()
    }
}

// Takes every key out and keeps the memory.
pub void Map[K, V].clear() {
    for i in 0..32 {
        s := &self.shards[i]
        s.lock.lock()
        s.map.clear()
        s.lock.unlock()
    }
}

// Gives the map's memory back; the map is empty after. Nothing else may
// use it meanwhile.
pub void Map[K, V].free() {
    for i in 0..32 {
        self.shards[i].map.free()
    }
}

// A value and the Mutex that guards it: the value is reached only with the
// lock held. Any value can be shared this way, such as a List, a Deque or a
// SortedMap. A Locked can't be copied; keep it in a global or a struct.
pub struct Locked[T] {
    Mutex m
    T value
}

// Waits for the lock, takes it and gives the value. Call unlock when done
// with it, and don't keep the pointer after.
pub T *Locked[T].lock() {
    self.m.lock()
    return &self.value
}

// Gives the lock back.
pub void Locked[T].unlock() => self.m.unlock()

// Calls f with the value, holding the lock while it runs.
pub void Locked[T].with(void(T *) f) {
    self.m.lock()
    f(&self.value)
    self.m.unlock()
}
