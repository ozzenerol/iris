// Time: the wall clock, a clock for measuring, and dates. A Time is a
// moment; it is shown in UTC unless local() or an offset says otherwise.

import str

pub enum TimeError { invalid }

pub enum Weekday { monday, tuesday, wednesday, thursday, friday, saturday, sunday }

// A moment: nanoseconds since 1970-01-01 00:00 UTC, and the offset of the
// time zone it is shown in, in seconds east of UTC.
pub struct Time {
    pub i64 ns
    pub i32 offset
}

@extern("iris_time_now")
i64 rawNow()

@extern("iris_time_clock")
i64 rawClock()

@extern("iris_time_offset")
i32 rawOffset(i64 unixSeconds)

const NS = 1000000000

// Now, in UTC.
pub Time now() => Time{ns: rawNow()}

// A clock that only goes forward, for measuring: the difference of two
// readings is the time between them.
pub Duration clock() => rawClock()

// The moment a number of seconds after 1970-01-01 00:00 UTC.
pub Time unix(i64 seconds) => Time{ns: seconds * NS}

// A date and time in UTC. month is 1 to 12.
pub Time date(i64 year, i64 month, i64 day, i64 hour = 0, i64 minute = 0, i64 second = 0) {
    days := daysFromCivil(year, month, day)
    return Time{ns: ((days * 24 + hour) * 60 + minute) * 60 * NS + second * NS}
}

i64 floorDiv(i64 a, i64 b) {
    q := a / b
    return if (a % b != 0) && ((a < 0) != (b < 0)) { q - 1 } else { q }
}

// Days since 1970-01-01 of a date (proleptic Gregorian).
i64 daysFromCivil(i64 year, i64 month, i64 day) {
    y := if month <= 2 { year - 1 } else { year }
    era := floorDiv(y, 400)
    yoe := y - era * 400
    mp := if month > 2 { month - 3 } else { month + 9 }
    doy := (153 * mp + 2) / 5 + day - 1
    doe := yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468
}

(i64, i64, i64) civilFromDays(i64 days) {
    z := days + 719468
    era := floorDiv(z, 146097)
    doe := z - era * 146097
    yoe := (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    doy := doe - (365 * yoe + yoe / 4 - yoe / 100)
    mp := (5 * doy + 2) / 153
    d := doy - (153 * mp + 2) / 5 + 1
    m := if mp < 10 { mp + 3 } else { mp - 9 }
    y := yoe + era * 400 + (if m <= 2 { 1 } else { 0 })
    return (y, m, d)
}

// Seconds and nanoseconds of the moment as shown, with the offset added.
(i64, i64) Time.shown() {
    t := self.ns + i64(self.offset) * NS
    return (floorDiv(t, NS), t - floorDiv(t, NS) * NS)
}

// The same moment in the computer's time zone.
pub Time Time.local() => Time{ns: self.ns, offset: rawOffset(floorDiv(self.ns, NS))}

// The same moment in UTC.
pub Time Time.utc() => Time{ns: self.ns}

// The same moment shown with an offset in seconds east of UTC.
pub Time Time.withOffset(i32 seconds) => Time{ns: self.ns, offset: seconds}

pub Time Time.add(Duration d) => Time{ns: self.ns + d, offset: self.offset}

// The time from other to this moment.
pub Duration Time.sub(Time other) => self.ns - other.ns

pub bool Time.before(Time other) => self.ns < other.ns

pub bool Time.after(Time other) => self.ns > other.ns

// Seconds since 1970-01-01 00:00 UTC.
pub i64 Time.unix() => floorDiv(self.ns, NS)

// Milliseconds since 1970-01-01 00:00 UTC.
pub i64 Time.unixMs() => floorDiv(self.ns, 1000000)

pub i64 Time.year() {
    secs, _ := self.shown()
    y, _, _ := civilFromDays(floorDiv(secs, 86400))
    return y
}

// 1 to 12.
pub i64 Time.month() {
    secs, _ := self.shown()
    _, m, _ := civilFromDays(floorDiv(secs, 86400))
    return m
}

// 1 to 31.
pub i64 Time.day() {
    secs, _ := self.shown()
    _, _, d := civilFromDays(floorDiv(secs, 86400))
    return d
}

pub i64 Time.hour() {
    secs, _ := self.shown()
    return (secs - floorDiv(secs, 86400) * 86400) / 3600
}

pub i64 Time.minute() {
    secs, _ := self.shown()
    return (secs - floorDiv(secs, 3600) * 3600) / 60
}

pub i64 Time.second() {
    secs, _ := self.shown()
    return secs - floorDiv(secs, 60) * 60
}

pub i64 Time.nanosecond() {
    _, ns := self.shown()
    return ns
}

pub Weekday Time.weekday() {
    secs, _ := self.shown()
    days := floorDiv(secs, 86400)
    n := days + 3 - floorDiv(days + 3, 7) * 7 // 1970-01-01 was a Thursday
    return match n { 0 => .monday, 1 => .tuesday, 2 => .wednesday, 3 => .thursday, 4 => .friday,
        5 => .saturday, _ => .sunday }
}

void pad(String *out, i64 v, i64 width) {
    scoped String digits = format("{v}")
    for i in digits.len..width {
        out.append("0")
    }
    out.append(digits)
}

// The moment written with a layout: YYYY year, MM month, DD day, hh hour,
// mm minute, ss second, SSS milliseconds, Z the offset (Z for UTC, else
// +02:00). Other characters are copied.
pub String Time.format(str layout) {
    secs, ns := self.shown()
    y, mo, d := civilFromDays(floorDiv(secs, 86400))
    rest := secs - floorDiv(secs, 86400) * 86400
    String out
    i := 0
    for i < layout.len {
        tail := layout[i:]
        if str.startsWith(tail, "YYYY") {
            pad(&out, y, 4)
            i += 4
        } else if str.startsWith(tail, "MM") {
            pad(&out, mo, 2)
            i += 2
        } else if str.startsWith(tail, "DD") {
            pad(&out, d, 2)
            i += 2
        } else if str.startsWith(tail, "hh") {
            pad(&out, rest / 3600, 2)
            i += 2
        } else if str.startsWith(tail, "mm") {
            pad(&out, rest % 3600 / 60, 2)
            i += 2
        } else if str.startsWith(tail, "ss") {
            pad(&out, rest % 60, 2)
            i += 2
        } else if str.startsWith(tail, "SSS") {
            pad(&out, ns / 1000000, 3)
            i += 3
        } else if layout[i] == 'Z' {
            if self.offset == 0 {
                out.append("Z")
            } else {
                o := i64(self.offset)
                out.append(if o < 0 { "-" } else { "+" })
                if o < 0 {
                    o = -o
                }
                pad(&out, o / 3600, 2)
                out.append(":")
                pad(&out, o % 3600 / 60, 2)
            }
            i += 1
        } else {
            out.append(layout[i:i + 1])
            i += 1
        }
    }
    return out
}

// ISO 8601, as in 2026-10-17T09:30:00Z, with the fraction of a second when
// there is one.
pub String Time.iso() {
    _, ns := self.shown()
    if ns == 0 {
        return self.format("YYYY-MM-DDThh:mm:ssZ")
    }
    String out = self.format("YYYY-MM-DDThh:mm:ss")
    scoped String frac = format("{ns + NS}")
    end := frac.len
    for end > 2 && frac[end - 1] == '0' {
        end -= 1
    }
    out.append(".")
    out.append(frac[1:end])
    scoped String zone = self.format("Z")
    out.append(zone)
    return out
}

// The date, as in 2026-10-17.
pub String Time.dateText() => self.format("YYYY-MM-DD")

!i64 digits(str s, i64 at, i64 n) {
    if at + n > s.len {
        return error(TimeError.invalid, "'{s}' is too short for ISO 8601")
    }
    i64 v
    for i in at..at + n {
        c := s[i]
        if c < '0' || c > '9' {
            return error(TimeError.invalid, "'{s}' has '{s[i:i + 1]}' where a digit should be")
        }
        v = v * 10 + i64(c - '0')
    }
    return v
}

// Reads ISO 8601: 2026-10-17, 2026-10-17T09:30, 2026-10-17T09:30:00Z,
// 2026-10-17 09:30:00.250+02:00. Without an offset it is UTC.
pub !Time parse(str s) {
    y := try digits(s, 0, 4)
    if s.len < 10 || s[4] != '-' || s[7] != '-' {
        return error(TimeError.invalid, "'{s}' is not an ISO 8601 date: YYYY-MM-DD")
    }
    mo := try digits(s, 5, 2)
    d := try digits(s, 8, 2)
    if mo < 1 || mo > 12 || d < 1 || d > 31 {
        return error(TimeError.invalid, "'{s}' has no such month or day")
    }
    i64 h
    i64 mi
    i64 sec
    i64 frac
    i64 offset
    i := 10
    if i < s.len && (s[i] == 'T' || s[i] == ' ') {
        h = try digits(s, 11, 2)
        if s.len < 16 || s[13] != ':' {
            return error(TimeError.invalid, "'{s}' needs hh:mm after the date")
        }
        mi = try digits(s, 14, 2)
        i = 16
        if i < s.len && s[i] == ':' {
            sec = try digits(s, 17, 2)
            i = 19
            if i < s.len && (s[i] == '.' || s[i] == ',') {
                i += 1
                scale := NS / 10
                for i < s.len && s[i] >= '0' && s[i] <= '9' {
                    frac += i64(s[i] - '0') * scale
                    scale /= 10
                    i += 1
                }
            }
        }
        if h > 23 || mi > 59 || sec > 60 {
            return error(TimeError.invalid, "'{s}' has no such time of day")
        }
        if i < s.len && s[i] == 'Z' {
            i += 1
        } else if i < s.len && (s[i] == '+' || s[i] == '-') {
            oh := try digits(s, i + 1, 2)
            om := if i + 3 < s.len && s[i + 3] == ':' { try digits(s, i + 4, 2) } else { try digits(s, i + 3, 2) }
            offset = (oh * 3600 + om * 60) * (if s[i] == '-' { -1 } else { 1 })
            i += if i + 3 < s.len && s[i + 3] == ':' { 6 } else { 5 }
        }
    }
    if i != s.len {
        return error(TimeError.invalid, "'{s}' has more after the time")
    }
    t := date(y, mo, d, h, mi, sec)
    return Time{ns: t.ns + frac - offset * NS, offset: i32(offset)}
}
