// Files and folders: reading, writing, listing, and files opened for
// reading or writing a part at a time.

import str, time

// What file calls fail with: notFound, permission, exists (for a path that is
// there already), isDir (for a folder where a file is wanted), end, full
// (no space left, or over a quota), and other.
pub enum FsError { notFound, permission, exists, isDir, other, end, full }

@extern("iris_fs_read_all")
i32 rawReadAll(u8 *path, i64 pathLen, String *out)

@extern("iris_fs_write")
i32 rawWrite(u8 *path, i64 pathLen, u8 *data, i64 dataLen, i32 append)

@extern("iris_fs_exists")
i32 rawExists(u8 *path, i64 pathLen)

@extern("iris_fs_remove")
i32 rawRemove(u8 *path, i64 pathLen)

Error fsError(i32 code, str path) => match code {
    1 => error(FsError.notFound, "{path}: no such file")
    2 => error(FsError.permission, "{path}: permission denied")
    3 => error(FsError.exists, "{path}: already exists")
    4 => error(FsError.isDir, "{path}: is a folder")
    6 => error(FsError.end, "{path}: no more to read")
    7 => error(FsError.other, "{path}: isn't a symbolic link")
    8 => error(FsError.full, "{path}: no space left")
    9 => error(FsError.other, "{path}: on another file system")
    _ => error(FsError.other, "{path}: can't be used")
}

// The whole file, as text the caller owns.
pub !String readAll(str path) {
    String s
    code := rawReadAll(path.ptr, path.len, &s)
    if code != 0 {
        return fsError(code, path)
    }
    return s
}

// Replaces the file's contents, creating it if needed.
pub !void writeAll(str path, str data) {
    code := rawWrite(path.ptr, path.len, data.ptr, data.len, 0)
    if code != 0 {
        return fsError(code, path)
    }
}

// Adds to the end of the file, creating it if needed.
pub !void append(str path, str data) {
    code := rawWrite(path.ptr, path.len, data.ptr, data.len, 1)
    if code != 0 {
        return fsError(code, path)
    }
}

// Whether a file or folder exists at path.
pub bool exists(str path) => rawExists(path.ptr, path.len) != 0

// Removes a file.
pub !void remove(str path) {
    code := rawRemove(path.ptr, path.len)
    if code != 0 {
        return fsError(code, path)
    }
}

@extern("iris_fs_stat")
i32 rawStat(u8 *path, i64 pathLen, i64 *size, i32 *isDir, i64 *modified)

@extern("iris_fs_mkdir")
i32 rawMkdir(u8 *path, i64 pathLen, i32 parents)

@extern("iris_fs_rename")
i32 rawRename(u8 *from, i64 fromLen, u8 *to, i64 toLen)

@extern("iris_fs_remove_all")
i32 rawRemoveAll(u8 *path, i64 pathLen)

@extern("iris_fs_dir_open")
u8 *rawDirOpen(u8 *path, i64 pathLen, i32 *err)

@extern("iris_fs_dir_next")
i32 rawDirNext(u8 *dir, String *name, i32 *isDir)

@extern("iris_fs_dir_stat")
i32 rawDirStat(u8 *dir, u8 *name, i64 n, i64 *size, i32 *isDir, i64 *modified)

@extern("iris_fs_dir_close")
void rawDirClose(u8 *dir)

@extern("iris_fs_open")
i32 rawOpen(u8 *path, i64 pathLen, i32 mode, i32 *err)

@extern("iris_fs_read")
i64 rawRead(i32 fd, u8 *buf, i64 len)

@extern("iris_fs_write_fd")
i32 rawWriteFd(i32 fd, u8 *data, i64 len)

@extern("iris_fs_close")
void rawClose(i32 fd)

// What stat tells about a file or folder. mode holds the permission bits
// (0o644: the owner reads and writes, the others read), uid and gid the
// owner and the group, links how many names the file has, and inode its
// number on its file system.
pub struct Info {
    pub i64 size
    pub bool isDir
    pub time.Time modified
    pub time.Time accessed
    pub i64 mode
    pub i64 uid
    pub i64 gid
    pub bool isLink
    pub i64 links
    pub i64 inode
}

@extern("iris_fs_info")
i32 rawInfo(u8 *dir, u8 *path, i64 n, i32 follow, i64 *v)

@extern("iris_fs_file_info")
i32 rawFileInfo(i32 fd, i64 *v)

Info infoFrom(i64[10] v) => Info{size: v[0], isDir: v[1] != 0, modified: time.Time{ns: v[2]},
    accessed: time.Time{ns: v[3]}, mode: v[4], uid: v[5], gid: v[6], isLink: v[7] != 0, links: v[8], inode: v[9]}

// What is at path: its size, kind, times, permissions and owner. A
// symbolic link is followed to what it points to.
pub !Info stat(str path) {
    i64[10] v
    code := rawInfo(null, path.ptr, path.len, 1, &v[0])
    if code != 0 {
        return fsError(code, path)
    }
    return infoFrom(v)
}

// What stat gives, about a symbolic link itself rather than what it
// points to: isLink says it is one.
pub !Info lstat(str path) {
    i64[10] v
    code := rawInfo(null, path.ptr, path.len, 0, &v[0])
    if code != 0 {
        return fsError(code, path)
    }
    return infoFrom(v)
}

@extern("iris_fs_chmod")
i32 rawChmod(u8 *path, i64 n, i64 mode)

@extern("iris_fs_chown")
i32 rawChown(u8 *path, i64 n, i64 uid, i64 gid, i32 follow)

@extern("iris_fs_times")
i32 rawTimes(u8 *path, i64 n, i64 accessed, i64 modified)

@extern("iris_fs_link")
i32 rawLink(u8 *a, i64 an, u8 *b, i64 bn, i32 symbolic)

@extern("iris_fs_readlink")
i32 rawReadLink(u8 *path, i64 n, i32 real, String *out)

@extern("iris_fs_space")
i32 rawSpace(u8 *path, i64 n, i64 *v)

@extern("iris_fs_sync_dir")
i32 rawSyncDir(u8 *path, i64 n)

// Sets the permission bits of path: fs.chmod(path, 0o600) lets only the
// owner read and write it.
pub !void chmod(str path, i64 mode) {
    code := rawChmod(path.ptr, path.len, mode)
    if code != 0 {
        return fsError(code, path)
    }
}

// Gives path to the user uid and the group gid; -1 leaves one as it is.
// Only root may give a file away. A symbolic link is followed, unless
// follow is false.
pub !void chown(str path, i64 uid, i64 gid = -1, bool follow = true) {
    code := rawChown(path.ptr, path.len, uid, gid, if follow { 1 } else { 0 })
    if code != 0 {
        return fsError(code, path)
    }
}

// Sets when path was last read and changed, as SFTP and tar keep them.
pub !void setTimes(str path, time.Time accessed, time.Time modified) {
    code := rawTimes(path.ptr, path.len, accessed.ns, modified.ns)
    if code != 0 {
        return fsError(code, path)
    }
}

// Makes path a symbolic link to target, which needn't exist.
pub !void symlink(str target, str path) {
    code := rawLink(target.ptr, target.len, path.ptr, path.len, 1)
    if code != 0 {
        return fsError(code, path)
    }
}

// Gives the file at existing a second name, path: a hard link, on the
// same file system.
pub !void link(str existing, str path) {
    code := rawLink(existing.ptr, existing.len, path.ptr, path.len, 0)
    if code != 0 {
        return fsError(code, path)
    }
}

// Where the symbolic link at path points, as it was written.
pub !String readLink(str path) {
    String out
    code := rawReadLink(path.ptr, path.len, 0, &out)
    if code != 0 {
        out.free()
        return fsError(code, path)
    }
    return out
}

// The absolute path of path with every symbolic link, . and .. resolved;
// what is there must exist.
pub !String realPath(str path) {
    String out
    code := rawReadLink(path.ptr, path.len, 1, &out)
    if code != 0 {
        out.free()
        return fsError(code, path)
    }
    return out
}

// The room on a file system, in bytes, and the files it can hold.
// available is what users other than root may use.
pub struct Space {
    pub i64 total
    pub i64 free
    pub i64 available
    pub i64 files
    pub i64 freeFiles
    pub i64 blockSize
}

// The room on the file system path is on.
pub !Space space(str path) {
    i64[6] v
    code := rawSpace(path.ptr, path.len, &v[0])
    if code != 0 {
        return fsError(code, path)
    }
    return Space{total: v[0], free: v[1], available: v[2], files: v[3], freeFiles: v[4], blockSize: v[5]}
}

// Makes what was done to the files of the folder at path, made, renamed
// or removed, stay done after a crash: after a rename that replaces a
// file, sync the folder as well as the file.
pub !void syncDir(str path) {
    code := rawSyncDir(path.ptr, path.len)
    if code != 0 {
        return fsError(code, path)
    }
}

// Makes a folder.
pub !void mkdir(str path) {
    code := rawMkdir(path.ptr, path.len, 0)
    if code != 0 {
        return fsError(code, path)
    }
}

// Makes a folder and the folders above it that are missing. A folder that
// is there already is no error.
pub !void mkdirAll(str path) {
    code := rawMkdir(path.ptr, path.len, 1)
    if code != 0 {
        return fsError(code, path)
    }
}

// Moves or renames a file or folder.
pub !void rename(str from, str to) {
    code := rawRename(from.ptr, from.len, to.ptr, to.len)
    if code != 0 {
        return fsError(code, from)
    }
}

// Removes a file, or a folder and everything in it. Nothing at path is no
// error.
pub !void removeAll(str path) {
    code := rawRemoveAll(path.ptr, path.len)
    if code != 0 {
        return fsError(code, path)
    }
}

// A name in a folder.
pub struct Entry {
    pub String name
    pub bool isDir
}

// What is in a folder, sorted by name. free gives the names back.
pub struct Dir {
    pub List[Entry] entries
}

// Frees the names and the list.
pub void Dir.free() {
    for e in self.entries {
        e.name.free()
    }
    self.entries.free()
}

bool byName(Entry a, Entry b) => str.compare(a.name, b.name) < 0

// The files and folders in a folder, without . and ..
pub !Dir readDir(str path) {
    i32 err
    d := rawDirOpen(path.ptr, path.len, &err)
    if err != 0 {
        return fsError(err, path)
    }
    defer rawDirClose(d)
    Dir dir
    for {
        String name
        i32 isDir
        if rawDirNext(d, &name, &isDir) == 0 {
            break
        }
        dir.entries.push(Entry{name: name, isDir: isDir != 0})
    }
    dir.entries.sort(byName)
    return dir
}

// A file opened for reading or writing a part at a time.
pub struct File {
    i32 fd
    u8[] buf
    i64 start
    i64 end
}

!File openMode(str path, i32 mode) {
    i32 err
    fd := rawOpen(path.ptr, path.len, mode, &err)
    if fd < 0 {
        return fsError(err, path)
    }
    return File{fd: fd}
}

// Opens a file for reading.
pub !File open(str path) => try openMode(path, 0)

// Opens a file for writing, making it or emptying it.
pub !File create(str path) => try openMode(path, 1)

// Opens a file for writing at its end, making it if needed.
pub !File openAppend(str path) => try openMode(path, 2)

// Opens a file for reading and writing, as it is, making it when create
// is set and it isn't there: for files read and written in place, at any
// offset.
pub !File openReadWrite(str path, bool create = true) => try openMode(path, if create { 3 } else { 4 })

// Reads into buf: how many bytes, 0 at the end of the file.
pub !i64 File.read(u8[] buf) {
    if self.start < self.end {
        n := if buf.len < self.end - self.start { buf.len } else { self.end - self.start }
        for i in 0..n {
            buf[i] = self.buf[self.start + i]
        }
        self.start += n
        return n
    }
    n := rawRead(self.fd, buf.ptr, buf.len)
    if n < 0 {
        return fsError(i32(-n), "file")
    }
    return n
}

!bool File.fill() {
    if self.start < self.end {
        return true
    }
    if self.buf.len == 0 {
        self.buf = alloc(u8, 64KiB)
    }
    n := rawRead(self.fd, self.buf.ptr, self.buf.len)
    if n < 0 {
        return fsError(i32(-n), "file")
    }
    self.start = 0
    self.end = n
    return n > 0
}

// The next line, without its line break. At the end of the file it fails
// with FsError.end.
pub !String File.readLine() {
    String line
    for {
        more := try self.fill()
        if !more {
            if line.len > 0 {
                return line
            }
            line.free()
            return error(FsError.end, "no more lines")
        }
        for i in self.start..self.end {
            if self.buf[i] == '\n' {
                line.append(self.buf[self.start:i])
                self.start = i + 1
                if line.len > 0 && line.ptr[0:line.len][line.len - 1] == '\r' {
                    String trimmed = line.ptr[0:line.len - 1].copy()
                    line.free()
                    return trimmed
                }
                return line
            }
        }
        line.append(self.buf[self.start:self.end])
        self.start = self.end
    }
}

// The rest of the file.
pub !String File.readAll() {
    String all
    for {
        more := self.fill() catch e {
            all.free()
            return e
        }
        if !more {
            return all
        }
        all.append(self.buf[self.start:self.end])
        self.start = self.end
    }
}

// Writes data at the file's position.
pub !void File.write(str data) {
    code := rawWriteFd(self.fd, data.ptr, data.len)
    if code != 0 {
        return fsError(code, "file")
    }
}

@extern("iris_fs_pread")
i64 rawPread(i32 fd, u8 *buf, i64 len, i64 off)

@extern("iris_fs_pwrite")
i32 rawPwrite(i32 fd, u8 *data, i64 len, i64 off)

@extern("iris_fs_ctl")
i64 rawCtl(i32 fd, i32 op, i64 a, i64 b)

!i64 File.ctl(i32 op, i64 a, i64 b, str what) {
    r := rawCtl(self.fd, op, a, b)
    if r < 0 {
        return fsError(i32(-r), what)
    }
    return r
}

// Reads into buf from offset in the file, without moving its position:
// how many bytes, fewer than buf only at the end of the file.
pub !i64 File.readAt(u8[] buf, i64 offset) {
    i64 got = 0
    for got < buf.len {
        n := rawPread(self.fd, &buf[got], buf.len - got, offset + got)
        if n < 0 {
            return fsError(i32(-n), "file")
        }
        if n == 0 {
            break
        }
        got += n
    }
    return got
}

// Writes data at offset in the file, without moving its position, past
// the end too: the gap reads as zeros.
pub !void File.writeAt(str data, i64 offset) {
    code := rawPwrite(self.fd, data.ptr, data.len, offset)
    if code != 0 {
        return fsError(code, "file")
    }
}

// Moves the file's position, where read and write go on, to offset.
pub !void File.seek(i64 offset) {
    self.start = 0
    self.end = 0
    _ = try self.ctl(5, offset, 0, "file")
}

// What stat tells about the open file.
pub !Info File.info() {
    i64[10] v
    code := rawFileInfo(self.fd, &v[0])
    if code != 0 {
        return fsError(code, "file")
    }
    return infoFrom(v)
}

// Makes what was written stay after a crash or a power cut: returns once
// the data and the file's size and times are on the disk (fsync; on macOS
// F_FULLFSYNC).
pub !void File.sync() {
    _ = try self.ctl(1, 0, 0, "file")
}

// sync for the data alone, and what is needed to read it back, such as a
// new size (fdatasync): enough for a log written in place.
pub !void File.syncData() {
    _ = try self.ctl(2, 0, 0, "file")
}

// Makes the file size bytes long: cut, or grown with zeros that take no
// room on the disk until written.
pub !void File.truncate(i64 size) {
    _ = try self.ctl(3, size, 0, "file")
}

// Sets aside room on the disk for size bytes from offset, so writing them
// later can't fail for lack of space; the file grows to cover them.
pub !void File.allocate(i64 offset, i64 size) {
    _ = try self.ctl(4, offset, size, "file")
}

// Closes the file.
pub void File.close() {
    rawClose(self.fd)
    self.fd = -1
    free(self.buf)
    self.buf = alloc(u8, 0)
}

@extern("iris_fs_map")
i32 rawMap(u8 *path, i64 pathLen, i32 write, i64 size, u8 **ptr, i64 *len)

@extern("iris_mem_map")
u8 *rawMemMap(i64 size)

@extern("iris_mem_unmap")
void rawMemUnmap(u8 *ptr, i64 len)

@extern("iris_mem_sync")
i32 rawMemSync(u8 *ptr, i64 len)

// Memory that the OS fills from a file, or zeroed memory, from mapFile and
// mapMemory. bytes is the memory. Free it with free.
pub struct Mapped {
    pub u8[] bytes
    String path
}

// Maps the whole file at path into memory. The OS reads each part of the
// file when it is first used, so a large file costs nothing until it is
// read. With write, changes to bytes go to the file, and every program
// that maps the same file with write sees them: two processes can share
// memory this way. With write and a size larger than the file, the file
// grows to size first, made if it isn't there. Without write, changes stay
// in this memory.
pub !Mapped mapFile(str path, bool write = false, i64 size = 0) {
    u8 *ptr
    i64 len
    i32 w = 0
    if write {
        w = 1
    }
    code := rawMap(path.ptr, path.len, w, size, &ptr, &len)
    if code != 0 {
        return fsError(code, path)
    }
    m := Mapped{path: format("{path}")}
    if len > 0 {
        m.bytes = ptr[0:len]
    }
    return m
}

// size bytes of zeroed memory straight from the OS, for a large buffer
// that is given back with free as soon as it isn't used.
pub !Mapped mapMemory(i64 size) {
    ptr := rawMemMap(size)
    if ptr == null {
        return error(FsError.other, "can't map {size} bytes of memory")
    }
    return Mapped{bytes: ptr[0:size]}
}

// Writes the changes made so far to the file now, for a mapFile with
// write. Without sync they reach the file at some time after the change.
pub !void Mapped.sync() {
    code := rawMemSync(self.bytes.ptr, self.bytes.len)
    if code != 0 {
        return fsError(code, self.path)
    }
}

// Gives the memory back. A mapFile with write keeps its changes in the
// file.
pub void Mapped.free() {
    rawMemUnmap(self.bytes.ptr, self.bytes.len)
    self.path.free()
    self.bytes = []
}

@extern("iris_fs_copy")
i32 rawCopy(u8 *from, i64 fromLen, u8 *to, i64 toLen)

@extern("iris_fs_temp")
i32 rawTemp(u8 *prefix, i64 prefixLen, u8 *dir, i64 dirLen, i32 folder, String *out)

// Copies the file at from to to, with its permissions. A file at to is
// replaced.
pub !void copy(str from, str to) {
    code := rawCopy(from.ptr, from.len, to.ptr, to.len)
    if code != 0 {
        return fsError(code, if code == 1 || code == 4 { from } else { to })
    }
}

// Makes a new, empty file with a name no other file has, prefix followed
// by a dash and six random characters, and gives its path. It goes in dir,
// or in the system's folder for temporary files ($TMPDIR, or /tmp) when dir
// is "". The caller removes it when done.
pub !String tempFile(str prefix = "iris", str dir = "") {
    String out
    code := rawTemp(prefix.ptr, prefix.len, dir.ptr, dir.len, 0, &out)
    if code != 0 {
        return fsError(code, if dir.len > 0 { dir } else { prefix })
    }
    return out
}

// Makes a new, empty folder with a name no other has, as tempFile does for
// a file, and gives its path. The caller removes it with removeAll.
pub !String tempDir(str prefix = "iris", str dir = "") {
    String out
    code := rawTemp(prefix.ptr, prefix.len, dir.ptr, dir.len, 1, &out)
    if code != 0 {
        return fsError(code, if dir.len > 0 { dir } else { prefix })
    }
    return out
}

// The path of every file under a folder and the folders in it, each joined
// to root, folder by folder in the order of their names. Links are listed
// as files and not followed. The caller frees the paths and the list, with
// freeEach.
pub !List[String] walk(str root) {
    List[String] out
    walkInto(root, &out) catch e {
        out.freeEach()
        return e
    }
    return out
}

// A file that find found: its path, joined to the root, and its size,
// kind and time of change.
pub struct Found {
    pub String path
    pub Info info
}

// Gives the path back.
pub void Found.free() {
    self.path.free()
}

// Every file under a folder and the folders in it, with its size and time,
// as walk finds them and in the same order. Each file's information is
// read relative to its open folder, which costs less than a stat of its
// whole path. Links are listed as files and not followed. The caller frees
// the list with freeEach.
pub !List[Found] find(str root) {
    List[Found] out
    findInto(root, &out) catch e {
        out.freeEach()
        return e
    }
    return out
}

!void findInto(str dir, List[Found] *out) {
    i32 err
    d := rawDirOpen(dir.ptr, dir.len, &err)
    if err != 0 {
        return fsError(err, dir)
    }
    defer rawDirClose(d)
    scoped List[Entry] items
    defer {
        for e in items {
            e.name.free()
        }
    }
    for {
        String name
        i32 isDir
        if rawDirNext(d, &name, &isDir) == 0 {
            break
        }
        items.push(Entry{name: name, isDir: isDir != 0})
    }
    items.sort(byName)
    for e in items {
        if e.isDir {
            scoped String sub = joinPath(dir, e.name)
            try findInto(sub, out)
            continue
        }
        i64[10] v
        code := rawInfo(d, e.name.ptr, e.name.len, 0, &v[0])
        if code != 0 {
            return fsError(code, e.name)
        }
        out.push(Found{path: joinPath(dir, e.name), info: infoFrom(v)})
    }
}

String joinPath(str a, str b) {
    if a.len == 0 {
        return b.copy()
    }
    String out = a.copy()
    if a[a.len - 1] != '/' {
        out.append("/")
    }
    out.append(b)
    return out
}

!void walkInto(str dir, List[String] *out) {
    scoped Dir d = try readDir(dir)
    for e in d.entries {
        String p = joinPath(dir, e.name)
        if e.isDir {
            walkInto(p, out) catch err {
                p.free()
                return err
            }
            p.free()
        } else {
            out.push(p)
        }
    }
}

bool before(String a, String b) => str.compare(a, b) < 0

// The paths of the files that match a pattern, sorted. In the pattern, *
// matches any run of characters in one part of a path, ? one character,
// [abc] one of those characters ([a-z] a range, [!abc] any other), and a
// part that is ** matches any number of folders, none included:
// glob("src/**/*.iris"). A folder that isn't there matches nothing. The
// caller frees the paths and the list, with freeEach.
pub !List[String] glob(str pattern) {
    List[String] out
    // the folder to start from: the parts before the first with a wildcard
    List[str] parts = str.split(pattern, "/")
    defer parts.free()
    i64 first = 0
    for first < parts.len && !hasWild(parts.at(first)) {
        first += 1
    }
    if first == parts.len {
        if exists(pattern) {
            info := try stat(pattern)
            if !info.isDir {
                out.push(pattern.copy())
            }
        }
        return out
    }
    String root
    defer root.free()
    if first == 0 {
        root.append(".")
    } else {
        for i in 0..first {
            if i > 0 {
                root.append("/")
            }
            root.append(parts.at(i))
        }
        if root.len == 0 {
            root.append("/")
        }
    }
    // a**b is one ** when it is a whole part; **/** is one **
    List[str] rest
    defer rest.free()
    for i in first..parts.len {
        p := parts.at(i)
        continue if p == "**" && rest.len > 0 && rest.last() == "**"
        continue if p.len == 0 && i < parts.len - 1
        rest.push(p)
    }
    globIn(root, first == 0, rest.items(), 0, &out) catch e {
        out.freeEach()
        return e
    }
    out.sort(before)
    return out
}

bool hasWild(str s) {
    for c in s {
        if c == '*' || c == '?' || c == '[' {
            return true
        }
    }
    return false
}

// The files under dir that match parts[i:], into out. With bare, a match is
// named without dir in front, for a pattern that starts with a wildcard.
!void globIn(str dir, bool bare, str[] parts, i64 i, List[String] *out) {
    d := readDir(dir) catch e {
        if e.code == FsError.notFound || e.code == FsError.permission {
            return
        }
        return e
    }
    defer d.free()
    part := parts[i]
    last := i == parts.len - 1
    if part == "**" {
        if last {
            for e in d.entries {
                String p = if bare { e.name.copy() } else { joinPath(dir, e.name) }
                if e.isDir {
                    walkInto(p, out) catch err {
                        p.free()
                        return err
                    }
                    p.free()
                } else {
                    out.push(p)
                }
            }
            return
        }
        // none: the next part matches here; or more: go down a folder
        try globIn(dir, bare, parts, i + 1, out)
        for e in d.entries {
            if e.isDir {
                scoped String p = if bare { e.name.copy() } else { joinPath(dir, e.name) }
                try globIn(p, false, parts, i, out)
            }
        }
        return
    }
    for e in d.entries {
        continue if !matches(part, e.name)
        // a name that starts with a dot is matched only by a dot
        continue if str.startsWith(e.name, ".") && (part.len == 0 || part[0] != '.')
        if last {
            if !e.isDir {
                out.push(if bare { e.name.copy() } else { joinPath(dir, e.name) })
            }
        } else if e.isDir {
            scoped String p = if bare { e.name.copy() } else { joinPath(dir, e.name) }
            try globIn(p, false, parts, i + 1, out)
        }
    }
}

// Whether name matches one part of a glob pattern.
pub bool matches(str pattern, str name) {
    p := 0
    n := 0
    // where the last * was, to go back to when what follows it doesn't match
    i64 star = -1
    i64 starName = 0
    for n < name.len {
        if p < pattern.len {
            c := pattern[p]
            if c == '*' {
                star = p
                starName = n
                p += 1
                continue
            }
            if c == '?' {
                p += 1
                n += 1
                continue
            }
            if c == '[' {
                ok, end := matchClass(pattern, p, name[n])
                if end > 0 && ok {
                    p = end
                    n += 1
                    continue
                }
                if end == 0 && name[n] == '[' {
                    p += 1
                    n += 1
                    continue
                }
            } else if c == name[n] {
                p += 1
                n += 1
                continue
            }
        }
        if star < 0 {
            return false
        }
        p = star + 1
        starName += 1
        n = starName
    }
    for p < pattern.len && pattern[p] == '*' {
        p += 1
    }
    return p == pattern.len
}

// Whether c is in the [...] at pattern[at], and the place after the ]; 0
// when there is no ] to close it.
(bool, i64) matchClass(str pattern, i64 at, u8 c) {
    i := at + 1
    negate := i < pattern.len && (pattern[i] == '!' || pattern[i] == '^')
    if negate {
        i += 1
    }
    found := false
    start := i
    for i < pattern.len {
        if pattern[i] == ']' && i > start {
            return (found != negate, i + 1)
        }
        lo := pattern[i]
        if i + 2 < pattern.len && pattern[i + 1] == '-' && pattern[i + 2] != ']' {
            hi := pattern[i + 2]
            if c >= lo && c <= hi {
                found = true
            }
            i += 3
        } else {
            if c == lo {
                found = true
            }
            i += 1
        }
    }
    return (false, 0)
}
