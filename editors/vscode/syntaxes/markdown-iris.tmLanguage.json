{
  "scopeName": "markdown.iris.codeblock",
  "injectionSelector": "L:text.html.markdown",
  "patterns": [{ "include": "#iris-block" }],
  "repository": {
    "iris-block": {
      "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(iris)\\b.*$",
      "beginCaptures": { "3": { "name": "punctuation.definition.markdown" }, "4": { "name": "fenced_code.block.language.markdown" } },
      "end": "(^|\\G)(\\2|\\s{0,3})(\\3)\\s*$",
      "endCaptures": { "3": { "name": "punctuation.definition.markdown" } },
      "name": "markup.fenced_code.block.markdown",
      "patterns": [
        { "begin": "(^|\\G)(\\s*)(.*)", "while": "(^|\\G)(?!\\s*([`~]{3,})\\s*$)", "contentName": "meta.embedded.block.iris", "patterns": [{ "include": "source.iris" }] }
      ]
    }
  }
}
