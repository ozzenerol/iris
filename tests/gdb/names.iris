struct P {
    i64 x
    i64 y
}

i64 P.len() => self.x + self.y

i64 add(i64 a, i64 b) {
    i64 c = a + b
    return c
}

void main() {
    P p = P{x: 1, y: 2}
    i64 r = add(3, 4)
    print("{r} {p.len()}")
}
