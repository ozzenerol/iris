void greet(str name) {
    print(name)
}

void main() {
    for name in ["ann", "iris"] {
        greet(name)
    }
    List[i64] xs
    xs.push(4)
    xs.push(5)
    Map[str, i64] m
    m.set("key", 9)
    Map[i64, str] mi
    mi.set(3, "three")
    str s = "key"
    String t = format("iris")
    Deque[i64] d
    d.push(8)
    d.pushFront(7)
    i64[3] arr = [10, 20, 30]
    i64[] sl = arr[0:3]
    print("{xs.len} {m.len} {mi.len} {s} {t} {d.len} {sl.len}")
}
