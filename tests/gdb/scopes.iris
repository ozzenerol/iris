struct P {
    i64 x
    i64 y
}

enum Odd { odd }

!i64 half(i64 n) {
    if n % 2 != 0 {
        return error(Odd.odd, "odd")
    }
    return n / 2
}

void main() {
    i64 total = 0
    for i in 0..3 {
        total += i
    }
    for i, v in [10, 20] {
        i64 inner = v + i
        total += inner
    }
    P p = P{x: 1, y: 2}
    p.x = 5
    total += p.x
    i64 late = total * 2
    i64 h = half(4) catch 0
    print("{late} {h}")
}
