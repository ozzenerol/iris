void waiter(chan[i64] ch) {
    i64 v = <-ch
    print("got {v}")
}

void sleeper() {
    sleep(10s)
}

void worker(i64 n, chan[i64] started) {
    i64 x = n * 2
    started <- 1
    sleep(2s)
    print("{x}")
}

void main() {
    ch := chan[i64](1)
    spawn waiter(ch)
    spawn sleeper()
    started := chan[i64](1)
    t := thread worker(4, started)
    _ = <-started
    sleep(100ms)
    i64 here = 1
    spawn sleeper()
    print("{here}")
    ch <- 5
    t.join()
}
