// finish shows the value that a function returns with its Iris type. LLVM
// returns a struct in registers where C would use memory, and the printers
// read it from there. "break main" stops in the Iris main only.

enum Bad { neg }

enum Shape {
    circle(f64 r)
    rect(i64 w, i64 h)
}

struct P {
    i32 x
    i32 y
}

struct R {
    f64 a
    f64 b
    f64 c
}

struct W {
    i64 a
    i64 b
    i64 c
    i64 d
}

i64 seven() {
    return 7
}

str name() {
    return "iris"
}

List[i64] nums() {
    List[i64] xs
    xs.push(1)
    xs.push(2)
    return xs
}

String text() {
    return format("a{1}")
}

!i64 half(i64 n) {
    if n < 0 {
        return error(Bad.neg, "negative")
    }
    return n / 2
}

P point() {
    return P{x: 3, y: 4}
}

R reals() {
    return R{a: 1.5, b: 2.5, c: 3.5}
}

W wide() {
    return W{a: 1, b: 2, c: 3, d: 4}
}

(i64, str) pair() {
    return (5, "x")
}

Shape shape() {
    return Shape.rect(2, 3)
}

i64 fact(i64 n) {
    if n < 2 {
        return 1
    }
    return n * fact(n - 1)
}

void main() {
    a := seven()
    b := name()
    c := nums()
    scoped String d = text()
    e := half(8) catch 0
    f := half(-1) catch 0
    p := point()
    r := reals()
    w := wide()
    t0, t1 := pair()
    s := shape()
    g := fact(4)
    print("{a} {b} {c.len} {d} {e} {f} {p.x} {r.c} {w.d} {t0} {t1} {g}")
    c.free()
}
