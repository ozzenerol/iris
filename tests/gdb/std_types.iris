import fs
import net

enum Level u8 { debug, info, warn }

void greet(str name, String full) {
    print("{name} {full}")
}

void main() {
    ch := chan[i64](4)
    ch <- 7
    ch <- 8
    Duration d = 250ms
    Duration d2 = 90s
    Atomic[i64] n
    n.add(3)
    Mutex mu
    mu.lock()
    Mutex free
    u8[4] ip = [10, 0, 0, 1]
    u8 b = 200
    Level lv = Level.warn
    (i64, str) pair = (3, "x")
    fs.File f = fs.open("main.iris") catch return
    ln := net.listen(0, "127.0.0.1") catch return
    c := net.dial("127.0.0.1", ln.port) catch return
    s := ln.accept() catch return
    print("{d} {d2} {ip[0]} {b} {lv} {pair.0} {s.sent}")
    for name in ["ann", "iris", "bob"] {
        scoped String full = format("{name}!")
        greet(name, full)
    }
    f.close()
    c.close()
    s.close()
    ln.close()
    mu.unlock()
}
