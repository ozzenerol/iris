// A step stops only on lines of Iris code: not on the code that the compiler
// makes for a for loop, a match, defer, scoped or try, and not in the runtime.

enum Color { red, green }
enum E { bad }

!i64 half(i64 n) {
    if n < 0 {
        return error(E.bad, "negative")
    }
    return n / 2
}

!i64 twice(i64 n) {
    h := try half(n)
    return h * 4
}

void main() {
    List[i64] xs
    xs.push(1)
    xs.push(2)
    i64 sum = 0
    for x in xs {
        sum += x
    }
    Map[str, i64] m
    m.set("a", 1)
    for k, v in m {
        sum += v
    }
    defer print("done")
    scoped String s = format("{sum}")
    Color c = Color.green
    match c {
        .red => print("red")
        .green => print("green")
    }
    t := twice(6) catch 0
    u := twice(-1) catch 7
    print("{s} {t} {u}")
}
