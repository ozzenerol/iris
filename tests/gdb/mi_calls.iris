// mi: -gdb-set mi-async on
// mi: -break-insert main.iris:93
// mi: -exec-run
// mi: -data-evaluate-expression "p.sum(10)"
// mi: -data-evaluate-expression "b.total()"
// mi: -iris-evaluate-expression greet("iris")
// mi: -iris-evaluate-expression pair(5)
// mi: -iris-evaluate-expression add(2, 3) * 2
// mi: -iris-evaluate-expression boom(7)
// mi: -data-evaluate-expression "xs.at(1)"
// mi: -exec-continue
// expect: ^done,value="13"
// expect: ^done,value="10"
// expect: ^done,value="\"hi iris\""
// expect: ^done,value="List[i64](len=2) = {5, 6}"
// expect: ^done,value="10"
// expect: ^error,msg="iris: the call panicked; the program is as it was before the call"
// expect: ^done,value="4"
// expect: *stopped,reason="exited-normally"

// MI: -data-evaluate-expression calls methods, and -iris-evaluate-expression
// also calls Iris functions as Iris passes their arguments.

struct P {
    i32 x
    i32 y
}

struct Big {
    i64 a
    i64 b
    i64 c
    i64 d
    i64 e
}

i64 add(i64 a, i64 b) {
    return a + b
}

List[i64] pair(i64 a) {
    List[i64] xs
    xs.push(a)
    xs.push(a + 1)
    return xs
}

String greet(str name) {
    return format("hi {name}")
}

(i64, str) tup(i64 n) {
    return (n, "x")
}

P P.swap() {
    return P{x: self.y, y: self.x}
}

i64 P.sum(i64 k) {
    return self.x + self.y + k
}

i64 Big.total() {
    return self.a + self.b + self.c + self.d + self.e
}

Big mkbig(i64 n) {
    return Big{a: n, b: n, c: n, d: n, e: n}
}

i64 sumBig(Big b, f64 scale) {
    return b.a + b.e + i64(scale * 2.0)
}

i64 boom(i64 n) {
    if n > 2 {
        panic("too big")
    }
    return n
}

i64 tlen(str s) {
    return s.len
}

void main() {
    List[i64] xs = pair(3)
    P p = P{x: 1, y: 2}
    Big b = mkbig(2)
    String g = greet("iris")
    i64 r = add(1, 2) + boom(1) + tlen("ab") + sumBig(b, 1.0)
    t0, t1 := tup(4)
    print("{xs.len} {p.sum(1)} {p.swap().x} {b.total()} {g} {r} {t0} {t1}")
}
