// Methods of the core types that change nothing run in gdb.py, also when
// the program has no copy of them, in print and in conditions.

void main() {
    List[i64] xs
    xs.push(4)
    xs.push(9)
    Map[str, i64] m
    m.set("a", 1)
    Map[i64, str] mi
    mi.set(3, "three")
    Set[i64] st
    st.add(5)
    Deque[i64] dq
    dq.push(7)
    dq.push(8)
    String s = format("abc")
    print("{xs.len} {m.len} {mi.len} {st.len} {dq.len} {s}")
}
