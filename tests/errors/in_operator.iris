struct Box {
    i64 n
}

enum Msg {
    ping
    data(str text)
}

void main() {
    x := 5
    b := Box{n: 1}
    m := Msg.ping
    u8 small = 3
    _ = x in b
    _ = x in 7
    _ = b in Box{n: 1}..Box{n: 2}
    _ = m in [Msg.ping]
    _ = "a" in "abc"
    _ = small in [1, 300]
    _ = undefinedName in [1]
}
