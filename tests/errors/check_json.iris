import json

struct Plain {
    i64 x
}

enum Shape { circle(f64 r), square }

@json
struct Bad {
    Plain p
    i64 *ptr
    Shape s
    @json(5) i64 a
    @json("") i64 b
}

struct NotJson {
    @json("x") i64 x
}

@json("name")
struct Named {
    i64 x
}

@json
struct View {
    str name
}

void main() {
    v := View{name: "a"}
    print(json.encode(v))
    _ = json.decode(View, r"""{}""")
    _ = json.decode(Plain, r"""{}""")
    p := Plain{x: 1}
    print(json.encode(p))
    _ = json.decode(View)
}

@json
struct Pool {
    List[Plain] plains
}

void lists() {
    _ = json.decode(List[str], "[]")
}
