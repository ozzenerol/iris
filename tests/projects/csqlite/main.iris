// expect: open: true
// expect: exec: 0
// expect: value: 84
// expect: x = 42
// expect: 1 rows

import c "sqlite3.h", c "string.h"

str cstr(u8 *p) => p[0:c.strlen(p)]

i32 onRow(u8 *ctx, i32 n, u8 **values, u8 **names) {
    i64 *count = ctx
    *count += 1
    for i in 0..n {
        print("{cstr(names[0:n][i])} = {cstr(values[0:n][i])}")
    }
    return 0
}

void main() {
    c.sqlite3 *db
    rc := c.sqlite3_open(":memory:\0".ptr, &db)
    print("open: {rc == c.SQLITE_OK}")
    rc2 := c.sqlite3_exec(db, "create table t(x); insert into t values (42);\0".ptr, null, null, null)
    print("exec: {rc2}")
    c.sqlite3_stmt *st
    _ = c.sqlite3_prepare_v2(db, "select x * 2 from t\0".ptr, -1, &st, null)
    if c.sqlite3_step(st) == c.SQLITE_ROW {
        print("value: {c.sqlite3_column_int64(st, 0)}")
    }
    _ = c.sqlite3_finalize(st)
    i64 rows
    _ = c.sqlite3_exec(db, "select x from t\0".ptr, onRow, &rows, null)
    print("{rows} rows")
    _ = c.sqlite3_close(db)
}
