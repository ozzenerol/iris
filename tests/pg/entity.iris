// expect: ada 1, bob 2
// expect: found: 1 Ada 36 2026-10-27 [x]
// expect: json: {"id":1,"full_name":"Ada","age":36,"created":"2026-10-27","tags":["x"]}
// expect: updated 1: Ada Lovelace 37
// expect: missing: PgError.noRows
// expect: many: 3, ids 3 4 5
// expect: own id: 100 Dee
// expect: deleted 1, left 5
// expect: plain @json: 7 Eve
// expect: no table: PgError.failed

import json, pg, os

@json
@entity("ent_people")
struct Person {
    @id i64 id
    @json("full_name") String name
    i64 age
    @column("created_at") String created
    List[String] tags
}

@json
struct Plain {
    i64 id
    String name
}

!void main() {
    db := try pg.pool(try os.env("IRIS_PG_URL"), 2)
    defer db.close()
    try db.execScript("DROP TABLE IF EXISTS ent_people, ent_plain; CREATE TABLE ent_people (id serial PRIMARY KEY, name text NOT NULL, age bigint, created_at text, tags jsonb)")

    scoped ada := Person{name: "Ada".copy(), age: 36, created: "2026-10-27".copy()}
    ada.tags.push("x".copy())
    try pg.insert(&db, &ada)
    scoped bob := Person{name: "Bob".copy()}
    try pg.insert(&db, &bob)
    print("ada {ada.id}, bob {bob.id}")

    scoped p := try pg.find[Person](&db, .int(1))
    print("found: {p.id} {p.name} {p.age} {p.created} [{p.tags.at(0)}]")
    scoped String j = json.encode(p)
    print("json: {j}")

    p.name.free()
    p.name = "Ada Lovelace".copy()
    p.age = 37
    n := try pg.update(&db, &p)
    scoped again := try pg.find[Person](&db, .int(1))
    print("updated {n}: {again.name} {again.age}")

    _ = pg.find[Person](&db, .int(99)) catch e {
        print("missing: {e.code}")
        Person{}
    }

    List[Person] more
    defer {
        for m in more {
            m.free()
        }
        more.free()
    }
    for name in ["Cy", "Di", "Ed"] {
        more.push(Person{name: name.copy()})
    }
    k := try pg.insertMany(&db, more.items())
    all := try pg.all[Person](&db, "SELECT * FROM ent_people ORDER BY id")
    print("many: {k}, ids {all.at(2).id} {all.at(3).id} {all.at(4).id}")
    for a in all {
        a.free()
    }
    all.free()

    scoped dee := Person{id: 100, name: "Dee".copy()}
    try pg.insert(&db, &dee)
    scoped d := try pg.find[Person](&db, .int(100))
    print("own id: {d.id} {d.name}")

    gone := try pg.delete[Person](&db, .int(2))
    left := try db.query("SELECT count(*) FROM ent_people")
    _ = left.next()
    print("deleted {gone}, left {left.int(0)}")
    left.close()

    try db.execScript("CREATE TABLE ent_plain (id bigint PRIMARY KEY, name text)")
    scoped eve := Plain{id: 7, name: "Eve".copy()}
    try pg.insert(&db, &eve, table: "ent_plain")
    scoped e2 := try pg.one[Plain](&db, "SELECT * FROM ent_plain")
    print("plain @json: {e2.id} {e2.name}")
    pg.insert(&db, &eve) catch e {
        print("no table: {e.code}")
    }
    try db.execScript("DROP TABLE ent_people, ent_plain")
}
