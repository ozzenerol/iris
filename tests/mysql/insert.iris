// expect: ids: 1 2
// expect: 1 Ada 36 1.5 true admin ["a","b"] 18446744073709551615 3
// expect: 2 Bob 0 0 false guest [] 0 0
// expect: many: 30000 rows in 30000 ids
// expect: duplicate: MysqlError.constraint
// expect: in a rolled back Tx: 0
// expect: no fields: MysqlError.failed

import mysql, os

enum Role { guest, admin }

@json
struct User {
    i64 id
    String name
    i32 age
    f64 score
    bool admin
    Role role
    List[String] tags
    u64 big
    @json("order") i64 position
}

@json
struct Point {
    i64 x
    i64 y
    i64 z
}

@json
struct Count {
    i64 n
    i64 ids
}

@json
struct Empty {
    i64 id
}

!void main() {
    db := try mysql.pool(try os.env("IRIS_MYSQL_URL"), 4)
    defer db.close()
    try db.execScript(r"""
        DROP TABLE IF EXISTS ins_users, ins_points;
        CREATE TABLE ins_users (id int AUTO_INCREMENT PRIMARY KEY, name varchar(50) UNIQUE NOT NULL, age int, score double, admin bool,
            role text, tags json, big decimal(20), `order` bigint);
        CREATE TABLE ins_points (id int AUTO_INCREMENT PRIMARY KEY, x bigint, y bigint, z bigint);
        """)

    scoped ada := User{name: "Ada".copy(), age: 36, score: 1.5, admin: true, role: .admin, big: 18446744073709551615, position: 3}
    ada.tags.push("a".copy())
    ada.tags.push("b".copy())
    ada.id = try mysql.insert(&db, "ins_users", &ada, skip: ["id"])
    scoped bob := User{name: "Bob".copy()}
    bob.id = try mysql.insert(&db, "ins_users", &bob, skip: ["id"])
    print("ids: {ada.id} {bob.id}")

    users := try mysql.all[User](&db, r"""SELECT id, name, coalesce(age, 0) AS age, score, admin, role, tags, big, `order` FROM ins_users ORDER BY id""")
    for u in users {
        scoped String tags = format("[")
        for i in 0..u.tags.len {
            tags.append(if i > 0 { ",\"" } else { "\"" })
            tags.append(u.tags.at(i))
            tags.append("\"")
        }
        tags.append("]")
        print("{u.id} {u.name} {u.age} {u.score} {u.admin} {u.role} {tags} {u.big} {u.position}")
        u.free()
    }
    users.free()

    List[Point] points
    defer points.free()
    for i in 0..30000 {
        points.push(Point{x: i, y: i * 2, z: i * 3})
    }
    n := try mysql.insertMany(&db, "ins_points", points.items(), skip: ["id"])
    c := try mysql.one[Count](&db, "SELECT count(*) AS n, count(DISTINCT id) AS ids FROM ins_points WHERE y = x * 2 AND z = x * 3")
    print("many: {n} rows in {c.ids} ids")

    scoped again := User{name: "Ada".copy()}
    _ = mysql.insert(&db, "ins_users", &again, skip: ["id"]) catch e {
        print("duplicate: {e.code}")
        0
    }

    scoped tx := try db.begin()
    scoped cy := User{name: "Cy".copy()}
    _ = try mysql.insert(&tx, "ins_users", &cy, skip: ["id"])
    try tx.rollback()
    left := try mysql.one[Count](&db, "SELECT count(*) AS n FROM ins_users WHERE name = 'Cy'")
    print("in a rolled back Tx: {left.n}")

    e := Empty{}
    _ = mysql.insert(&db, "ins_users", &e, skip: ["id"]) catch err {
        print("no fields: {err.code}")
        0
    }
    try db.execScript("DROP TABLE ins_users, ins_points")
}
