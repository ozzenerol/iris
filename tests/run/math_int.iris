// expect: 10 0 0.5
// expect: 12 12 0 9
// expect: 9 10 3037000499 1594323 -9223372036854775808
// expect: -4 -3 2 -1 -2
// expect: 0 false 9223372030926249001 true
// expect: 9223372036854775807 -9223372036854775808 -9223372036854775808
// expect: -9223372036854775808 0 -1
// The integer functions of math: clamp, gcd, isqrt, ipow, floor division, and checked, saturating and wrapping arithmetic.
import math

void main() {
    print("{math.clamp(15, 0, 10)} {math.clamp(-3, 0, 10)} {math.clamp(0.5, 0.0, 1.0)}")
    print("{math.gcd(84, -36)} {math.lcm(4, 6)} {math.gcd(0, 0)} {math.absInt(-9)}")
    print("{math.isqrt(99)} {math.isqrt(100)} {math.isqrt(9223372036854775807)} {math.ipow(3, 13)} {math.ipow(-2, 63)}")
    print("{math.divFloor(-7, 2)} {-7 / 2} {math.mod(-7, 3)} {-7 % 3} {math.mod(7, -3)}")
    s, ok := math.addChecked(9223372036854775807, 1)
    m, ok2 := math.mulChecked(3037000499, 3037000499)
    print("{s} {ok} {m} {ok2}")
    print("{math.addSat(9223372036854775807, 5)} {math.subSat(-9223372036854775807, 5)} {math.mulSat(-4611686018427387905, 2)}")
    print("{math.addWrap(9223372036854775807, 1)} {math.mulWrap(4294967296, 4294967296)} {math.subWrap(0, 1)}")
}
