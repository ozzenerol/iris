// expect: P-256 from openssl: true, type ecP256
// expect: P-384 from openssl: true, type ecP384
// expect: RSA PKCS#1 from openssl: true, PSS SHA-384: true, type rsa
// expect: wrong message: false, wrong padding: false
// expect: point key checks it: true
// expect: n and e key checks it: true
// expect: own P-256: true, raw r and s: 64 bytes, back: true
// expect: own RSA PSS: true, PKCS#1: true
// expect: PEM round trip: true, public PEM: true, DER: true
// expect: CryptoError.badKey
// expect: generated: ecP256 ecP384 rsa

import crypto, fs, hex, str

!String file(str name) {
    scoped String path = format("tests/data/keys/{name}")
    return try fs.readAll(path)
}

!void main() {
    scoped String msg = try file("msg")

    scoped String ecPub = try file("ecpub.pem")
    scoped String ecSig = try file("ec.sig")
    scoped k1 := try crypto.loadPublicKey(ecPub)
    print("P-256 from openssl: {k1.verify(msg, ecSig)}, type {k1.kind()}")

    scoped String ec384Pub = try file("ec384pub.pem")
    scoped String ec384Sig = try file("ec384.sig")
    scoped k2 := try crypto.loadPublicKey(ec384Pub)
    print("P-384 from openssl: {k2.verify(msg, ec384Sig, .sha384)}, type {k2.kind()}")

    scoped String rsaPub = try file("rsapub.pem")
    scoped String rsaSig = try file("rsa1.sig")
    scoped String pssSig = try file("rsapss.sig")
    scoped k3 := try crypto.loadPublicKey(rsaPub)
    print("RSA PKCS#1 from openssl: {k3.verify(msg, rsaSig)}, PSS SHA-384: {k3.verify(msg, pssSig, .sha384, .pss)}, type {k3.kind()}")
    print("wrong message: {k3.verify("another", rsaSig)}, wrong padding: {k3.verify(msg, rsaSig, .sha256, .pss)}")

    scoped String pointHex = try file("ecpoint.hex")
    scoped String point = try hex.decode(str.trim(pointHex))
    scoped k4 := try crypto.ecPublicKey(.ecP256, point)
    print("point key checks it: {k4.verify(msg, ecSig)}")

    scoped String nHex = try file("rsan.hex")
    scoped String n = try hex.decode(str.trim(nHex))
    u8[3] e = [1, 0, 1]
    scoped k5 := try crypto.rsaPublicKey(n, e[0:])
    print("n and e key checks it: {k5.verify(msg, rsaSig)}")

    scoped String ecPriv = try file("ec.pem")
    scoped p1 := try crypto.loadPrivateKey(ecPriv)
    scoped String s1 = try p1.sign("signed by iris")
    scoped pub1 := p1.publicKey()
    scoped String raw = try crypto.ecdsaRaw(s1, 32)
    scoped String der = crypto.ecdsaDer(raw)
    print("own P-256: {pub1.verify("signed by iris", s1)}, raw r and s: {raw.len} bytes, back: {pub1.verify("signed by iris", der)}")

    scoped String rsaPriv = try file("rsa.pem")
    scoped p2 := try crypto.loadPrivateKey(rsaPriv)
    scoped String s2 = try p2.sign("signed by iris", .sha256, .pss)
    scoped String s3 = try p2.sign("signed by iris", .sha512)
    print("own RSA PSS: {k3.verify("signed by iris", s2, .sha256, .pss)}, PKCS#1: {k3.verify("signed by iris", s3, .sha512)}")

    scoped String pem = p1.pem()
    scoped p1b := try crypto.loadPrivateKey(pem)
    scoped String s4 = try p1b.sign("again")
    scoped String pubPem = pub1.pem()
    scoped String pubDer = pub1.der()
    scoped pub1b := try crypto.loadPublicKey(pubPem)
    scoped pub1c := try crypto.loadPublicKey(pubDer)
    print("PEM round trip: {pub1.verify("again", s4)}, public PEM: {pub1b.verify("again", s4)}, DER: {pub1c.verify("again", s4)}")

    _ = crypto.loadPrivateKey("not a key") catch err {
        print("{err.code}")
        crypto.PrivateKey{}
    }

    scoped g1 := try crypto.generateKey(.ecP256)
    scoped g2 := try crypto.generateKey(.ecP384)
    scoped g3 := try crypto.generateKey(.rsa, 2048)
    print("generated: {g1.kind()} {g2.kind()} {g3.kind()}")
}
