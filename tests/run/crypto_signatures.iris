// expect: b42af09057bac1e2d41708e48a902e09b5ff7f12ab428a4fe86653c73dd248fb82f948a549f7b791a5b41915ee4d1ec3935357e4e2317250d0372afa2ebeeb3a
// expect: 3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865
// expect: d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a
// expect: e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b
// expect: 3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c
// expect: 92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00
// expect: true false false false
// expect: true true

import crypto, hex, random

!void main() {
    scoped String h = hex.encode(crypto.sha512("abc"))
    print(h)
    scoped String m = hex.encode(crypto.hmacSha512("key", "The quick brown fox jumps over the lazy dog"))
    print(m)

    // RFC 5869, test case 1
    scoped String ikm = try hex.decode("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b")
    scoped String salt = try hex.decode("000102030405060708090a0b0c")
    scoped String info = try hex.decode("f0f1f2f3f4f5f6f7f8f9")
    scoped String okm = crypto.hkdfSha256(ikm, salt, info, 42)
    scoped String okmHex = hex.encode(okm)
    print(okmHex)

    // RFC 8032, tests 1 and 2
    scoped String seed1 = try hex.decode("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
    scoped String seed2 = try hex.decode("4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb")
    for t in [(seed1, ""), (seed2, "\x72")] {
        seed, msg := t
        scoped String pk = hex.encode(crypto.ed25519Public(seed))
        scoped String sig = hex.encode(crypto.ed25519Sign(seed, msg))
        print(pk)
        print(sig)
    }

    u8[32] key = crypto.ed25519Public(seed2)
    u8[64] sig = crypto.ed25519Sign(seed2, "deploy v2")
    good := crypto.ed25519Verify(key[0:32], "deploy v2", sig[0:64])
    other := crypto.ed25519Verify(key[0:32], "deploy v3", sig[0:64])
    sig[10] ^= 1
    flipped := crypto.ed25519Verify(key[0:32], "deploy v2", sig[0:64])
    short := crypto.ed25519Verify(key[0:31], "deploy v2", sig[0:64])
    print("{good} {other} {flipped} {short}")

    u8[32] fresh
    random.bytes(fresh[0:32])
    u8[32] freshKey = crypto.ed25519Public(fresh[0:32])
    u8[64] freshSig = crypto.ed25519Sign(fresh[0:32], "")
    scoped String none = crypto.hkdfSha256("s", "", "", 0)
    print("{crypto.ed25519Verify(freshKey[0:32], "", freshSig[0:64])} {none.len == 0}")
}
