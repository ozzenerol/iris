// expect: 14 20 3 1 -3 -1
// expect: 8 14 6 -9 32 4 -4
// expect: true false true true

void main() {
    a := 2 + 3 * 4
    b := (2 + 3) * 4
    c := 7 / 2
    d := 7 % 2
    e := -7 / 2
    f := -7 % 2
    print("{a} {b} {c} {d} {e} {f}")
    g := 12 & 10
    h := 12 | 10
    i := 12 ^ 10
    j := ~8
    k := 1 << 5
    l := 16 >> 2
    m := -16 >> 2
    print("{g} {h} {i} {j} {k} {l} {m}")
    print("{1 < 2} {2 <= 1} {3 == 3 && 4 != 5} {false || !false}")
}
