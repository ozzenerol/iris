// expect: got interrupt
// expect: got user1
// expect: got user2
// expect: got hangup

import process, signal

void send(str which) {
    scoped String cmd = format("sleep 0.1; kill -{which} $PPID")
    scoped process.Output o = process.run(["sh", "-c", cmd]) catch e {
        return
    }
}

void main() {
    signal.watch()
    spawn send("INT")
    s := signal.wait()
    print("got {s}")
    signal.watch([.user1, .user2, .hangup])
    for which in ["USR1", "USR2", "HUP"] {
        spawn send(which)
        got := signal.wait()
        print("got {got}")
    }
}
