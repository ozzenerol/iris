// Random numbers checked against Python's integers: + - * / % and hex.
import big

!void check(str x, str y) {
    scoped a := try big.parse(x)
    scoped b := try big.parse(y)
    scoped s := a.add(b)
    scoped d := a.sub(b)
    scoped p := a.mul(b)
    q, r := a.divMod(b)
    defer {
        q.free()
        r.free()
    }
    scoped ab := a.abs()
    scoped h := ab.text(16)
    print("{s} {d} {p} {q} {r} {h}")
}

