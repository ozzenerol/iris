// expect: slow request: 200
// expect: the server stopped

import http, net

chan[bool] started

void slow(http.Request *req, http.Response *res) {
    started <- true
    sleep(100ms)
    res.text("done")
}

void server(http.Router *r, net.Listener ln, chan[str] out) {
    r.serveOn(ln) catch e {
        out <- "the server failed"
        return
    }
    out <- "the server stopped"
}

void client(u16 port, chan[str] out) {
    scoped String url = format("http://127.0.0.1:{port}/")
    scoped http.Reply rep = http.get(url) catch e {
        out <- "client failed"
        return
    }
    out <- if rep.status == 200 { "slow request: 200" } else { "slow request: other" }
}

!void main() {
    http.Router r
    defer r.free()
    r.get("/", slow)
    ln := try net.listen(0, "127.0.0.1")
    // one channel each: the server can finish before the client has read
    // its reply
    serverDone := chan[str](1)
    clientDone := chan[str](1)
    started = chan[bool](1)
    spawn server(&r, ln, serverDone)
    spawn client(ln.port, clientDone)
    _ = <-started
    r.shutdown(2s)
    print(<-clientDone)
    print(<-serverDone)
}
