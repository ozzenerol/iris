// expect: sha512 right: true, wrong: false
// expect: made hash checks: true, differs from another salt: true
// expect: checkLogin needs a hash to read: true

// os: linux

import shadow

!void main() {
    h := "$6$saltsalt$8iYtNHxjWRl.NF6oNZ5tF.iKFlQREaXBLlSmZKP6dy9l5z3vsooWNW0/GZ6Nej73/TFug6pIPSqbJoCT6dfnj."
    print("sha512 right: {try shadow.check("hunter2", h)}, wrong: {shadow.check("wrong", h) catch e { true }}")

    scoped made := try shadow.crypt("my secret", "$6$0123456789abcdef")
    scoped other := try shadow.crypt("my secret", "$6$fedcba9876543210")
    print("made hash checks: {try shadow.check("my secret", made)}, differs from another salt: {made != other}")

    // checkLogin either finds no such user, or can't read /etc/shadow,
    // depending on whether the test runs as root; both are errors here
    bool errored = false
    _ = shadow.checkLogin("no-such-user-iris-xyz", "x") catch e {
        errored = e.code == shadow.ShadowError.notFound || e.code == shadow.ShadowError.denied
        false
    }
    print("checkLogin needs a hash to read: {errored}")
}
