import regex, str

void show(str pattern, str text) {
    re := regex.compile(pattern) catch e {
        print("error: {e.message}")
        return
    }
    defer re.free()
    m, found := re.find(text)
    defer m.free()
    if !found {
        print("no match")
        return
    }
    String line = format("{m.start} {m.end} [{m.str()}]")
    for i in 1..re.groups() + 1 {
        s, _ := m.span(i)
        scoped String g = if s < 0 { format(" [-]") } else { format(" [{m.group(i)}]") }
        line.append(g)
    }
    scoped String a = str.replace(line, "\n", "\\n")
    scoped String b = str.replace(a, "\t", "\\t")
    print(b)
    line.free()
}

void main() {
    show("abc", "xxabcxx")
    show("a.c", "abc a\nc")
    show("(?s)a.c", "a\nc")
    show("a*", "aaab")
    show("a+?", "aaa")
    show("a*?b", "aaab")
    show("(a|ab)(c|bcd)(d*)", "abcd")
    show("(a+)(b+)?", "aaac")
    show("x{{2,3}}", "xxxxx")
    show("x{{2,}}?", "xxxx")
    show("x{{3}}", "xx xxx")
    show("[a-c]+", "zzbcaz")
    show("[^a-c]+", "abcxyzabc")
    show("\\d+", "abc 12345 x")
    show("\\D+", "123abc456")
    show("\\w+", "  hello_world1 !")
    show("\\W+", "ab, cd")
    show("\\s+", "a \t\n b")
    show("\\S+", "  ab  ")
    show("^abc", "abcabc")
    show("^abc", "xabc")
    show("abc$", "abcabc")
    show("(?m)^b", "a\nb")
    show("(?m)a$", "a\nb")
    show("\\bcat\\b", "concat cat")
    show("\\Bcat", "cat concat")
    show("(?i)hello", "Say HeLLo")
    show("(?i)[a-c]+", "xxABCabc")
    show("(?i:ab)c", "ABc ABC")
    show("(?P<year>\\d{{4}})-(?P<month>\\d\\d)", "on 2026-10-17")
    show("(?:ab)+", "ababab!")
    show("(a)|(b)", "b")
    show("(a*)*", "b")
    show("(a*)+", "aab")
    show("(a|b)*c", "abababc")
    show("", "abc")
    show("x*", "abc")
    show("[.]", "a.b")
    show("\\.\\*\\+", "a.*+b")
    show("[\\d.]+", "v1.25.3!")
    show("[-a]", "x-y")
    show("[a-]", "x-y")
    show("[]a]", "]")
    show("日本", "こんにちは日本語")
    show("[日本]+", "語日本日x")
    show(".", "é")
    show("é+", "ééé")
    show("\\x41", "BAC")
    show("\\x{{263a}}", "smile ☺")
    show("a{{0}}b", "ab")
    show("(\\w+)@(\\w+)\\.com", "to: ada@example.com, bob@test.org")
    show("((a)(b))", "ab")
    show("(a(b)?)+", "aba")
    show("qu", "quit")
    show("^$", "")
    show("^", "abc")
    show("$", "abc")
    show("a|b|c", "zzc")
    show("(?i)STRASSE", "strasse")
    show("\\$\\d+", "cost $45")
    show("[\\[\\]]+", "a[]b")
    show("\\\\", "a\\b")
    show("(foo|foobar)", "foobar")
    show("(foobar|foo)", "foobar")
    show("a.*b", "a1b2b3")
    show("a.*?b", "a1b2b3")
    show("<.+>", "<a><b>")
    show("<.+?>", "<a><b>")
    show("(\\d+)-(\\d+)", "10-20 30-40")
    show("[0-9a-fA-F]+", "zz0xBEEFzz")
}
