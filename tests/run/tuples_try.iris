// expect: example.com 443
// stderr: error: HostError.noPort: no port in nope
// exit: 1

enum HostError { noPort }

!(str, u16) splitHost(str addr) {
    for i, c in addr {
        if c == ':' {
            return (addr[0:i], 443)
        }
    }
    return error(HostError.noPort, "no port in {addr}")
}

!void main() {
    host, port := try splitHost("example.com:443")
    print("{host} {port}")
    h, p := try splitHost("nope")
    print("{h} {p}")
}
