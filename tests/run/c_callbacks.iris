// expect: 1 3 5 7 9
// expect: 42

import c "stdlib.h"

i32 compareI64(u8 *pa, u8 *pb) {
    i64 *a = pa
    i64 *b = pb
    return if *a < *b { -1 } else if *a > *b { 1 } else { 0 }
}

@export("test_answer")
i32 answer() => 42

void main() {
    i64[5] xs = [5, 3, 9, 1, 7]
    c.qsort(&xs[0], 5, 8, compareI64)
    print("{xs[0]} {xs[1]} {xs[2]} {xs[3]} {xs[4]}")
    print("{answer()}")
}
