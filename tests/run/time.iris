// expect: 2026-10-17T09:30:05Z 1792229405 saturday 2026-10-17 9:30:5
// expect: 2026-10-17T11:31:35+02:00
// expect: 17/10/2026 09:30
// expect: 2026-10-17T11:30:05.25+02:00 2026-10-17T09:30:05.25Z 250ms true
// expect: 1969-07-20T20:17:40Z -14182940 sunday
// expect: 2024-03-01 1970-01-01T00:00:00Z
// expect: '2026-13-01' has no such month or day
// expect: 1.5s 1m30s 2h3m0s 250us 12ns 0s -1.5s

import time

!void main() {
    t := time.date(2026, 10, 17, 9, 30, 5)
    print("{t.iso()} {t.unix()} {t.weekday()} {t.year()}-{t.month()}-{t.day()} {t.hour()}:{t.minute()}:{t.second()}")
    print(t.add(90s).withOffset(7200).iso())
    print(t.format("DD/MM/YYYY hh:mm"))
    p := try time.parse("2026-10-17T11:30:05.25+02:00")
    print("{p.iso()} {p.utc().iso()} {p.sub(t)} {p.ns == t.ns + 250ms}")
    old := try time.parse("1969-07-20T20:17:40Z")
    print("{old.iso()} {old.unix()} {old.weekday()}")
    leap := try time.parse("2024-02-29")
    print("{leap.add(24h).dateText()} {time.unix(0).iso()}")
    _ = time.parse("2026-13-01") catch e {
        print("{e.message}")
        time.unix(0)
    }
    d := 1500ms
    print("{d} {90s} {2h + 3m} {250us} {12ns} {0s} {-1500ms}")
}
