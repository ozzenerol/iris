// expect: -128 127 255 32767 65535 -2147483648 4294967295
// expect: -9223372036854775808 9223372036854775807 18446744073709551615 0
// expect: 9223372036854775807 255 2147483647

void main() {
    print("{i8.min} {i8.max} {u8.max} {i16.max} {u16.max} {i32.min} {u32.max}")
    print("{i64.min} {i64.max} {u64.max} {u64.min}")
    i64 n = i64.max
    u8 b = u8.max
    print("{n} {b} {i32.max + 0}")
}
