// expect: 200 200 44 255 18446744073709551615
// expect: -128 127 65535 4294967295
// expect: 97 10 65

void main() {
    u8 b = 200
    i64 w = b
    u16 m = 300
    u8 back = u8(m - 256)
    u8 top = 255
    u64 big = 18446744073709551615
    print("{b} {w} {back} {top} {big}")
    i8 lo = -128
    i8 hi = 127
    u16 u = 65535
    u32 v = 4294967295
    print("{lo} {hi} {u} {v}")
    print("{'a'} {'\n'} {'\x41'}")
}
